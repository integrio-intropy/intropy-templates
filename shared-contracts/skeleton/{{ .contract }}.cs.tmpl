// The canonical claim-check reference contract: the streaming extractor
// publishes exactly this shape (one event per processed file) and the
// consuming component deserializes it, then resolves the reference by
// streaming the named file from the same storage behind the source port.
// Product-flavored sample — the producer delivers large product/export files
// too large to ride the broker. Change it here, and every component that
// references this project picks the change up on rebuild.
public record {{ .contract }}(
    string Location,
    string FileName,
    string SourceFileName,
    string EntityType,
    long RecordCount,
    long RejectCount);
