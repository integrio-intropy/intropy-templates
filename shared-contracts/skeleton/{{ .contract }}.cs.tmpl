namespace {{ .name }};

{{- if .empty }}

public record {{ .contract }}();
{{- else if eq .mode "batch" }}

// The canonical batch-summary contract: the batch extractor publishes exactly
// this shape (one event per processed batch) and the consuming component
// deserializes it. Change it here, and every component that references this
// project picks the change up on rebuild.
public record {{ .contract }}(
    string BatchId,
    string Location,
    IReadOnlyList<{{ .contract }}.{{ .contract }}File> Files)
{
    /// <summary>One file's outcome in the batch summary. Only entities that
    /// produced output appear — a zero-record entity has no file to reference.</summary>
    public record {{ .contract }}File(
        string EntityType,
        string FileName,
        long RecordCount,
        long RejectCount);
}
{{- else }}

// The canonical order contract: the extractor publishes exactly this shape
// and the consuming loader deserializes it. Change it here, and every
// component that references this project picks the change up on rebuild.
public record {{ .contract }}(
    string OrderId,
    string CustomerId,
    DateTimeOffset OrderDate,
    IReadOnlyList<OrderLine> Lines);
{{- end }}
