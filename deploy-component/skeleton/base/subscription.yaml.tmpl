{{- /* The declarative Dapr Subscription a subscribing block receives through:
its app callback announces no subscription of its own, so without this
resource the sidecar delivers it nothing. Taken verbatim from the topology —
the resource a local run loads — so a message routes the same way in every
environment. No deadLetterTopic: dead-lettering is the broker's own (the
pubsub component's), and Resiliency retries first. */ -}}
{{- $sub := dig "subscription" dict .component }}
{{- if not $sub }}
{{- fail (printf "%s subscribes, but the topology record carries no Subscription for it — rebuild the system host on an Intropy.Topology release that emits subscribes[].resource, then render again" .name) }}
{{- end -}}
apiVersion: dapr.io/v2alpha1
kind: Subscription
metadata:
  name: {{ $sub.name }}
spec:
  pubsubname: {{ $sub.pubsub }}
  topic: {{ $sub.topic }}
  routes:
{{- if $sub.rules }}
    rules:
{{- range $sub.rules }}
      - match: {{ .match | toJson }}
        path: {{ .path | toJson }}
{{- end }}
{{- end }}
    default: {{ $sub.defaultPath | toJson }}
{{- with dig "bulk" dict $sub }}
  bulkSubscribe:
    enabled: true
    maxMessagesCount: {{ .maxMessagesCount }}
    maxAwaitDurationMs: {{ .maxAwaitDurationMs }}
{{- end }}
scopes:
  - {{ .appId }}
