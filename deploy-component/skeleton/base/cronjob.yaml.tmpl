{{- /* A block's framework reads its pub/sub, and an extractor's or a
     transactional integration's its topic, from the environment and derives
     neither: a workload rendered without them would only fail at startup, so
     the render fails instead. */ -}}
{{- $kind := lower (replace "-" "" .kind) -}}
{{- $pubsub := dig "pubsub" "" .component -}}
{{- $topic := dig "topic" "" .component -}}
{{- if and (not $pubsub) (has $kind (list "extractor" "loader" "transactionalintegration")) -}}
{{- fail (printf "component %s: the topology record names no pub/sub for it to run on; regenerate the record with Intropy.Topology 2.0.1 or later, and keep its channels on one pub/sub" .name) -}}
{{- end -}}
{{- if and (not $topic) (has $kind (list "extractor" "transactionalintegration")) -}}
{{- fail (printf "component %s: the topology record names no topic for it to run on; regenerate the record with Intropy.Topology 2.0.1 or later, and keep its messages on one topic" .name) -}}
{{- end -}}
apiVersion: batch/v1
kind: CronJob
metadata:
  name: {{ .name }}
spec:
  # The schedule's one and only home: activation cadence is deployment
  # configuration, so the topology carries no schedule to copy from. The local
  # cluster sweeps once a minute; a GitOps render leaves a placeholder, because
  # a once-a-minute default would deploy unnoticed. Patch it in an overlay when
  # environments need different cadences.
{{- if eq .env "local" }}
  schedule: "* * * * *"
{{- else }}
  schedule: "REPLACE-ME-CRON-SCHEDULE"
{{- end }}
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      backoffLimit: 0
      template:
        metadata:
          labels:
            app: {{ .name }}
          annotations:
            dapr.io/enabled: "true"
            dapr.io/app-id: {{ .appId }}
{{- if eq (lower (replace "-" "" .kind)) "transactionalintegration" }}
            # The send side receives the integration's internal hop pushed over
            # the sidecar's gRPC app callback; the sidecar must know where it
            # listens (the framework's callback server speaks HTTP/2 only, on
            # APP_PORT, default 8080). A plain extractor serves nothing.
            dapr.io/app-port: "8080"
            dapr.io/app-protocol: grpc
{{- end }}
            # A Job's sidecar must be told to shut down, or the pod never
            # completes and the CronJob piles up.
            dapr.io/enable-app-health-check: "false"
            dapr.io/graceful-shutdown-seconds: "10"
{{- if .nativeSidecar }}
            # Run daprd as a Kubernetes native sidecar (a restartable init
            # container): the pod completes when the app exits even if the app
            # dies before it shuts the sidecar down. Otherwise one crashed run
            # leaves the Job running forever, and concurrencyPolicy: Forbid
            # then blocks every later run.
            dapr.io/enable-native-sidecar: "true"
{{- end }}
        spec:
          restartPolicy: Never
{{- if and .imagePullSecret (ne .env "local") }}
          imagePullSecrets:
            - name: {{ .imagePullSecret }}
{{- end }}
          containers:
            - name: {{ .name }}
{{- if eq .env "local" }}
              # The pinned local reference, same contract as deployment.yaml:
              # local/<name>, rewritten to local/<name>:dev by the root
              # kustomization intropy manifests render writes.
              image: local/{{ .name }}
{{- else }}
              # The tag tracks the freshest CI build. `intropy deploy` replaces
              # it with a digest when a deployment must be pinned.
              image: {{ .imageRepo }}:{{ .imageTag }}
{{- end }}
              env:
{{- if $pubsub }}
                # The one pub/sub this workload runs on, as the topology named it: the
                # system's own, which also carries a transactional integration's internal
                # queue. The framework derives no name, and the environment wins over a
                # name set in code.
                - name: INTROPY_PUBSUB_NAME
                  value: {{ $pubsub }}
{{- end }}
{{- if $topic }}
                # The one topic this workload runs on, as the topology named it: a
                # transactional integration's internal queue topic, or the single topic an
                # extractor's or a loader's messages share. Unset for a loader taking
                # several topics. The framework derives no topic, and the environment wins
                # over a name set in code.
                - name: INTROPY_TOPIC_NAME
                  value: {{ $topic }}
{{- end }}
                # The OTLP/gRPC collector: the local cluster's Tempo, or
                # deploy.yaml platform.otelEndpoint, or a placeholder.
                - name: OTEL_EXPORTER_OTLP_ENDPOINT
{{- if eq .env "local" }}
                  value: http://tempo.monitoring.svc.cluster.local:4317
{{- else if .otelEndpoint }}
                  value: {{ .otelEndpoint }}
{{- else }}
                  value: REPLACE-ME-OTEL-ENDPOINT
{{- end }}
                - name: OTEL_EXPORTER_OTLP_PROTOCOL
                  value: grpc
              resources:
                requests:
                  cpu: 50m
                  memory: 128Mi
                limits:
                  memory: 512Mi
