{{- /* The framework takes the block's pub/sub and a producer's topic from the
     environment. Neither name is derived: refusing incomplete topology here
     prevents a workload that can only fail at startup. */ -}}
{{- $kind := lower (replace "-" "" .kind) -}}
{{- $pubsub := dig "pubsub" "" .component -}}
{{- $topic := dig "topic" "" .component -}}
{{- if and (not $pubsub) (has $kind (list "extractor" "loader" "transactionalintegration" "gateway")) -}}
{{- fail (printf "component %s: the topology record names no pub/sub for it to run on; regenerate the record with Intropy.Topology 2.0.1 or later, and keep its channels on one pub/sub" .name) -}}
{{- end -}}
{{- if and (not $topic) (has $kind (list "extractor" "transactionalintegration" "gateway")) -}}
{{- fail (printf "component %s: the topology record names no topic for it to run on; regenerate the record with Intropy.Topology 2.0.1 or later, and keep its messages on one topic" .name) -}}
{{- end -}}
{{- if and (eq $kind "gateway") (not (dig "endpoints" (list) .component)) -}}
{{- fail (printf "gateway %s: the topology record names no endpoints; regenerate it with a gateway-aware Intropy.Topology release" .name) -}}
{{- end -}}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ .name }}
spec:
  replicas: {{ .replicas }}
  selector:
    matchLabels:
      app: {{ .name }}
  template:
    metadata:
      labels:
        app: {{ .name }}
      annotations:
        dapr.io/enabled: "true"
        dapr.io/app-id: {{ .appId }}
        dapr.io/app-port: "8080"
{{- if eq $kind "gateway" }}
        # Gateways serve HTTP requests, not the subscribing blocks' gRPC callback.
        dapr.io/app-protocol: http
{{- else }}
        # A subscribing block's app callback speaks HTTP/2 only.
        dapr.io/app-protocol: grpc
{{- end }}
        dapr.io/enable-api-logging: "false"
    spec:
      containers:
        - name: {{ .name }}
{{- if eq .env "local" }}
          # The pinned local reference: the local/ prefix the k3s setup
          # scripts tag every side-loaded image under, plus the component name,
          # no tag. intropy manifests render rewrites it to local/<name>:dev
          # through the images[] entries on the root kustomization it writes.
          # kustomize matches on this exact string and silently ignores a miss,
          # so the shape is part of the fixture contract; only a local render
          # may use it (manifest generation rejects an .env-varying base
          # through mergeRendered).
          image: local/{{ .name }}
{{- else }}
          # The tag tracks the freshest CI build. `intropy deploy` replaces it
          # with a digest when a deployment must be pinned.
          image: {{ .imageRepo }}:{{ .imageTag }}
{{- end }}
          ports:
            - containerPort: 8080
{{- if eq $kind "gateway" }}
              name: http
          startupProbe:
            httpGet:
              path: /healthz
              port: http
            periodSeconds: 2
            failureThreshold: 30
          readinessProbe:
            httpGet:
              path: /readyz
              port: http
            periodSeconds: 5
            timeoutSeconds: 2
          livenessProbe:
            httpGet:
              path: /healthz
              port: http
            periodSeconds: 10
            timeoutSeconds: 2
{{- end }}
          env:
{{- if $pubsub }}
            # The one pub/sub this workload runs on, as the topology named it: the
            # system's own, which also carries a transactional integration's internal
            # queue. The framework derives no name, and the environment wins over a
            # name set in code.
            - name: INTROPY_PUBSUB_NAME
              value: {{ $pubsub }}
{{- end }}
{{- if $topic }}
            # The one topic this workload runs on, as the topology named it: a
            # transactional integration's internal queue topic, or the single topic an
            # extractor's, gateway's or loader's messages share. Unset for a loader taking
            # several topics. The framework derives no topic, and the environment wins
            # over a name set in code.
            - name: INTROPY_TOPIC_NAME
              value: {{ $topic }}
{{- end }}
            # The in-cluster collector in every environment, local included:
            # Tempo in the monitoring namespace, OTLP/gRPC on 4317.
            - name: OTEL_EXPORTER_OTLP_ENDPOINT
              value: http://tempo.monitoring.svc.cluster.local:4317
            - name: OTEL_EXPORTER_OTLP_PROTOCOL
              value: grpc
          resources:
            requests:
              cpu: 50m
              memory: 128Mi
            limits:
              memory: 512Mi
