apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ .name }}
spec:
  replicas: {{ .replicas }}
  selector:
    matchLabels:
      app: {{ .name }}
  template:
    metadata:
      labels:
        app: {{ .name }}
      annotations:
        dapr.io/enabled: "true"
        dapr.io/app-id: {{ .appId }}
        dapr.io/app-port: "8080"
        dapr.io/enable-api-logging: "false"
    spec:
      containers:
        - name: {{ .name }}
          # The tag is a sentinel, not a version: `intropy deploy` replaces it
          # with a digest. It fails to pull loudly if anything deploys this
          # overlay before that happens.
          image: {{ .imageRepo }}:{{ .imageTag }}
          ports:
            - containerPort: 8080
          resources:
            requests:
              cpu: 50m
              memory: 128Mi
            limits:
              memory: 512Mi
