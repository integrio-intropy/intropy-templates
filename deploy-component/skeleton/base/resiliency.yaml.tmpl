# A loader acknowledges what it loads and leaves everything else for
# redelivery (RETRY): a failed send, a timeout, a message no route handles.
# A transactional integration does the same with the files it hops through
# its internal queue.
# Without this policy the sidecar does not retry such a message at all — it
# hands it straight back to the broker, which dead-letters it. With it, the
# sidecar retries in place first, so a short outage behind the loader (the
# destination system, a platform service) heals without a dead letter.
#
# The window must fit inside the broker's own timeouts: the message is held,
# not returned, while the sidecar retries. Worst case per delivery is about
# (maxRetries + 1) x the loader's MaxMessageProcessingTime plus the backoff.
#
# The block's own calls to its ports retry too (outbound, per port binding): a
# share, SFTP server or API that is briefly unreachable heals before the call
# fails back into the pipeline. That matters most for a transactional
# integration, whose send step turns a failed write into a business incident
# and acknowledges the message, so the redelivery policy above never sees it.
# The block waits while the sidecar retries, so these retries count against the
# same processing window as the redelivery ones.
apiVersion: dapr.io/v1alpha1
kind: Resiliency
metadata:
  name: {{ .name }}-redelivery
spec:
  policies:
    retries:
      redelivery:
        policy: exponential
        maxInterval: {{ .redeliveryMaxInterval }}
        maxRetries: {{ .redeliveryMaxRetries }}
{{- $ports := dig "ports" (list) .component }}
{{- if $ports }}
      portCalls:
        policy: exponential
        maxInterval: {{ .portCallMaxInterval }}
        maxRetries: {{ .portCallMaxRetries }}
{{- end }}
{{- $appId := .appId }}
{{- $pubsubs := dict }}
{{- if (eq (lower (replace "-" "" .kind)) "transactionalintegration") }}
{{- /* The internal queue's pub/sub, as the topology minted it on the component's
       Subscription; it is not a declared topic, so the topics cannot name it. */}}
{{- with dig "subscription" "pubsub" "" .component }}
{{- $_ := set $pubsubs . true }}
{{- end }}
{{- else }}
{{- range .topology.topics }}
{{- if has $appId (dig "subscribers" (list) .) }}
{{- $_ := set $pubsubs .pubsub true }}
{{- end }}
{{- end }}
{{- end }}
  targets:
{{- if or $pubsubs $ports }}
    components:
{{- range $name, $_ := $pubsubs }}
      {{ $name }}:
        inbound:
          retry: redelivery
{{- end }}
{{- /* A port's Dapr binding takes the port's name. */}}
{{- range $ports }}
      {{ . }}:
        outbound:
          retry: portCalls
{{- end }}
{{- else }}
    # The topology gives this block no subscription and no port: nothing to retry.
    components: {}
{{- end }}
scopes:
  - {{ .appId }}
