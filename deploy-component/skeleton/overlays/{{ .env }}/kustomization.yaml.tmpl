apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

# Thin on purpose: `intropy deploy` writes an images[] entry here with the digest
# it resolved, and the port kinds below follow this environment's bindings.
# Nothing else in this file should need to change per environment.
# The namespace is this environment's `namespace` in deploy.yaml, or the
# platform default when it names none: one integration namespace per cluster,
# shared by every system and environment.
namespace: {{ default "integration" (dig "gitops" "namespace" "" .) }}

resources:
  - ../../base

# Each file port's adapter kind, which the component reads as Ports:<port>:Kind
# and without which it refuses to start outside Development. It follows the
# port's binding for this environment, so it lives in the overlay, not the base:
# file → Local, sftp → Sftp. An http port is not a file port and gets none. No
# framework file adapter speaks the blob binding (bindings.aws.s3) yet, so a
# blob port fails the render rather than the first run.
#
# A file port's directory lives on its claim, <port>-file (deploy-host renders
# it next to the binding), mounted into this component's sidecar at
# /data/<port>: the localstorage binding runs in daprd, whose own filesystem is
# read-only.
{{- $recorded := dig "local" "bindings" dict . -}}
{{- $appId := dig "component" "appId" "" . -}}
{{- $kinds := dict -}}
{{- $filePorts := list -}}
{{- range .topology.ports }}
{{- if has $appId (dig "appIds" (list) .) }}
{{- $binding := default (get $recorded .name) (dig "binding" "" .) -}}
{{- if eq $binding "blob" }}{{ fail (printf "port %s is bound to blob, which no framework file adapter supports yet" .name) }}{{ end }}
{{- $kind := get (dict "file" "Local" "sftp" "Sftp") $binding -}}
{{- if $kind }}{{- $_ := set $kinds .name $kind -}}{{- end }}
{{- if eq $binding "file" }}{{- $filePorts = append $filePorts .name -}}{{- end }}
{{- end }}
{{- end }}
{{- if $kinds }}
{{- $pod := ternary "/spec/jobTemplate/spec/template" "/spec/template" (eq .workload "cronjob") }}
{{- $env := printf "%s/spec/containers/0/env/-" $pod }}
patches:
  - target:
      kind: {{ ternary "CronJob" "Deployment" (eq .workload "cronjob") }}
      name: {{ .name }}
    patch: |-
{{- range $port := keys $kinds | sortAlpha }}
      - op: add
        path: {{ $env }}
        value:
          name: Ports__{{ $port }}__Kind
          value: {{ get $kinds $port }}
{{- end }}
{{- if $filePorts }}
{{- $mounts := list }}
{{- range $port := $filePorts | sortAlpha }}{{- $mounts = append $mounts (printf "%s-file:/data/%s" $port $port) -}}{{- end }}
      - op: add
        path: {{ $pod }}/metadata/annotations/dapr.io~1volume-mounts-rw
        value: {{ join "," $mounts | quote }}
      - op: add
        path: {{ $pod }}/spec/volumes
        value:
{{- range $port := $filePorts | sortAlpha }}
          - name: {{ $port }}-file
            persistentVolumeClaim:
              claimName: {{ $port }}-file
{{- end }}
{{- end }}
{{- end }}
