apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

# Thin on purpose: `intropy deploy` writes an images[] entry here with the digest
# it resolved. Nothing else in this file should need to change per environment.
{{- if .namespacePerEnv }}
namespace: {{ .env }}-{{ .namespace }}
{{- else }}
namespace: {{ .namespace }}
{{- end }}

resources:
  - ../../base
