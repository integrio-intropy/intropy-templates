apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

# Thin on purpose: `intropy deploy` writes an images[] entry here with the digest
# it resolved. Nothing else in this file should need to change per environment.
# The namespace is a fixture of the platform, not a parameter: one integration
# namespace per cluster, shared by every system and environment.
namespace: integration

resources:
  - ../../base
