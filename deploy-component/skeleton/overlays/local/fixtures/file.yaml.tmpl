# The file fixture: one Dapr binding per connector recorded as `file` in
# .intropy/deploy-values.yaml, rooted at a conventional directory in the component's
# own container — the one fixture with no server behind it, for connectors
# whose local fidelity is a directory drop. The path is the fixture contract
# (see deploy-component/README.md) — a dev value, not a placeholder.
#
# The binding travels on the connector itself: manifest generation reads it
# from .intropy/deploy-values.yaml and injects it per environment. The
# $recorded fallback keeps a CLI older than that field working, reading the
# flat bindings map it still injects under .local.
#
# Owner, not user: this overlay renders once per component, and a
# connector's Component may exist exactly once in the build, so the component
# whose app-id is first in the connector's scopes emits it — scopes still
# list every app-id that may use it.
{{- $recorded := dig "local" "bindings" dict . -}}
{{- range .topology.connectors }}
{{- $conn := . }}
{{- $b := dig "binding" "" . -}}
{{- if and (or (eq $b "file") (and (not $b) (eq (index $recorded .name) "file"))) (eq $.component.appId (index $conn.appIds 0)) }}
---
apiVersion: dapr.io/v1alpha1
kind: Component
metadata:
  name: {{ .name }}
  labels:
    intropy.io/connector: {{ .name }}
spec:
  type: bindings.localstorage
  version: v1
  metadata:
    - name: rootPath
      value: /data/{{ .name }}
scopes:
{{- range $conn.appIds }}
  - {{ . }}
{{- end }}
{{- end }}
{{- end }}
