# The file fixture: one Dapr binding per port selected as `file` for this
# render, rooted at /data/<port> — the one fixture with no server behind it,
# for ports whose local fidelity is a directory drop. The path is the fixture
# contract (see deploy-component/README.md) — a dev value, not a placeholder.
#
# The binding runs in the daprd sidecar, whose filesystem is read-only, so
# each port also gets a PersistentVolumeClaim, <port>-file, which every
# component using the port mounts into its sidecar at /data/<port> (the
# patch in ../kustomization.yaml). A claim rather than an emptyDir: a
# CronJob's pods come and go every run, and a file dropped between runs must
# still be there for the next one.
#
# The binding travels on the port itself: manifest rendering injects the
# explicit or interactive choice for this run. The $recorded fallback keeps a
# CLI older than that field working with the flat bindings map under .local.
#
# Owner, not user: this overlay renders once per component, and a
# port's Component may exist exactly once in the build, so the component
# whose app-id is first in the port's scopes emits it — scopes still
# list every app-id that may use it.
{{- $recorded := dig "local" "bindings" dict . -}}
{{- range .topology.ports }}
{{- $conn := . }}
{{- $b := dig "binding" "" . -}}
{{- if and (or (eq $b "file") (and (not $b) (eq (index $recorded .name) "file"))) (eq $.component.appId (index $conn.appIds 0)) }}
---
apiVersion: dapr.io/v1alpha1
kind: Component
metadata:
  name: {{ .name }}
  labels:
    intropy.io/port: {{ .name }}
spec:
  type: bindings.localstorage
  version: v1
  metadata:
    - name: rootPath
      value: /data/{{ .name }}
scopes:
{{- range $conn.appIds }}
  - {{ . }}
{{- end }}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ .name }}-file
  labels:
    intropy.io/port: {{ .name }}
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 1Gi
{{- end }}
{{- end }}
