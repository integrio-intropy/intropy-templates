apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

# The local overlay. Unlike the environment overlays it carries the fixture
# bindings: every port's Dapr binding lives next to the component that
# uses it, switched on the ephemeral choice for this render
# (spec.local.fixtures declares the catalog). It has no namespace line and no
# image override on purpose — intropy manifests render sets both on the root
# kustomization
# it writes: namespace: targets every rendered resource at once, and images[]
# rewrites the local/ image reference the base renders (local/{{ .name }}, no
# tag; pinned in the README) to local/<name>:dev.
{{- $recorded := dig "local" "bindings" dict . -}}
{{- $fixtures := dict -}}
{{- range .topology.ports }}
{{- $binding := default (get $recorded .name) (dig "binding" "" .) -}}
{{- if $binding }}{{- $_ := set $fixtures $binding true -}}{{- end }}
{{- end }}
resources:
  - ../../base
{{- if hasKey $fixtures "sftp" }}
  - fixtures/sftp.yaml
{{- end }}
{{- if hasKey $fixtures "http" }}
  - fixtures/http.yaml
{{- end }}
{{- if hasKey $fixtures "file" }}
  - fixtures/file.yaml
{{- end }}
{{- if hasKey $fixtures "blob" }}
  - fixtures/blob.yaml
{{- end }}
