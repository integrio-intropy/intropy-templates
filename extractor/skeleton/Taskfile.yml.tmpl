version: "3"

# Build and test tasks for {{ .name }} — a .NET extractor integration.
# The extractor runs via its system host (the host runs it once at startup;
# the schedule lives in deployment configuration); these tasks are the
# component-level loop.

tasks:
  # ── .NET build ────────────────────────────────────────────────────
  build:
    desc: Build the application
    dir: "{{ "{{" }}.TASKFILE_DIR}}"
    cmds:
      - dotnet build

  # ── Tests ─────────────────────────────────────────────────────────
  test:
    desc: Run the unit tests (pipeline steps; no Dapr)
    dir: "{{ "{{" }}.TASKFILE_DIR}}"
    cmds:
      - dotnet test ./test/{{ .name }}.Test.Unit
