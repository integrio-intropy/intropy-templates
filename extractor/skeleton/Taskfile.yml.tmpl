version: "3"

# Build and test tasks for {{ .name }} — a .NET extractor integration.
# The extractor runs via its system host (the host schedules it; the Aspire
# dashboard offers "Run now"); these tasks are the component-level loop.

tasks:
  # ── .NET build ────────────────────────────────────────────────────
  build:
    desc: Build the application
    dir: "{{ "{{" }}.TASKFILE_DIR}}"
    cmds:
      - dotnet build

  # ── Tests ─────────────────────────────────────────────────────────
  test:
    desc: Run the tests (unit + integration)
    dir: "{{ "{{" }}.TASKFILE_DIR}}"
    cmds:
      - dotnet test

  coverage:
    desc: Run the integration suite with branch coverage (Cobertura report in test/{{ .name }}.Test.Integration/TestResults)
    dir: "{{ "{{" }}.TASKFILE_DIR}}"
    cmds:
      - dotnet test ./test/{{ .name }}.Test.Integration --collect:"XPlat Code Coverage" -- DataCollectionRunSettings.DataCollectors.DataCollector.Configuration.Format=cobertura
