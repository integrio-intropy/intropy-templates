using {{ .contracts }};
using {{ .name }}.Model;
using Dapr.Client;
using Intropy.Framework.Blocks.Extractor;
using Intropy.Framework.Blocks.Shared;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Logging.Abstractions;
using NSubstitute;

namespace {{ .name }}.Test.Integration;

/// <summary>
/// Sidecar lifecycle and exit-code mapping. The sweep itself is stubbed
/// (hand-rolled <see cref="StubSweep"/> — its own contract lives in
/// <see cref="SweepTests"/>); NSubstitute covers only the abstract
/// <see cref="DaprClient"/> sidecar methods.
/// </summary>
public class ExtractorRunnerTests
{
    [Fact]
    public async Task RunAsync_WhenSidecarNeverArrives_Returns1()
    {
        // Arrange: the sidecar never becomes ready — substituted to throw
        // immediately instead of waiting out the runner's 30-second timeout.
        var daprClient = Substitute.For<DaprClient>();
        daprClient
            .WaitForSidecarAsync(Arg.Any<CancellationToken>())
            .Returns<Task>(_ => throw new OperationCanceledException());

        var runner = new ExtractorRunner(daprClient, StubSweep.Succeeding(), NullLoggerFactory.Instance);

        // Act
        var exitCode = await runner.RunAsync(CancellationToken.None);

        // Assert
        Assert.Equal(1, exitCode);
    }

    [Fact]
    public async Task RunAsync_WhenSweepReportsFailures_Returns1()
    {
        var runner = new ExtractorRunner(HealthySidecar(), StubSweep.Failing(failed: 2), NullLoggerFactory.Instance);

        var exitCode = await runner.RunAsync(CancellationToken.None);

        Assert.Equal(1, exitCode);
    }

    [Fact]
    public async Task RunAsync_WhenSweepSucceeds_Returns0AndShutsDownSidecar()
    {
        var daprClient = HealthySidecar();
        var runner = new ExtractorRunner(daprClient, StubSweep.Succeeding(), NullLoggerFactory.Instance);

        var exitCode = await runner.RunAsync(CancellationToken.None);

        Assert.Equal(0, exitCode);
        // The shutdown token must be bounded — never CancellationToken.None,
        // which would let a wedged sidecar hang the job after a clean sweep.
        await daprClient.Received(1).ShutdownSidecarAsync(
            Arg.Is<CancellationToken>(t => t != CancellationToken.None));
    }

    [Fact]
    public async Task RunAsync_WhenAborted_Returns0()
    {
        // Arrange: an aborted run is not a failure — unprocessed files stay
        // safely in the inbound folder for the next scheduled run.
        var runner = new ExtractorRunner(HealthySidecar(), StubSweep.Aborting(), NullLoggerFactory.Instance);

        var exitCode = await runner.RunAsync(CancellationToken.None);

        Assert.Equal(0, exitCode);
    }

    [Fact]
    public async Task RunAsync_WhenCallerCancelsMidSweep_PropagatesCancellationAndReturns0()
    {
        // Arrange: unlike RunAsync_WhenAborted (which stubs the throw), this
        // sweep honors the caller's token — proving cancellation actually
        // propagates through the runner to the abort-mapping, not just that a
        // catch branch exists.
        var runner = new ExtractorRunner(HealthySidecar(), StubSweep.CooperativelyCancelling(),
            NullLoggerFactory.Instance);
        using var cts = new CancellationTokenSource(millisecondsDelay: 50);

        // Act
        var exitCode = await runner.RunAsync(cts.Token);

        // Assert: an aborted run is not a failure.
        Assert.Equal(0, exitCode);
    }

    private static DaprClient HealthySidecar()
    {
        var daprClient = Substitute.For<DaprClient>();
        daprClient.WaitForSidecarAsync(Arg.Any<CancellationToken>()).Returns(Task.CompletedTask);
        daprClient.ShutdownSidecarAsync(Arg.Any<CancellationToken>()).Returns(Task.CompletedTask);
        return daprClient;
    }

    /// <summary>
    /// Hand-rolled <see cref="Sweep"/> stub. The base constructor takes a real
    /// pipeline (the <see cref="Sweep"/> constructor has no parameterless
    /// form) built via the shared <see cref="FakeEdges"/>, but the overrides
    /// never execute it.
    /// </summary>
    private sealed class StubSweep(int failed, bool abort, bool honorToken)
        : Sweep(new FakeEdges().Files, BuildPipeline(), NullLoggerFactory.Instance)
    {
        public static StubSweep Succeeding() => new(failed: 0, abort: false, honorToken: false);
        public static StubSweep Failing(int failed) => new(failed, abort: false, honorToken: false);
        public static StubSweep Aborting() => new(failed: 0, abort: true, honorToken: false);
        public static StubSweep CooperativelyCancelling() => new(failed: 0, abort: false, honorToken: true);

        public override async Task<int> SweepAsync(CancellationToken ct)
        {
            if (abort)
            {
                throw new OperationCanceledException();
            }

            if (honorToken)
            {
                // Simulate a long sweep that observes cooperative cancellation.
                await Task.Delay(Timeout.Infinite, ct);
            }

            return failed;
        }

        private static Extractor<In, Order, Context> BuildPipeline()
        {
            var edges = new FakeEdges();
            return edges.BuildPipeline(edges.CreateServices().BuildServiceProvider());
        }
    }
}
