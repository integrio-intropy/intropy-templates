/// <summary>
/// The full pipeline (deserialize → validate → idempotency → transform →
/// serialize → publish) over one inbound sweep, with <see cref="FakeTopic{TCtx}"/>
/// at the publish edge. The pipeline is built exactly as production composition
/// does — only the four externals are faked — and assertions read fake state
/// directly. These tests pin the sweep's consumption contract: published,
/// duplicate-cancelled, and incident-routed files are all deleted; technical
/// failures stay and are counted.
/// </summary>
public class SweepTests
{
