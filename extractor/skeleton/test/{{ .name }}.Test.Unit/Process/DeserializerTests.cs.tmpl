    [Fact]
    public async Task ExecuteAsync_WithValidInput_ReturnsSuccessAndStampsBusinessIdInContext()
    {
        // Arrange
        var deserializer = new Deserializer();
        var context = new Context(new Dictionary<string, string>());
        var json = """{"sourceRecordId":"REC-1","occurredAt":"2026-01-15T09:30:00+00:00","lines":[{"sku":"SKU-1","quantity":2,"unitPrice":10.0}]}""";

        // Act
        var (result, resultContext) = await deserializer.ExecuteAsync(json, context, CancellationToken.None);

        // Assert
        Assert.IsType<BusinessStepResult<Source{{ .contract }}>.Success>(result);
        Assert.False(string.IsNullOrWhiteSpace(resultContext.Metadata[Constants.ContextKeyOrderId]));
    }
{{- else }}
    [Fact]
    public async Task ExecuteAsync_WithValidJson_ReturnsSuccess()
    {
        // Arrange
        var deserializer = new Deserializer();
        var context = new Context(new Dictionary<string, string>());
        var json = """{"orderId":"ORD-1001","customerId":"CUST-42","orderDate":"2026-01-15T09:30:00+00:00","lines":[{"sku":"SKU-1","quantity":2,"unitPrice":10.0}]}""";

        // Act
        var (result, _) = await deserializer.ExecuteAsync(json, context, CancellationToken.None);

        // Assert
        var success = Assert.IsType<BusinessStepResult<Source{{ .contract }}>.Success>(result);
        Assert.Equal("ORD-1001", success.Value.OrderId);
        Assert.Single(success.Value.Lines);
    }

    [Fact]
    public async Task ExecuteAsync_WithValidJson_StoresOrderIdInContext()
    {
        // Arrange
        var deserializer = new Deserializer();
        var context = new Context(new Dictionary<string, string>());
        var json = """{"orderId":"ORD-1001","customerId":"CUST-42","orderDate":"2026-01-15T09:30:00+00:00","lines":[]}""";

        // Act
        var (_, resultContext) = await deserializer.ExecuteAsync(json, context, CancellationToken.None);

        // Assert
        Assert.Equal("ORD-1001", resultContext.Metadata[Constants.ContextKeyOrderId]);
    }
{{- end }}
