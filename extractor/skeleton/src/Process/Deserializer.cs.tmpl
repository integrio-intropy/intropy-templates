using System.Text.Json;
using {{ .name }}.Model;
using Intropy.Framework.Blocks.Extractor.Steps;
using Intropy.Framework.Blocks.Shared;
using Intropy.Framework.Core.Pipeline.Abstractions.Results;

namespace {{ .name }}.Process;

public class Deserializer : DeserializeStep<Source{{ .contract }}, Context>
{
    public override Task<(BusinessStepResult<Source{{ .contract }}> Result, Context Context)> ExecuteAsync(
        string input, Context context, CancellationToken ct)
    {
{{- if .empty }}
        throw new NotImplementedException();
{{- else }}
        var order = JsonSerializer.Deserialize<Source{{ .contract }}>(input,
            new JsonSerializerOptions { PropertyNameCaseInsensitive = true })!;

        context.Metadata[Constants.ContextKeyOrderId] = order.OrderId;

        return Task.FromResult<(BusinessStepResult<Source{{ .contract }}>, Context)>(
            (new BusinessStepResult<Source{{ .contract }}>.Success(order), context));
{{- end }}
    }
}
