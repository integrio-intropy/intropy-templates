using {{ .models }};
using {{ .name }}.Model;
using Intropy.Framework.Blocks.Extractor.Steps;
using Intropy.Framework.Blocks.Shared;
using Intropy.Framework.Core.Pipeline.Abstractions.Results;

namespace {{ .name }}.Process;

public class Transformer : TransformStep<In, Order, Context>
{
    public override Task<(TechnicalStepResult<Order> Result, Context Context)> ExecuteAsync(
        In input, Context context, CancellationToken ct)
    {
{{- if .empty }}
        throw new NotImplementedException();
{{- else }}
        // Order is the canonical contract from the shared models project; the
        // consuming loader deserializes exactly this. Enrich or reshape here
        // if the source format ever diverges from the canonical one.
        var output = new Order(
            OrderId: input.OrderId,
            CustomerId: input.CustomerId,
            OrderDate: input.OrderDate,
            Lines: input.Lines);

        return Task.FromResult<(TechnicalStepResult<Order>, Context)>(
            (new TechnicalStepResult<Order>.Success(output), context));
{{- end }}
    }
}
