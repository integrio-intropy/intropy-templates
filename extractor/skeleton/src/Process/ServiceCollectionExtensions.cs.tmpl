using {{ .contracts }};
using {{ .name }}.Configuration;
using {{ .name }}.Model;
using Intropy.Framework.Blocks.Extractor;
using Intropy.Framework.Blocks.Shared;
using Microsoft.Extensions.DependencyInjection;

namespace {{ .name }}.Process;

public static class ServiceCollectionExtensions
{
    /// <summary>The business identifier the idempotency check keys on.</summary>
    /// <remarks>
    /// Point this at a stable business identifier — per-delivery values (fresh
    /// GUID, wall-clock time) make the check pass everything.
    /// </remarks>
    public static readonly Func<In, Context, string> IdempotencyId =
{{- if .empty }}
        (_, _) => throw new NotImplementedException();

    /// <summary>The business timestamp the idempotency check keys on.</summary>
    public static readonly Func<In, Context, DateTimeOffset> IdempotencyDate =
        (_, _) => throw new NotImplementedException();
{{- else }}
        (order, _) => order.OrderId;

    /// <summary>The business timestamp the idempotency check keys on.</summary>
    public static readonly Func<In, Context, DateTimeOffset> IdempotencyDate =
        (order, _) => order.OrderDate;
{{- end }}

    public static IServiceCollection AddProcessPipeline(this IServiceCollection services)
    {
        // The single composition entrypoint: tests swap the sender via
        // Composition.BuildPipeline's configureSender hook, production keeps
        // the Dapr topic publisher. Everything else is wired identically.
        services.AddSingleton(provider => Composition.BuildPipeline(provider));
        return services;
    }
}
