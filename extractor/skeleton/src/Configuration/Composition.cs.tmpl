using {{ .contracts }};
using Dapr.Client;
using {{ .name }}.Model;
using {{ .name }}.Process;
using Intropy.BusinessIncidentService.Client;
using Intropy.Framework.Adapters.File;
using Intropy.Framework.Blocks.Extractor;
using Intropy.Framework.Blocks.Shared;
using Intropy.Framework.Core.Configuration;
using Intropy.IdempotencyService.Client;
using Intropy.Telemetry.ConsoleApp;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Logging;

namespace {{ .name }}.Configuration;

/// <summary>
/// The component's service registrations, shared by the entrypoint
/// (<c>Program.cs</c>) and the composition smoke test. Everything the runner
/// needs — telemetry, Dapr clients, the source file adapter, the extract
/// pipeline — is registered here so the test can prove the whole graph
/// builds without a sidecar.
/// </summary>
public static class Composition
{
    /// <summary>Registers every service the extractor needs.</summary>
    public static IServiceCollection ConfigureServices(IServiceCollection services)
    {
        var environment = Environment.GetEnvironmentVariable("DOTNET_ENVIRONMENT") ?? "Production";

        services.AddLogging(builder => builder.AddConsole());

        services.AddOpenTelemetry(conf =>
        {
            conf.ServiceNamespace = Constants.Organization;
            conf.ServiceName = Constants.ComponentName;
            conf.Environment = environment;
        });

        services.AddSingleton(_ => new DaprClientBuilder().Build());

        // Registered after the DaprClient above on purpose: AddIdempotencyServiceClient
        // contributes its own DaprClient registration (camelCase JSON + string enums),
        // and the last registration wins for GetRequiredService<DaprClient>().
        services.AddIdempotencyServiceClient();      // Dapr app id / HTTPEndpoint name: idempotency-service
        services.AddBusinessIncidentServiceClient(); // Dapr app id / HTTPEndpoint name: business-incident-service

        services.AddIntropyFramework(x =>
        {
            x.ComponentName = Constants.ComponentName;
            x.ServiceNamespace = Constants.Organization;
        });

        services.AddKeyedSingleton<IFileAdapter>(Constants.SourceFileAdapterKey, (sp, _) =>
            new LocalFileAdapter(
                sp.GetRequiredService<DaprClient>(),
                new FileAdapterOptions(Constants.InboundBindingName)));

        services.AddProcessPipeline();
        services.AddSingleton<Sweep>();
        services.AddSingleton<ExtractorRunner>();

        return services;
    }

    /// <summary>
    /// Builds the extract pipeline exactly as <c>AddProcessPipeline</c> does,
    /// optionally overriding the sender. Component tests pass
    /// <c>builder =&gt; builder.WithSender(fakeTopic)</c> to fake the publish edge
    /// while every other step (idempotency, business incidents, serializer)
    /// is wired exactly as in production.
    /// </summary>
    public static Extractor<In, Order, Context> BuildPipeline(
        IServiceProvider provider,
        Func<ExtractorBuilder<In, Order, Context>, ExtractorBuilder<In, Order, Context>>? configureSender = null)
    {
        var builder = ExtractorBuilder<In, Order, Context>.Create("{{ .name }}.Process", provider)
            .WithDeserializer(new Deserializer())
            .WithValidator(new Validator())
            .WithIdempotency(
                idExtractor: Process.ServiceCollectionExtensions.IdempotencyId,
                dateExtractor: Process.ServiceCollectionExtensions.IdempotencyDate)
            .WithTransformer(new Transformer())
            .WithSerializer(new Serializer());

        builder = configureSender is not null
            ? configureSender(builder)
            : builder.WithDaprTopicPublisher(
                Constants.PubSubName,
                Constants.TopicName,
                new Uri(Constants.EventSource),
                Constants.EventType);

        return builder
            .WithBusinessIncidents(
                messageIdExtractor: ctx => ctx.Metadata.GetValueOrDefault(Constants.ContextKeyOrderId,
                    ctx.Metadata.GetValueOrDefault(Constants.ContextKeyFileName, "unknown")),
                subjectExtractor: ctx => ctx.Metadata.GetValueOrDefault(Constants.ContextKeyOrderId,
                    ctx.Metadata.GetValueOrDefault(Constants.ContextKeyFileName, "unknown")))
            .Build();
    }
}
