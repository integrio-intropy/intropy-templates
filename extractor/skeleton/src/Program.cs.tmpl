using Dapr.Client;
using {{ .name }}.Extract;
using {{ .name }}.Sweep;
using Intropy.BusinessIncidentService.Client;
using Intropy.Framework.Adapters.File;
using Intropy.Framework.Core.Configuration;
using Intropy.IdempotencyService.Client;
using Intropy.Telemetry.AspNetCore;
using Constants = {{ .name }}.Configuration.Constants;

var builder = WebApplication.CreateBuilder(args);
var environment = Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") ?? "Production";

builder.Services.AddOpenTelemetry(conf =>
{
    conf.ServiceNamespace = Constants.Organization;
    conf.ServiceName = Constants.ComponentName;
    conf.Environment = environment;
});

builder.Services.AddSingleton(_ => new DaprClientBuilder().Build());

// Registered after the DaprClient above on purpose: AddIdempotencyServiceClient
// contributes its own DaprClient registration (camelCase JSON + string enums),
// and the last registration wins for GetRequiredService<DaprClient>().
builder.Services.AddIdempotencyServiceClient();      // Dapr app id / HTTPEndpoint name: idempotency-service
builder.Services.AddBusinessIncidentServiceClient(); // Dapr app id / HTTPEndpoint name: business-incident-service

builder.Services.AddIntropyFramework(x =>
{
    x.ComponentName = Constants.ComponentName;
    x.ServiceNamespace = Constants.Organization;
});

builder.Services.AddKeyedSingleton<IFileAdapter>(Constants.SourceFileAdapterKey, (sp, _) =>
    new LocalFileAdapter(
        sp.GetRequiredService<DaprClient>(),
        new FileAdapterOptions(Constants.InboundBindingName)));

builder.Services.AddExtractPipeline();
builder.Services.AddSingleton<Sweeper>();

var app = builder.Build();

// Dapr delivers each tick of the `poll` cron binding as POST /<binding-name>.
app.MapPost("/poll", async (Sweeper sweeper, CancellationToken ct) =>
{
    await sweeper.SweepAsync(ct);
    return Results.Ok();
});

app.Run();
