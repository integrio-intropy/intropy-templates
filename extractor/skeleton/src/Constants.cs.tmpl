namespace {{ .name }};

public static class Constants
{
    public const string ComponentName = "{{ .name | kebabcase }}";
    public const string Organization = "{{ .organization }}";

    public const string PubSubName = "pubsub";
    public const string TopicName = "{{ .topic }}";

    // The source connector's Dapr binding. "binding.<connector>" is the
    // derived component name the system host generates, so the overlay can
    // swap the local folder for the system-level one without touching code.
    public const string InboundBindingName = "binding.{{ .connector }}";

    public const string SourceFileAdapterKey = "source";

    // CloudEvent envelope: where the data came from and what kind of event it is.
    public const string EventSource = "urn:{{ .organization }}:{{ .name | kebabcase }}";
    public const string EventType = "{{ .organization | lower }}.{{ .topic }}.extracted";

    public const string ContextKeyFileName = "file_name";
    public const string ContextKeyOrderId = "order_id";
}
