<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The package generates the entry point for this component class. -->
    <IntropyExtractorHostComponentType>{{ .name }}.{{ .componentClass }}</IntropyExtractorHostComponentType>
  </PropertyGroup>

  <ItemGroup>
    <!-- The whole runtime: entry point, identity from the system topology, sweep, Dapr, and
         platform clients. Pinned to the pilot package set; a template release and its pin are
         one atomic unit. -->
    <PackageReference Include="Intropy.Framework.ExtractorHost" Version="[0.0.1-pilot.260924112600]" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared contracts sibling is scaffolded by this template's
         spec.dependencies entry, so it exists whenever this project does. -->
    <ProjectReference Include="../../{{ .contracts }}/{{ .contracts }}.csproj" />
  </ItemGroup>

</Project>
