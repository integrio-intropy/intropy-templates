using {{ .contracts }};
using Dapr.Client;
using {{ .name }}.Model;
using {{ .name }}.Process;
using Intropy.BusinessIncidentService.Client;
using Intropy.Framework.Adapters.File;
using Intropy.Framework.Blocks.Extractor;
using Intropy.Framework.Blocks.Extractor.Steps;
using Intropy.Framework.Blocks.Shared;
using Intropy.Framework.Core.Configuration;
using Intropy.Framework.Hosting.RunToCompletion;
using Intropy.IdempotencyService.Client;
using Intropy.Telemetry.ConsoleApp;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Logging;

namespace {{ .name }}.Composition;

/// <summary>
/// The component's service registrations, shared by the entrypoint
/// (<c>Program.cs</c>) and the composition smoke test. Everything the runner
/// needs — telemetry, Dapr clients, the source file adapter, the extract
/// pipeline — is registered here so the test can prove the whole graph
/// builds without a sidecar.
/// </summary>
public static class Composition
{
    /// <summary>Registers every service the extractor needs.</summary>
    public static IServiceCollection ConfigureServices(IServiceCollection services)
    {
        var environment = Environment.GetEnvironmentVariable("DOTNET_ENVIRONMENT") ?? "Production";

        // Register host-level platform plumbing first: diagnostics, Dapr, framework
        // services, and shared platform clients. Keeping these together makes the
        // ordering-sensitive DaprClient registrations obvious.
        services.AddLogging(builder => builder.AddConsole());

        services.AddOpenTelemetry(conf =>
        {
            conf.ServiceNamespace = Constants.Organization;
            conf.ServiceName = Constants.ComponentName;
            conf.Environment = environment;
        });

        services.AddSingleton(_ => new DaprClientBuilder().Build());

        // Registered after the DaprClient above on purpose: AddIdempotencyServiceClient
        // contributes its own DaprClient registration (camelCase JSON + string enums),
        // and the last registration wins for GetRequiredService<DaprClient>().
        services.AddIdempotencyServiceClient(c =>
        {
            c.AppId = "idempotency-service.services";
        });

        services.AddBusinessIncidentServiceClient(c =>
        {
            c.AppId = "business-incident-service.services";
        });

        services.AddIntropyFramework(x =>
        {
            x.ComponentName = Constants.ComponentName;
            x.ServiceNamespace = Constants.Organization;
        });

        // Bind the source adapter implementation to the component's stable inbound
        // port. Deployment swaps the Dapr binding behind the port name; this keyed
        // registration is where code chooses the adapter class that can speak it.
        services.AddKeyedSingleton<IFileAdapter>(Constants.SourceFileAdapterKey, (sp, _) =>
            new LocalFileAdapter(
                sp.GetRequiredService<DaprClient>(),
                new FileAdapterOptions(Constants.InboundBindingName)));

        // The port name never changes between environments — deployment
        // swaps the binding's type behind "binding.<port>", so rebinding the
        // port is a configuration act, not a build. Today the adapter class
        // must still match the deployed binding type (each binding speaks
        // its own Dapr operation metadata), so a different adapter is a
        // same-name class switch, e.g. when the production environment
        // resolves this port to an SFTP binding:
        //
        // services.AddKeyedSingleton<IFileAdapter>(Constants.SourceFileAdapterKey, (sp, _) =>
        //     environment == "Development"
        //         ? (IFileAdapter)new LocalFileAdapter(
        //             sp.GetRequiredService<DaprClient>(),
        //             new FileAdapterOptions(Constants.InboundBindingName))
        //         : new SftpAdapter(
        //             sp.GetRequiredService<DaprClient>(),
        //             new FileAdapterOptions(Constants.InboundBindingName)));
        //
        // The SFTP binding's address and credentials live in the
        // environment's Dapr component (GitOps values), resolved out of the
        // cluster's secret store — never hard-code them here.

        // The publisher is a service like the other externals (source adapter,
        // platform clients): tests swap it for a FakeTopic via RemoveAll/AddSingleton,
        // exactly as they swap the others — no special seam in BuildPipeline.
        services.AddSingleton<SendStep<Context>>(sp => new DaprTopicPublisher<Context>(
            sp.GetRequiredService<DaprClient>(),
            Constants.PubSubName,
            Constants.TopicName,
            new Uri(Constants.EventSource),
            Constants.EventType));

        // Register the pipeline and runner last, after every adapter, publisher,
        // and platform client it resolves from DI has been added to the service collection.
        AddExtractPipeline(services);
        services.AddSingleton<Sweep>();

        // The framework's run-to-completion host owns the Dapr sidecar lifecycle,
        // tracing, and exit-code mapping; ExtractJob adapts the sweep to it. JobName
        // names the trace activity so this job is distinguishable in telemetry.
        // AddRunToCompletionJob self-registers TJob (TryAddSingleton), so a component
        // registration here would only be needed to override the lifetime/construction.
        services.AddRunToCompletionJob<ExtractJob>(options => options.JobName = Constants.ComponentName);

        return services;
    }

    /// <summary>The single composition entrypoint for the pipeline: registers
    /// <see cref="BuildPipeline"/> as the pipeline factory. The explicit lambda
    /// matters — a method group (<c>AddSingleton(BuildPipeline)</c>) compiles but
    /// registers a signature DI cannot resolve for <c>Extractor&lt;,,&gt;</c>.</summary>
    private static void AddExtractPipeline(IServiceCollection services) =>
        services.AddSingleton(provider => BuildPipeline(provider));

    /// <summary>
    /// Builds the extract pipeline against the DI graph. Every external dependency —
    /// source adapter, sender, idempotency, business incidents — resolves from
    /// the provider, so a test swaps any of them by swapping its registration.
    /// </summary>
    public static Extractor<Source{{ .contract }}, {{ .contract }}, Context> BuildPipeline(IServiceProvider provider)
    {
        return ExtractorBuilder<Source{{ .contract }}, {{ .contract }}, Context>.Create("{{ .name }}.Process", provider)
            .WithDeserializer(new Deserializer())
            .WithValidator(new Validator())
            // Point the idempotency check at a stable business identifier and
            // timestamp — per-delivery values (fresh GUID, wall-clock time)
            // make the check pass everything.
            .WithIdempotency(
                idExtractor: (Source{{ .contract }} order, Context _) =>
{{- if .empty }}
                    throw new NotImplementedException(),
                dateExtractor: (_, _) =>
                    throw new NotImplementedException())
{{- else }}
                    order.OrderId,
                dateExtractor: (Source{{ .contract }} order, Context _) =>
                    order.OrderDate)
{{- end }}
            .WithTransformer(new Transformer())
            // The framework's serialize step owns the CloudEvent envelope (Id,
            // Subject, Time, Data) and validates Subject/Time at serialize time;
            // the publisher adds Source/Type from the registration above.
            .WithSerializer(new CloudEventSerializeStep<{{ .contract }}, Context>(
{{- if .empty }}
                subject: _ => throw new NotImplementedException(),
                time: _ => throw new NotImplementedException()))
{{- else }}
                subject: order => order.OrderId,
                time: order => order.OrderDate))
{{- end }}
            // The sender resolves from DI like every other external dependency;
            // tests swap the SendStep<Context> registration for a FakeTopic.
            .WithSender(provider.GetRequiredService<SendStep<Context>>())
            .WithBusinessIncidents(
                messageIdExtractor: ctx => ctx.Metadata.GetValueOrDefault(Constants.ContextKeyOrderId,
                    ctx.Metadata.GetValueOrDefault(Constants.ContextKeyFileName, "unknown")),
                subjectExtractor: ctx => ctx.Metadata.GetValueOrDefault(Constants.ContextKeyOrderId,
                    ctx.Metadata.GetValueOrDefault(Constants.ContextKeyFileName, "unknown")))
            .Build();
    }
}
