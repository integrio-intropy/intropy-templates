using {{ .contracts }};
using Dapr.Client;
using {{ .name }}.Model;
using {{ .name }}.Process;
using Intropy.BusinessIncidentService.Client;
using Intropy.Framework.Adapters.File;
using Intropy.Framework.Blocks.Extractor;
using Intropy.Framework.Blocks.Extractor.Steps;
using Intropy.Framework.Blocks.Shared;
using Intropy.Framework.Core.Common;
using Intropy.Framework.Core.Configuration;
using Intropy.Framework.Hosting.Extractor;
using Intropy.Framework.Hosting.FileSweeps;
using Intropy.IdempotencyService.Client;
using Intropy.Telemetry;
using Intropy.Telemetry.ConsoleApp;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Logging;

namespace {{ .name }}.Composition;

/// <summary>
/// The component's service registrations, shared by the entrypoint
/// (<c>Program.cs</c>) and the composition smoke test. Everything the runner
/// needs — telemetry, Dapr clients, the source file adapter, the extract
/// pipeline — is registered here so the test can prove the whole graph
/// builds without a sidecar.
/// </summary>
public static class Composition
{
    /// <summary>
    /// The system's bus: the pub/sub component the message travels on. The topology
    /// names it and the system host and the deployment pass it in
    /// <c>INTROPY_PUBSUB_NAME</c>; neither the component's code nor the
    /// framework derives it.
    /// </summary>
    public static string PubSubName(IServiceProvider services) =>
        services.GetRequiredService<FrameworkOptions>().PubSubName
        ?? throw new InvalidOperationException(
            "INTROPY_PUBSUB_NAME is not set, so the system's pub/sub is unknown: run the component under its system host, or set FrameworkOptions.PubSubName.");

    /// <summary>
    /// The topic the extractor publishes on. The scaffold record declares it (the
    /// message name, or the shared topic given at scaffold time), the system host
    /// carries it into the topology, and the system host and the deployment pass
    /// what the topology settled in <c>INTROPY_TOPIC_NAME</c>: a topic the system
    /// later shares between messages reaches the extractor without a code change.
    /// </summary>
    public static string TopicName(IServiceProvider services) =>
        services.GetRequiredService<FrameworkOptions>().TopicName
        ?? throw new InvalidOperationException(
            "INTROPY_TOPIC_NAME is not set, so the topic is unknown: run the component under its system host, or set FrameworkOptions.TopicName.");

    /// <summary>Registers every service the extractor needs.</summary>
    /// <param name="services">The service collection to register into.</param>
    /// <param name="environment">The environment whose appsettings overlay applies. Defaults to
    /// DOTNET_ENVIRONMENT, or Production; tests pass Development.</param>
    public static IServiceCollection ConfigureServices(IServiceCollection services, string? environment = null)
    {
        environment ??= Environment.GetEnvironmentVariable("DOTNET_ENVIRONMENT") ?? "Production";

        // Configuration: appsettings.json + environment overlay + env vars. Based on the
        // binary directory, not the CWD — a host (or `dapr run`) may launch the app from a
        // different working directory. Registered so options binding and tests resolve the
        // same instance.
        var configuration = new ConfigurationBuilder()
            .SetBasePath(AppContext.BaseDirectory)
            .AddJsonFile("appsettings.json", optional: true, reloadOnChange: false)
            .AddJsonFile($"appsettings.{environment}.json", optional: true, reloadOnChange: false)
            .AddEnvironmentVariables()
            .Build();
        services.AddSingleton<IConfiguration>(configuration);

        // Register host-level platform plumbing first: diagnostics, Dapr, framework
        // services, and shared platform clients. Keeping these together makes the
        // ordering-sensitive DaprClient registrations obvious.
        services.AddLogging(builder => builder.AddConsole());

        // The service name is the component name, so traces identify the component through
        // the resource's service.name. Strict mode exports only the framework's Intropy.* spans
        // and the component's own: the Dapr gRPC and HttpClient spans around them are dropped,
        // while trace context still propagates. Tracing:Mode in configuration overrides it.
        // Intropy.Telemetry subscribes to no meters: add the framework's.
        services.AddOpenTelemetry(conf =>
        {
            conf.ServiceNamespace = Constants.Organization;
            conf.ServiceName = Constants.ComponentName;
            conf.Environment = environment;
            conf.Mode = TracingMode.Strict;
            conf.ConfigureMetrics = metrics => metrics.AddMeter(IntropyTelemetry.Meters);
        });

        services.AddSingleton(_ => new DaprClientBuilder().Build());

        // Registered after the DaprClient above on purpose: AddIdempotencyServiceClient
        // contributes its own DaprClient registration (camelCase JSON + string enums),
        // and the last registration wins for GetRequiredService<DaprClient>().
        services.AddIdempotencyServiceClient(c =>
        {
            c.AppId = configuration["PlatformServices:IdempotencyServiceAppId"]
                      ?? "idempotency-service.services";
        });

        services.AddBusinessIncidentServiceClient(c =>
        {
            c.AppId = configuration["PlatformServices:BusinessIncidentServiceAppId"]
                      ?? "business-incident-service.services";
        });

        services.AddIntropyFramework(x =>
        {
            x.ComponentName = Constants.ComponentName;
            x.ServiceNamespace = Constants.Organization;
        });

        // The file adapter behind each source port the framework sweeps is chosen by
        // configuration: Ports:<port>:Kind selects the Dapr binding the port is
        // deployed with (Local, Sftp or AzureBlob).
        // appsettings.Development.json selects Local, the local folder the system host
        // resolves each port to; a deployment sets Ports__<port>__Kind to match the binding it
        // renders. With no Kind, startup fails naming the port. A binding's address and
        // credentials live in the environment's Dapr component (GitOps values), resolved out of
        // the cluster's secret store.
        services.AddFileAdapter(Constants.SourcePort, configuration.GetSection(
            $"{PortServiceCollectionExtensions.PortsSectionName}:{Constants.SourcePort}"));

        // The publisher is a service like the other externals (source adapter,
        // platform clients): tests swap it for a FakeTopic via RemoveAll/AddSingleton,
        // exactly as they swap the others — no special seam in ConfigurePipeline.
        services.AddSingleton<SendStep<Context>>(sp => new DaprTopicPublisher<Context>(
            sp.GetRequiredService<DaprClient>(),
            PubSubName(sp),
            TopicName(sp),
            new Uri(Constants.EventSource),
            Constants.EventType));

        // Register the extractor last, after every adapter, publisher, and platform
        // client its pipeline resolves from DI has been added to the service collection.
        // The sources are the ports the framework sweeps once per run; the routes say
        // which pipeline each port's files go through. Each file gets a fresh context
        // (holding its file name and port) and its own pipeline, and is deleted once it
        // has been published or cancelled as a duplicate. A file that cannot be read or
        // processed stays for the next run. The run-to-completion host owns the Dapr
        // sidecar lifecycle, tracing, and exit codes; the job is named after the component.
        // A port carrying other data gets its own .Port(...) and .On(...) route, with a
        // pipeline of its own.
        services.AddExtractor(
            sources => sources.Port(Constants.SourcePort),
            routes => routes.On<Source{{ .payloadType }}, {{ .payloadType }}>(
                [Constants.SourcePort], ConfigurePipeline));

        return services;
    }

    /// <summary>
    /// Configures the extract pipeline of the <see cref="Constants.SourcePort"/> route against
    /// the DI graph. Every external dependency — sender, idempotency, business incidents —
    /// resolves from the provider, so a test swaps any of them by swapping its registration.
    /// The framework builds the pipeline for the port, so it stamps the port on every
    /// published event and keeps the idempotency records per port.
    /// </summary>
    public static ExtractorBuilder<Source{{ .payloadType }}, {{ .payloadType }}, Context> ConfigurePipeline(
        ExtractorBuilder<Source{{ .payloadType }}, {{ .payloadType }}, Context> builder, IServiceProvider provider)
    {
        return builder
            .WithDeserializer(new Deserializer())
            .WithValidator(new Validator())
            // Point the idempotency check at a stable business identifier and
            // timestamp — per-delivery values (fresh GUID, wall-clock time)
            // make the check pass everything.
            .WithIdempotency(
                idExtractor: (Source{{ .payloadType }} order, Context _) =>
{{- if .empty }}
                    throw new NotImplementedException(),
                dateExtractor: (_, _) =>
                    throw new NotImplementedException())
{{- else }}
                    order.OrderId,
                dateExtractor: (Source{{ .payloadType }} order, Context _) =>
                    order.OrderDate)
{{- end }}
            .WithTransformer(new Transformer())
            // The framework's serialize step owns the CloudEvent envelope (Id,
            // Subject, Time, Data) and validates Subject/Time at serialize time;
            // the publisher adds Source/Type from the registration above.
            .WithSerializer(new CloudEventSerializeStep<{{ .payloadType }}, Context>(
{{- if .empty }}
                subject: _ => throw new NotImplementedException(),
                time: _ => throw new NotImplementedException()))
{{- else }}
                subject: order => order.OrderId,
                time: order => order.OrderDate))
{{- end }}
            // The sender resolves from DI like every other external dependency;
            // tests swap the SendStep<Context> registration for a FakeTopic.
            .WithSender(provider.GetRequiredService<SendStep<Context>>())
            .WithBusinessIncidents(
                messageIdExtractor: ctx => ctx.Metadata.GetValueOrDefault(Constants.ContextKeyOrderId,
                    ctx.Metadata.GetValueOrDefault(Constants.ContextKeyFileName, "unknown")),
                subjectExtractor: ctx => ctx.Metadata.GetValueOrDefault(Constants.ContextKeyOrderId,
                    ctx.Metadata.GetValueOrDefault(Constants.ContextKeyFileName, "unknown")));
    }
}
