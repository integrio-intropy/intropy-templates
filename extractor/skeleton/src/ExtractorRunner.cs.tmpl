using Dapr.Client;
using Microsoft.Extensions.Logging;

namespace {{ .name }};

/// <summary>
/// Runs the extractor as a run-to-completion job: waits for the Dapr sidecar,
/// sweeps the inbound folder once via <see cref="Sweep"/>, shuts the sidecar
/// down, and exits. Scheduling lives outside the block: the system host
/// locally, a Kubernetes CronJob in production.
/// </summary>
public class ExtractorRunner(
    DaprClient daprClient,
    Sweep sweep,
    ILoggerFactory loggerFactory)
{
    private const int SidecarTimeoutSeconds = 30;
    private const int SidecarShutdownTimeoutSeconds = 10;

    private readonly ILogger _logger = loggerFactory.CreateLogger("{{ .name }}.Pipeline");

    /// <summary>
    /// Waits for the Dapr sidecar, sweeps the inbound folder once, and returns.
    /// </summary>
    /// <returns>0 when every swept file succeeded (or the run was aborted), 1 on failure.</returns>
    public async Task<int> RunAsync(CancellationToken ct)
    {
        try
        {
            using var sidecarCts = new CancellationTokenSource(TimeSpan.FromSeconds(SidecarTimeoutSeconds));
            await daprClient.WaitForSidecarAsync(sidecarCts.Token);
        }
        catch (Exception e)
        {
            _logger.LogError(e, "Dapr sidecar did not become available within {TimeoutSeconds} seconds",
                SidecarTimeoutSeconds);
            return 1;
        }

        try
        {
            var failed = await sweep.SweepAsync(ct);
            return failed == 0 ? 0 : 1;
        }
        catch (OperationCanceledException)
        {
            // An aborted run is not a failure: unprocessed files stay safely
            // in the inbound folder for the next scheduled run.
            return 0;
        }
        catch (Exception e)
        {
            _logger.LogError(e, "Extractor failed");
            return 1;
        }
        finally
        {
            try
            {
                // Bounded on purpose: a wedged sidecar must not hang the job
                // after a successful sweep — the scheduler would record a
                // failed run despite 0 failed files.
                using var shutdownCts = new CancellationTokenSource(
                    TimeSpan.FromSeconds(SidecarShutdownTimeoutSeconds));
                await daprClient.ShutdownSidecarAsync(shutdownCts.Token);
            }
            catch (Exception e)
            {
                _logger.LogWarning(e, "Failed to shut down Dapr sidecar");
            }
        }
    }
}
