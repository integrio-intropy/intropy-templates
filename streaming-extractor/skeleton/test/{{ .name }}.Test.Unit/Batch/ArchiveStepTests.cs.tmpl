{{- if not .empty }}
using CloudNative.CloudEvents;
using {{ .name }}.Batch;
using {{ .name }}.Batch.Steps;
using {{ .name }}.Configuration;
using {{ .name }}.Model;
using Intropy.Framework.Core.Pipeline.Abstractions.Results;
using Intropy.Framework.Testing.Adapters;
using Microsoft.Extensions.Logging.Abstractions;

namespace {{ .name }}.Test.Unit.Batch;

/// Covers archiving after a successful publish: every consumed input moves
/// under the processed prefix (which is what makes a completed batch invisible
/// to the next run's detection), and the CloudEvent passes through untouched.
public sealed class ArchiveStepTests
{
    private const string BatchId = "2026-06-01T120554";

    private static readonly IngestOptions Options = new()
    {
        IncomingPrefix = "incoming",
        OutputPrefix = "output",
        ProcessedPrefix = "processed",
        ReadyMarkerName = "Ready.json",
    };

    private static readonly string[] EntityFiles = ["1 - Items.json"];

    [Fact]
    public async Task MovesAllInputsAndMarkerToProcessed_PassesEventThrough()
    {
        var files = new InMemoryFileAdapter();
        foreach (var name in EntityFiles.Append("Ready.json"))
        {
            files.AddFile($"incoming/{BatchId}/{name}", "{}");
        }

        var batch = new {{ .contract }}Batch(BatchId, $"incoming/{BatchId}/Ready.json",
            EntityFiles.Select(f => new BatchFile($"incoming/{BatchId}/{f}", "entity")).ToList());
        var context = new {{ .contract }}BatchContext { Batch = batch };
        var cloudEvent = new CloudEvent { Id = BatchId };

        var step = new ArchiveStep(files, Options, NullLogger<ArchiveStep>.Instance);

        var (result, _) = await step.ExecuteAsync(cloudEvent, context, CancellationToken.None);

        var success = Assert.IsType<TechnicalStepResult<CloudEvent>.Success>(result);
        Assert.Same(cloudEvent, success.Value);

        foreach (var name in EntityFiles.Append("Ready.json"))
        {
            Assert.False(await files.ExistsAsync($"incoming/{BatchId}/{name}", CancellationToken.None),
                $"{name} should have left the incoming prefix");
            Assert.True(await files.ExistsAsync($"processed/{BatchId}/{name}", CancellationToken.None),
                $"{name} should have arrived under the processed prefix");
        }
    }
}
{{- end }}
