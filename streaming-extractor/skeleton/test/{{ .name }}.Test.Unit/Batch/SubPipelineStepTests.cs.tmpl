{{- if not .empty }}
using {{ .name }}.Batch;
using {{ .name }}.Batch.Steps;
using {{ .name }}.Configuration;
using {{ .name }}.Model;
using Intropy.Framework.Blocks.Streamed;
using Intropy.Framework.Core.Pipeline.Abstractions.Results;
using Intropy.Framework.Streaming;
using Intropy.Framework.Testing.Adapters;
using Microsoft.Extensions.Logging.Abstractions;

namespace {{ .name }}.Test.Unit.Batch;

/// Pins the sub-pipeline step's two load-bearing contracts: a successful file
/// records its .jsonl output (named from the source file) and counts on the
/// context for the summary event, and a file with zero valid records produces
/// no output at all — the entity is left out of the summary rather than
/// pointing at an empty file. Failure mapping (any streamed failure fails the
/// batch as a whole) is covered end-to-end by the integration suite.
public sealed class SubPipelineStepTests
{
    private const string EntityType = Constants.SampleEntityType;
    private const string BatchId = "2026-06-01T120554";

    private static readonly IngestOptions Options = new()
    {
        IncomingPrefix = "incoming",
        OutputPrefix = "out",
        ProcessedPrefix = "processed",
        ReadyMarkerName = "Ready.json",
    };

    private static {{ .contract }}Batch BatchWithItemFile() =>
        new(BatchId, $"incoming/{BatchId}/Ready.json",
            [new BatchFile($"incoming/{BatchId}/1 - Items.json", EntityType)]);

    private static SubPipelineStep StepWith(InMemoryFileAdapter files, params IStreamedExtractor[] extractors) =>
        new(files, extractors, Options, NullLogger<SubPipelineStep>.Instance);

    /// A test double for a streamed extractor: returns a preset
    /// <see cref="StepResult{StreamSource}"/> and optionally mutates the per-file
    /// <see cref="StreamedContext"/> the sub-pipeline step then reads (e.g. to set
    /// <c>ValidCount</c>).
    private sealed class FakeStreamedExtractor(
        string entityType,
        Func<StreamSource, StepResult<StreamSource>> result,
        Action<StreamedContext>? mutate = null) : IStreamedExtractor
    {
        public string EntityType { get; } = entityType;

        public Task<(StepResult<StreamSource> Result, StreamedContext Context)> Execute(
            StreamSource source, StreamedContext context, CancellationToken ct)
        {
            mutate?.Invoke(context);
            return Task.FromResult((result(source), context));
        }
    }

    private static InMemoryFileAdapter FilesWithItemInput()
    {
        var files = new InMemoryFileAdapter();
        files.AddFile($"incoming/{BatchId}/1 - Items.json", "{}");
        return files;
    }

    [Fact]
    public async Task Success_RecordsOutputFileWithCountsAndJsonlName()
    {
        var extractor = new FakeStreamedExtractor(EntityType,
            source => new StepResult<StreamSource>.Success(source),
            ctx => ctx.ValidCount = 5);
        var context = new {{ .contract }}BatchContext();

        var (result, ctxOut) = await StepWith(FilesWithItemInput(), extractor)
            .ExecuteAsync(BatchWithItemFile(), context, CancellationToken.None);

        Assert.IsType<TechnicalStepResult<{{ .contract }}Batch>.Success>(result);

        // Output is JSON Lines, so the produced file always carries a .jsonl extension
        // with the source file's base name preserved.
        Assert.Equal($"out/{BatchId}/1 - Items.jsonl", ctxOut.OutputFiles[EntityType]);

        var streamed = ctxOut.ProcessedFiles[EntityType];
        Assert.Equal(5, streamed.ValidCount);
        Assert.Empty(streamed.InvalidItems);
    }

    [Fact]
    public async Task Success_EmptyFile_OmitsFileFromOutputs_DoesNotFailBatch()
    {
        // An empty file flows through as Success with ValidCount 0; the writer never opened
        // an output file, so the entity is left out of the summary entirely. The batch still
        // carries on rather than aborting or failing.
        var extractor = new FakeStreamedExtractor(EntityType,
            source => new StepResult<StreamSource>.Success(source),
            ctx => ctx.ValidCount = 0);
        var context = new {{ .contract }}BatchContext();

        var (result, ctxOut) = await StepWith(FilesWithItemInput(), extractor)
            .ExecuteAsync(BatchWithItemFile(), context, CancellationToken.None);

        Assert.IsType<TechnicalStepResult<{{ .contract }}Batch>.Success>(result);
        Assert.Empty(ctxOut.OutputFiles);
        Assert.Empty(ctxOut.ProcessedFiles);
    }
}
{{- end }}
