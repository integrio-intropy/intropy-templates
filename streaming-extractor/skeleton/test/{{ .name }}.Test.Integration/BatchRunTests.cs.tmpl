using {{ .name }}.Batch;
using {{ .name }}.Model;
using Intropy.Framework.Blocks.Batch;
using Intropy.Framework.Blocks.Shared;
using Intropy.Framework.Core.Pipeline.Abstractions.Results;
using CloudNative.CloudEvents;
using Microsoft.Extensions.DependencyInjection;

namespace {{ .name }}.Test.Integration;

/// <summary>
/// The full batch chain (detect → sub-pipelines → serialize → publish →
/// archive) over one detected batch, with <c>FakeTopic</c> at the publish edge
/// and an in-memory source adapter. The pipeline is built exactly as
/// production composition does — only the four externals are faked — and
/// assertions read fake state directly. These tests pin the batch consumption
/// contract: a complete batch publishes one summary event and is archived;
/// nothing-ready is a quiet clean run; failures leave the batch in place.
/// </summary>
public class BatchRunTests
{
    private const string BatchId = "2026-01-15T093000";
{{- if .empty }}
    // Test-owned sample input: the scaffold's source shape is an empty record
    // shell until the real contract is defined. Every test below fails from the
    // start by design — the throwing steps route the batch to a business
    // incident without publishing — and flips green as the steps are
    // implemented. The nothing-ready test is the exception: it never reaches a
    // throwing step... it does (DetectStep throws), so it fails too until
    // detection is implemented. The failing tests are the to-do list.
{{- end }}
    private const string RecordsJson =
        """{"Data":[{"recordId":"REC-1","name":"First","occurredAt":"2026-01-15T09:30:00+00:00"}]}""";

    private (BatchPipeline<{{ .contract }}Batch, {{ .contract }}BatchContext> Pipeline, FakeEdges Edges) CreateSut()
    {
        var edges = new FakeEdges();
        var provider = edges.CreateServices().BuildServiceProvider();
        return (edges.BuildPipeline(provider), edges);
    }

    [Fact]
    public async Task Execute_WithReadyBatch_PublishesSummaryAndArchivesInputs()
    {
        // Arrange
        var (pipeline, edges) = CreateSut();
        edges.Files.AddFile($"incoming/{BatchId}/{{ .contract | lower }}.json", RecordsJson);
        edges.Files.AddFile($"incoming/{BatchId}/Ready.json", "{}");

        // Act
        var (result, _) = await pipeline.Execute(new {{ .contract }}BatchContext(), CancellationToken.None);

        // Assert
        Assert.Equal("Success", result.GetType().Name);
        var published = Assert.Single(edges.Topic.Events);
        Assert.Equal(BatchId, published.Subject);
        // Consumed inputs (and the ready marker) are archived, not deleted.
        Assert.Contains(edges.Files.Files.Keys,
            name => name.Contains("processed", StringComparison.Ordinal));
        Assert.DoesNotContain(edges.Files.Files.Keys,
            name => name.StartsWith("incoming", StringComparison.Ordinal));
    }

    [Fact]
    public async Task Execute_WithNothingReady_CompletesQuietlyWithoutPublishing()
    {
        // Arrange
        var (pipeline, edges) = CreateSut();

        // Act
        var (result, _) = await pipeline.Execute(new {{ .contract }}BatchContext(), CancellationToken.None);

        // Assert: Cancelled is the nothing-ready convention — a clean run.
        Assert.Equal("Cancelled", result.GetType().Name);
        Assert.Empty(edges.Topic.Events);
    }

    [Fact]
    public async Task Execute_WhenPublishFails_LeavesBatchInPlace()
    {
        // Arrange: a dead broker surfaces as a technical failure.
        var (pipeline, edges) = CreateSut();
        edges.Files.AddFile($"incoming/{BatchId}/{{ .contract | lower }}.json", RecordsJson);
        edges.Files.AddFile($"incoming/{BatchId}/Ready.json", "{}");
        edges.Topic.SendException = new InvalidOperationException("Broker unreachable");

        // Act
        var (result, _) = await pipeline.Execute(new {{ .contract }}BatchContext(), CancellationToken.None);

        // Assert: the batch stays under incoming/ for the next scheduled run.
        Assert.NotEqual("Success", result.GetType().Name);
        Assert.Empty(edges.Topic.Events);
        Assert.Contains(edges.Files.Files.Keys,
            name => name.StartsWith("incoming", StringComparison.Ordinal));
    }
}
