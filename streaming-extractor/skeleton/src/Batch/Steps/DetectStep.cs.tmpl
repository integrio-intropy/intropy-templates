using System.Globalization;
using {{ .name }}.Configuration;
using {{ .name }}.Model;
using Intropy.Contracts.BusinessIncidentService;
using Intropy.Framework.Adapters.File;
using Intropy.Framework.Blocks.Batch;
using Intropy.Framework.Blocks.Batch.Steps;
using Intropy.Framework.Core.Pipeline.Abstractions.Results;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Logging;

namespace {{ .name }}.Batch.Steps;

/// <summary>
/// Detects the next batch to process: scans the incoming prefix, picks the
/// oldest fully-delivered batch, and returns it. Detection is also the
/// batch's idempotency seam — it must never return a batch that has already
/// completed (consumed inputs are archived by <c>ArchiveStep</c>, so an
/// archived batch no longer appears under the incoming prefix).
/// </summary>
/// <remarks>
/// Outcome contract: <c>Success(batch)</c> when a batch should run;
/// <c>Cancelled</c> when nothing is ready (the normal quiet exit for a
/// scheduled run with no work); <c>BusinessFailure</c> when a batch is
/// marked ready but incomplete (routed as a business incident); technical
/// failures (unreachable source) bubble up through the base step wrapper.
/// </remarks>
public class DetectStep(
    [FromKeyedServices(Constants.SourceFileAdapterKey)] IFileStreamAdapter files,
    IngestOptions options,
    ILogger<DetectStep> logger)
    : BatchReceiveStep<{{ .contract }}Batch, {{ .contract }}BatchContext>
{
{{- if .empty }}
    /// <inheritdoc />
    public override Task<(StepResult<{{ .contract }}Batch> Result, {{ .contract }}BatchContext Context)> ExecuteAsync(
        Unit input, {{ .contract }}BatchContext context, CancellationToken ct) =>
        throw new NotImplementedException();
{{- else }}
    // Sample batch layout: the producer stamps each batch folder with its UTC export
    // time (fixed-width, zero-padded, so ordinal sort is chronological order) and
    // drops one JSON file per entity inside. Replace the expected-file list and the
    // entity mapping with the producer's real naming convention.
    private static readonly IReadOnlyList<ExpectedFile> ExpectedFiles =
    [
        new("1 - Items.json", Constants.SampleEntityType),
    ];

    private sealed record ExpectedFile(string FileName, string EntityType);

    private static readonly string[] TimestampFormats = ["yyyy-MM-ddTHHmmss"];

    private static bool IsTimestampFolder(string name) =>
        DateTime.TryParseExact(name, TimestampFormats, CultureInfo.InvariantCulture,
            DateTimeStyles.None, out _);

    /// <inheritdoc />
    public override async Task<(StepResult<{{ .contract }}Batch> Result, {{ .contract }}BatchContext Context)> ExecuteAsync(
        Unit input, {{ .contract }}BatchContext context, CancellationToken ct)
    {
        foreach (var timestamp in await CollectTimestampFoldersAsync(ct))
        {
            var readyMarkerFile = CombinePath(options.IncomingPrefix, timestamp, options.ReadyMarkerName);
            if (!await files.ExistsAsync(readyMarkerFile, ct))
            {
                logger.LogDebug("Skipping {Timestamp} — ready marker not present yet.", timestamp);
                continue;
            }

            logger.LogInformation("Selected oldest batch {Timestamp} for processing.", timestamp);

            // A marked-ready batch that is missing files is a data/business problem
            // the process owner must resolve, not a technical failure — route it as
            // a business incident and leave the batch in place.
            var missing = new List<string>();
            var resolved = new List<BatchFile>(ExpectedFiles.Count);
            foreach (var expected in ExpectedFiles)
            {
                var fileName = CombinePath(options.IncomingPrefix, timestamp, expected.FileName);
                if (!await files.ExistsAsync(fileName, ct))
                {
                    missing.Add(fileName);
                    continue;
                }

                resolved.Add(new BatchFile(fileName, expected.EntityType));
            }

            if (missing.Count > 0)
            {
                logger.LogWarning(
                    "Batch {BatchId} is marked ready but {Count} expected file(s) are missing: {Missing}",
                    timestamp, missing.Count, string.Join(", ", missing));
                return (new StepResult<{{ .contract }}Batch>.BusinessFailure(
                    IncidentForIncompleteBatch(timestamp, missing)), context);
            }

            logger.LogInformation("Detected batch {BatchId} with {Count} file(s)", timestamp, resolved.Count);
            context.Metadata[Constants.ContextKeyBatchId] = timestamp;
            var batch = new {{ .contract }}Batch(timestamp, readyMarkerFile, resolved);
            context.Batch = batch;
            return (new StepResult<{{ .contract }}Batch>.Success(batch), context);
        }

        logger.LogInformation("No batch ready under {Prefix} — pipeline cancelled.", options.IncomingPrefix);
        return (new StepResult<{{ .contract }}Batch>.Cancelled(), context);
    }

    private async Task<SortedSet<string>> CollectTimestampFoldersAsync(CancellationToken ct)
    {
        var prefixWithSlash = string.IsNullOrWhiteSpace(options.IncomingPrefix)
            ? string.Empty
            : options.IncomingPrefix.EndsWith('/')
                ? options.IncomingPrefix
                : options.IncomingPrefix + "/";

        var folders = new SortedSet<string>(StringComparer.Ordinal);
        var skipped = new HashSet<string>(StringComparer.Ordinal);

        // The adapter contract's listing takes no prefix; filter client-side.
        foreach (var file in await files.ListAsync())
        {
            ct.ThrowIfCancellationRequested();

            var fileName = file.FileName;
            if (!fileName.StartsWith(prefixWithSlash, StringComparison.Ordinal))
                continue;

            var relative = fileName[prefixWithSlash.Length..];
            var slash = relative.IndexOf('/');
            if (slash <= 0)
                continue;

            var folder = relative[..slash];
            if (folders.Contains(folder))
                continue;

            // Ignore anything that isn't a timestamp folder (partial uploads, stray
            // folders). Log once per skipped name so a misnamed real batch is visible.
            if (!IsTimestampFolder(folder))
            {
                if (skipped.Add(folder))
                    logger.LogDebug("Ignoring {Folder} under {Prefix} — not a timestamp folder.",
                        folder, prefixWithSlash);
                continue;
            }

            folders.Add(folder);
        }

        return folders;
    }

    private static string CombinePath(params string[] parts) =>
        string.Join('/', parts.Select(p => p.Trim('/')).Where(p => p.Length > 0));

    private static BusinessIncidentData IncidentForIncompleteBatch(
        string batchId, IReadOnlyList<string> missingFiles) => new()
    {
        Description =
            $"Export {batchId} is marked ready but {missingFiles.Count} " +
            $"expected file(s) are missing: {string.Join(", ", missingFiles)}.",
        Context = new Dictionary<string, string>
        {
            ["exportId"] = batchId,
            ["missingFiles"] = string.Join(", ", missingFiles),
        },
    };
{{- end }}
}
