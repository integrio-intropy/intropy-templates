namespace {{ .name }}.Model;

/// <summary>
/// A detected batch: a stable identifier plus the files that belong to it.
/// The id is the batch's whole identity — the CloudEvent subject, the
/// business-incident key, and the archive folder all derive from it, so it
/// must be stable across retries (e.g. the producer's export timestamp
/// folder), never a per-run value like a fresh GUID.
/// </summary>
/// <param name="BatchId">Stable batch identifier (see class remarks).</param>
/// <param name="ReadyMarkerFile">Full name of the ready-marker file that
/// claimed this batch complete — archived last by <c>ArchiveStep</c>, since
/// its presence under the incoming prefix is what makes a batch visible.</param>
/// <param name="Files">The files the batch consists of, with the entity type
/// each one carries — the key that matches a file to its registered streamed
/// extractor.</param>
public record {{ .contract }}Batch(string BatchId, string ReadyMarkerFile, IReadOnlyList<BatchFile> Files);

/// <summary>One file in a detected batch.</summary>
/// <param name="FileName">The file's name, as the source adapter sees it.</param>
/// <param name="EntityType">The entity type of the file's records; matched
/// against the registered streamed extractors by <c>SubPipelineStep</c>.</param>
public record BatchFile(string FileName, string EntityType);
