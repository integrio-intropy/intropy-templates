namespace {{ .name }}.Configuration;

/// <summary>
/// File layout on the source: where deliveries arrive, where streamed output
/// is written, and where consumed inputs are archived. Bound from the
/// <c>Ingest</c> configuration section; every value is a prefix the source
/// adapter resolves behind the component's source port.
/// </summary>
public record IngestOptions
{
    public const string SectionName = "Ingest";

    /// <summary>Name of the location behind the source port, carried on the
    /// published reference event so downstream consumers can address the
    /// output (e.g. the blob container in deployment). Defaults to the source
    /// port name when unset.</summary>
    public string? LocationName { get; init; }

    /// <summary>Prefix the producer delivers files under (e.g. "incoming").
    /// The sweep lists the files directly under this prefix.</summary>
    public required string IncomingPrefix { get; init; }

    /// <summary>Prefix streamed output is written under (e.g. "output").</summary>
    public required string OutputPrefix { get; init; }

    /// <summary>Prefix consumed inputs are archived under after a successful
    /// publish (e.g. "processed"). The archive is what makes a processed file
    /// invisible to the next run's sweep.</summary>
    public required string ProcessedPrefix { get; init; }
}
