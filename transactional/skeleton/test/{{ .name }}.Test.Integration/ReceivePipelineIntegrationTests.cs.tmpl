using System.Text;
using {{ .name }}.Configuration;
using Intropy.Framework.Blocks.Shared;
using Intropy.Framework.Blocks.TransactionalIntegration.Receive;
using Intropy.Framework.Core.Pipeline.Abstractions.Results;
using Microsoft.Extensions.DependencyInjection;

namespace {{ .name }}.Test.Integration;

/// <summary>
/// The receive pipeline, resolved from the real DI graph with the broker edge
/// swapped for <see cref="Intropy.Framework.Testing.Topics.FakeEnqueueStep{TCtx}"/>
/// through the component's own override seam (see <see cref="FakeEdges"/>). The
/// pipeline publishes one source item to the integration's queue: a valid item
/// is enqueued, and a dead broker is a technical failure. Reading the source
/// file and deleting it afterwards belong to the framework's sweep, which keeps
/// any file that could not be read or published for the next run.
/// </summary>
public class ReceivePipelineIntegrationTests
{
    private const string ValidOrderJson =
        """{"orderId":"ORD-1001","customerId":"CUST-42","orderDate":"2026-01-15T09:30:00+00:00","lines":[{"sku":"SKU-1","quantity":2,"unitPrice":10.0}]}""";

    [Fact]
    public async Task Execute_WithValidItem_EnqueuesIt()
    {
        // Arrange
        var edges = new FakeEdges();
        var provider = edges.CreateServices(fakeEnqueue: true).BuildServiceProvider();
        var pipeline = provider.GetRequiredService<IReceivePipeline<Context>>();

        // Act
        var (result, _) = await pipeline.Execute(Item("order-1.json"), NewContext("order-1.json"));

        // Assert
        Assert.IsType<StepResult<SourceItem>.Success>(result);
        var captured = Assert.Single(edges.Enqueue!.Captured);
        Assert.Equal("order-1.json", captured.Item.Id);
    }

    [Fact]
    public async Task Execute_WhenBrokerIsDown_IsATechnicalFailure()
    {
        // Arrange: SendException surfaces as a technical failure, matching a
        // dead broker; the framework then keeps the source file for the next run.
        var edges = new FakeEdges();
        var provider = edges.CreateServices(fakeEnqueue: true).BuildServiceProvider();
        var pipeline = provider.GetRequiredService<IReceivePipeline<Context>>();
        edges.Enqueue!.SendException = new InvalidOperationException("Broker unreachable");

        // Act
        var (result, _) = await pipeline.Execute(Item("order-1.json"), NewContext("order-1.json"));

        // Assert
        Assert.IsType<StepResult<SourceItem>.TechnicalFailure>(result);
        Assert.Equal(0, edges.Enqueue.Count);
    }

    private static SourceItem Item(string fileName) => new(fileName, Encoding.UTF8.GetBytes(ValidOrderJson));

    // The framework seeds every source file's context with its file name.
    private static Context NewContext(string fileName) =>
        new(new Dictionary<string, string> { [Constants.ContextKeyFileName] = fileName });
}
