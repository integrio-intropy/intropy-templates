using Dapr.Client;
using {{ .name }}.Configuration;
using {{ .name }}.Receive;
using Intropy.Framework.Blocks.Shared;
using Intropy.Framework.Blocks.TransactionalIntegration.Receive;
using Intropy.Framework.Core.Configuration;
using Intropy.Framework.Hosting.TransactionalIntegration.Job;
using Intropy.Framework.Testing.Dapr;
using Microsoft.Extensions.DependencyInjection;
using NSubstitute;

namespace {{ .name }}.Test.Integration;

/// <summary>
/// Proves the component's <see cref="Enqueuer"/> wires the pub/sub component
/// name, topic, and payload correctly against the real <see cref="DaprClient"/>
/// publish seam — the one edge the testing library deliberately leaves to a
/// mocking framework. The substitute forwards publish calls into a
/// <see cref="PublishedMessageCapture"/>, which owns the wire-level assertions.
/// This is the suite's only NSubstitute usage.
/// </summary>
public class EnqueuePublishTests
{
    [Fact]
    public async Task ExecuteAsync_PublishesRawPayloadToConfiguredTopic()
    {
        // Arrange
        var daprClient = Substitute.For<DaprClient>();
        var capture = new PublishedMessageCapture();
        daprClient
            .PublishByteEventAsync(
                Arg.Any<string>(), Arg.Any<string>(), Arg.Any<ReadOnlyMemory<byte>>(),
                Arg.Any<string>(), Arg.Any<Dictionary<string, string>?>(), Arg.Any<CancellationToken>())
            .Returns(Task.CompletedTask)
            .AndDoes(ci => capture.Capture(
                ci.ArgAt<string>(0), ci.ArgAt<string>(1), ci.ArgAt<ReadOnlyMemory<byte>>(2),
                ci.ArgAt<string>(3)));

        var provider = Composition.ConfigureServices(new ServiceCollection())
            .AddSingleton(daprClient) // last registration wins for DaprClient
            .BuildServiceProvider();

        var enqueuer = new Enqueuer(
            daprClient,
            provider.GetRequiredService<TransactionalIntegrationOptions>(),
            provider.GetRequiredService<FrameworkOptions>());

        const string payload = """{"orderId":"ORD-1001"}""";
        var item = new SourceItem("order-1.json", System.Text.Encoding.UTF8.GetBytes(payload));

        // Act
        await enqueuer.ExecuteAsync(item, NewContext(), CancellationToken.None);

        // Assert: the raw payload goes to the configured pub/sub component and
        // topic. The enqueuer publishes the item bytes as application/json —
        // the structured-mode CloudEvent envelope is built by the framework's
        // EnqueueStep base, not asserted here (see ReceivePipelineIntegrationTests).
        var message = Assert.Single(capture.Messages);
        Assert.Equal(Constants.PubSubName, message.PubSubName);
        Assert.Equal(Constants.TopicName, message.TopicName);
        Assert.Equal(payload, message.GetDataAsString());
    }

    private static Context NewContext() => new(new Dictionary<string, string>());
}
