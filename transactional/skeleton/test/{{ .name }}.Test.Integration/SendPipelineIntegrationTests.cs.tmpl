namespace {{ .name }}.Test.Integration;

/// <summary>
{{- if eq .source "sql" }}
/// The full send pipeline (deserialize → idempotency → extract → validate →
/// transform → serialize → send), built from the real DI graph with only the
/// externals faked (see <see cref="FakeEdges"/>), for one SQL read as the
/// receive side queues it: the rows as a JSON array, and the read's watermark
/// range on its context. These tests pin the send pipeline's consumption
/// contract: a read is written and its range committed; a range already
/// committed is consumed without writing again; a destination fault routes an
/// incident named by the range and stays retriable.
/// </summary>
{{- else if .empty }}
/// The full send pipeline (deserialize → extract → validate → transform →
/// serialize → send), built from the real DI graph with only the externals
/// faked (see <see cref="FakeEdges"/>). These tests pin the send pipeline's
/// consumption contract: a valid message is written to the destination.
/// </summary>
{{- else }}
/// The full send pipeline (deserialize → idempotency → extract → validate →
/// transform → serialize → send), built from the real DI graph with only
/// the externals faked (see <see cref="FakeEdges"/>). These tests pin the send
/// pipeline's consumption contract: a valid message is written and committed;
/// a duplicate is consumed without rewriting or recommitting; a validation
/// failure routes an incident and is consumed; a destination fault surfaces
/// as a <em>business</em> failure (the transactional <c>SendStep</c> is a
/// <c>BusinessStep</c>) that routes an incident and stays retriable, so the
/// message is redelivered rather than lost.
/// </summary>
{{- end }}
public class SendPipelineIntegrationTests
{
{{- if eq .source "sql" }}
    // One read of Sql/Query.sql's rows, as the SQL source sends it. Replace it
    // with a real sample when the query changes.
    private const string ReadJson =
        """[{"ChangeId":1,"RecordId":"REC-1","ChangedAt":"2026-01-15T09:30:00+00:00"},{"ChangeId":2,"RecordId":"REC-2","ChangedAt":"2026-01-15T09:30:01+00:00"}]""";

    private static readonly string s_range = $"{Constants.SourcePort}:int:0:int:2";

    // Every test in this suite fails from the start: the framework's
    // BusinessStep wrapper routes the throwing Deserializer as a business
    // incident, so the pipeline consumes the input with nothing written. Each
    // failure flips green as the steps are implemented — no test edits needed.

    [Fact]
    public async Task Execute_WithARead_WritesOutputAndCommitsTheRange()
    {
        // Arrange
        var edges = new FakeEdges();
        var provider = edges.CreateServices().BuildServiceProvider();
        var pipeline = FakeEdges.ResolveSendPipeline(provider);

        // Act
        var (result, _) = await pipeline.Execute(
            Encoding.UTF8.GetBytes(ReadJson), NewReadContext(), CancellationToken.None);

        // Assert
        Assert.IsType<StepResult<byte[]>.Success>(result);
        Assert.Single(edges.DestinationFiles.Files);
        Assert.Equal([s_range], edges.Idempotency.Committed.Select(m => m.Id));
    }

    [Fact]
    public async Task Execute_WithARangeAlreadyCommitted_WritesNothing()
    {
        // Arrange: a run that failed after queueing reads the same range again.
        var edges = new FakeEdges();
        edges.Idempotency.NextStatus = new StatusResponse(Action.Ignore, Reason.SameData);
        var provider = edges.CreateServices().BuildServiceProvider();
        var pipeline = FakeEdges.ResolveSendPipeline(provider);

        // Act
        var (result, _) = await pipeline.Execute(
            Encoding.UTF8.GetBytes(ReadJson), NewReadContext(), CancellationToken.None);

        // Assert: the duplicate cancels as a traceable no-op.
        Assert.IsType<StepResult<byte[]>.Cancelled>(result);
        Assert.Empty(edges.DestinationFiles.Files);
        Assert.Empty(edges.Idempotency.Committed);
    }

    [Fact]
    public async Task Execute_WhenDestinationThrows_RoutesAnIncidentForTheRange_AndKeepsTheReadForRedelivery()
    {
        // Arrange: the transactional SendStep is a BusinessStep, so a fault at the
        // destination adapter routes an incident. An unreachable destination says
        // nothing about the data, so the failure stays retriable.
        var edges = new FakeEdges();
        edges.DestinationFiles.WriteException = new InvalidOperationException("Destination unreachable");
        var provider = edges.CreateServices().BuildServiceProvider();
        var pipeline = FakeEdges.ResolveSendPipeline(provider);

        // Act
        var (result, _) = await pipeline.Execute(
            Encoding.UTF8.GetBytes(ReadJson), NewReadContext(), CancellationToken.None);

        // Assert: one incident from the Send step, named by the read's range;
        // nothing written or committed.
        var failure = Assert.IsType<StepResult<byte[]>.BusinessFailure>(result);
        Assert.True(failure.Retriable);
        Assert.Empty(edges.DestinationFiles.Files);
        Assert.Empty(edges.Idempotency.Committed);
        var incident = Assert.Single(edges.Incidents.Incidents);
        Assert.Equal(s_range, incident.Subject);
        Assert.Contains("'Send' step", incident.Data.Description);
    }

    // What the receive side stamps on a read's context and carries to the send
    // side: its port, its range and when it was read.
    private static Context NewReadContext() => new(new Dictionary<string, string>
    {
        [SourceContextKeys.SourcePort] = Constants.SourcePort,
        [Constants.ContextKeyIdempotencyKey] = s_range,
        [SourceContextKeys.ReceivedAt] = DateTimeOffset.UtcNow.ToString("O")
    });
{{- else if .empty }}
    // Test-owned valid input: the scaffold's In/Out records are empty shells
    // until the real contract is defined, so this file deliberately uses its
    // own field names instead of guessing the eventual shape. Replace it with
    // real payload samples as the steps land.
    private const string ValidRecordJson =
        """{"orderId":"ORD-1001","customerId":"CUST-42","orderDate":"2026-01-15T09:30:00+00:00","lines":[{"sku":"SKU-1","quantity":2,"unitPrice":10.0}]}""";

    // Every test in this suite fails from the start: the framework's
    // BusinessStep wrapper routes the throwing Deserializer as a business
    // incident, so the pipeline consumes the input with nothing written — the
    // exact opposite of the written/committed outcomes these tests pin. Each
    // failure flips green as the steps are implemented — no test edits needed.

    [Fact]
    public async Task Execute_WithValidMessage_WritesOutput()
    {
        // Arrange
        var edges = new FakeEdges();
        var provider = edges.CreateServices().BuildServiceProvider();
        var pipeline = FakeEdges.ResolveSendPipeline(provider);

        // Act
        var (result, _) = await pipeline.Execute(
            Encoding.UTF8.GetBytes(ValidRecordJson), NewContext(), CancellationToken.None);

        // Assert
        Assert.IsType<StepResult<byte[]>.Success>(result);
        Assert.Single(edges.DestinationFiles.Files);
    }
{{- else }}
    private const string ValidOrderJson =
        """{"orderId":"ORD-1001","customerId":"CUST-42","orderDate":"2026-01-15T09:30:00+00:00","lines":[{"sku":"SKU-1","quantity":2,"unitPrice":10.0}]}""";

    [Fact]
    public async Task Execute_WithValidMessage_WritesOutputAndCommitsIdempotency()
    {
        // Arrange
        var edges = new FakeEdges();
        var provider = edges.CreateServices().BuildServiceProvider();
        var pipeline = FakeEdges.ResolveSendPipeline(provider);

        // Act
        var (result, _) = await pipeline.Execute(
            Encoding.UTF8.GetBytes(ValidOrderJson), NewContext(), CancellationToken.None);

        // Assert
        Assert.IsType<StepResult<byte[]>.Success>(result);
        Assert.Contains("\"OrderId\":\"ORD-1001\"", edges.DestinationFiles.GetString("ORD-1001.json"));
        Assert.Single(edges.Idempotency.Committed);
    }

    [Fact]
    public async Task Execute_WithDuplicate_WritesNothingAndDoesNotCommit()
    {
        // Arrange: the idempotency service has already seen this order.
        var edges = new FakeEdges();
        edges.Idempotency.NextStatus = new StatusResponse(Action.Ignore, Reason.SameData);
        var provider = edges.CreateServices().BuildServiceProvider();
        var pipeline = FakeEdges.ResolveSendPipeline(provider);

        // Act
        var (result, _) = await pipeline.Execute(
            Encoding.UTF8.GetBytes(ValidOrderJson), NewContext(), CancellationToken.None);

        // Assert: the duplicate cancels as a traceable no-op — consumed, but
        // never written or committed again.
        Assert.IsType<StepResult<byte[]>.Cancelled>(result);
        Assert.Empty(edges.DestinationFiles.Files);
        Assert.Empty(edges.Idempotency.Committed);
    }

    [Fact]
    public async Task Execute_WithValidationFailure_RoutesIncidentAndConsumesWithoutCommit()
    {
        // Arrange: no lines — the Validator's "Order must contain at least one
        // line" branch. A business failure never retries the poison message,
        // and never commits idempotency (a corrected redelivery must not cancel
        // as seen-before).
        var edges = new FakeEdges();
        var provider = edges.CreateServices().BuildServiceProvider();
        var pipeline = FakeEdges.ResolveSendPipeline(provider);
        const string noLines =
            """{"orderId":"ORD-1001","customerId":"CUST-42","orderDate":"2026-01-15T09:30:00+00:00","lines":[]}""";

        // Act
        var (result, _) = await pipeline.Execute(
            Encoding.UTF8.GetBytes(noLines), NewContext(), CancellationToken.None);

        // Assert: the incident routed, which ends the pipeline as a success.
        Assert.IsType<StepResult<byte[]>.RoutedIncident>(result);
        Assert.Empty(edges.DestinationFiles.Files);
        Assert.Empty(edges.Idempotency.Committed);
        var incident = Assert.Single(edges.Incidents.Incidents);
        Assert.Equal("Order must contain at least one line", incident.Data.Description);
    }

    [Fact]
    public async Task Execute_WhenDestinationThrows_RoutesIncidentAndKeepsTheMessageForRedelivery()
    {
        // Arrange: the transactional SendStep is a BusinessStep, so a fault at
        // the destination adapter surfaces as a business failure with an
        // incident routed. The failure is retriable: an unreachable destination
        // says nothing about the data, so the message survives for redelivery.
        var edges = new FakeEdges();
        edges.DestinationFiles.WriteException = new InvalidOperationException("Destination unreachable");
        var provider = edges.CreateServices().BuildServiceProvider();
        var pipeline = FakeEdges.ResolveSendPipeline(provider);

        // Act
        var (result, _) = await pipeline.Execute(
            Encoding.UTF8.GetBytes(ValidOrderJson), NewContext(), CancellationToken.None);

        // Assert: an incident routed and the failure kept for redelivery;
        // nothing written or committed, so the redelivery runs the pipeline again.
        var failure = Assert.IsType<StepResult<byte[]>.BusinessFailure>(result);
        Assert.True(failure.Retriable);
        Assert.Empty(edges.DestinationFiles.Files);
        Assert.Empty(edges.Idempotency.Committed);
        Assert.Single(edges.Incidents.Incidents);
    }
{{- end }}

{{- if ne .source "sql" }}

    private static Context NewContext() => new(new Dictionary<string, string>());
{{- end }}
}
