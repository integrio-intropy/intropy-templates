using {{ .name }}.Configuration;
using Intropy.Framework.Hosting.Jobs;
using Intropy.Framework.Hosting.TransactionalIntegration;
using Intropy.Framework.Testing.Delivery;
using Microsoft.Extensions.DependencyInjection;

namespace {{ .name }}.Test.Integration;

/// <summary>
/// The receive side, run the way the host runs it: one execution of the
/// component's run-to-completion job over the real DI graph, with the source
/// adapter and the broker edge faked (see <see cref="FakeEdges"/>). The
/// framework sweeps the configured source port: every file is published, then
/// deleted; a file that could not be published stays for the next run. The
/// send side serves the Dapr gRPC app callback, bound here to a free port — the
/// enqueue fake captures instead of publishing, so nothing arrives on the
/// integration's queue and the run ends once the sweep is done.
/// </summary>
public class ReceiveSideIntegrationTests
{
    [Fact]
    public async Task Run_PublishesEverySourceFileAndDeletesIt()
    {
        // Arrange
        var edges = new FakeEdges();
        var job = CreateJob(edges);
        edges.SourceFiles.AddFile("order-1.json", "{}").AddFile("order-2.json", "{}");

        // Act
        var summary = await job.ExecuteAsync(CancellationToken.None);

        // Assert
        Assert.Equal(2, summary.Processed);
        Assert.Equal(["order-1.json", "order-2.json"], edges.Enqueue.Captured.Select(c => c.Item.Id).Order());
        Assert.Empty(edges.SourceFiles.Files);
    }

    [Fact]
    public async Task Run_WhenBrokerIsDown_KeepsTheFileForTheNextRun()
    {
        // Arrange: a dead broker surfaces as a technical failure of the publish.
        var edges = new FakeEdges();
        var job = CreateJob(edges);
        edges.SourceFiles.AddFile("order-1.json", "{}");
        edges.Enqueue.SendException = new InvalidOperationException("Broker unreachable");

        // Act
        var summary = await job.ExecuteAsync(CancellationToken.None);

        // Assert: counted as failed (the run exits 1) and left in the source.
        Assert.Equal(1, summary.Failed);
        Assert.True(edges.SourceFiles.Files.ContainsKey("order-1.json"));
    }

    private static IJob CreateJob(FakeEdges edges)
    {
        var provider = edges.CreateServices().BuildServiceProvider();

        // The send side serves the Dapr gRPC app callback that pushes the
        // integration's queue; a test binds a free port instead of APP_PORT's
        // default 8080.
        var options = provider.GetRequiredService<TransactionalIntegrationOptions>();
        options.CallbackPort = AppCallbackDelivery.AvailablePort();

        // Nothing arrives on the integration's queue: end the run once the sweep is done.
        options.IdleTimeout = TimeSpan.Zero;
        options.PostIdleGracePeriod = TimeSpan.Zero;

        return provider.GetRequiredService<IJob>();
    }
}
