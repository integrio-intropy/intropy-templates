using {{ .name }}.Configuration;
using Intropy.Framework.Adapters.File;
{{- if eq .source "sql" }}
using Intropy.Framework.Hosting.StatefulSweeps;
{{- end }}
using Intropy.Framework.Hosting.Jobs;
using Microsoft.Extensions.DependencyInjection;

namespace {{ .name }}.Test.Integration;

/// <summary>
/// Composition smoke test: the DI graph the system host will run must build
/// without a Dapr sidecar. Registrations are lazy — a missing registration
/// (framework upgrade, renamed builder) fails here, not at system-host time.
/// </summary>
public class CompositionTests
{
    [Fact]
    public void Composition_ResolvesJobRunner()
    {
        var provider = FakeEdges.UseInternalQueue(Composition.ConfigureServices(new ServiceCollection(), "Development"))
            .BuildServiceProvider();

        var runner = provider.GetRequiredService<JobRunner>();

        Assert.NotNull(runner);
    }

{{- if eq .source "sql" }}

    [Fact]
    public void Composition_ResolvesTheSqlSourceWithItsCursor_AndTheDestinationAdapter()
    {
        // The Development settings stand in for the system host's: a SQLite file
        // and the cursor store the topology mints for this component.
        var provider = FakeEdges.UseInternalQueue(Composition.ConfigureServices(new ServiceCollection(), "Development"))
            .BuildServiceProvider();

        var source = provider.GetRequiredKeyedService<IPolledSource>(Constants.SourcePort);
        var destination = provider.GetRequiredKeyedService<IFileAdapter>(Constants.DestinationPort);

        Assert.Equal("{{ .cursorStore }}", source.Cursor?.StoreName);
        Assert.NotNull(destination);
    }
}
{{- else }}

    [Fact]
    public void Composition_ResolvesBothFileAdaptersUnderTheirKeys()
    {
        var provider = FakeEdges.UseInternalQueue(Composition.ConfigureServices(new ServiceCollection(), "Development"))
            .BuildServiceProvider();

        var source = provider.GetRequiredKeyedService<IFileAdapter>(Constants.SourcePort);
        var destination = provider.GetRequiredKeyedService<IFileAdapter>(Constants.DestinationPort);

        Assert.NotNull(source);
        Assert.NotNull(destination);
    }
}
{{- end }}
