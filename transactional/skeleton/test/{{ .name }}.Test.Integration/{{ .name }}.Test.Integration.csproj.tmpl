<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- coverlet.collector: enables the "XPlat Code Coverage" collector used by `task coverage`. -->
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Intropy.Framework.Adapters" Version="1.0.0-beta.1" />
    <PackageReference Include="Intropy.Framework.Blocks" Version="1.0.0-beta.1" />
    <PackageReference Include="Intropy.Framework.Core" Version="1.0.0-beta.1" />
    <PackageReference Include="Intropy.Framework.Hosting" Version="1.0.0-beta.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <!-- NSubstitute appears exactly once in the suite: the DaprClient publish
         seam in EnqueuePublishTests (the one edge the testing library
         deliberately leaves to a mocking framework). -->
    <PackageReference Include="NSubstitute" Version="6.1.0" />
    <!-- Hand-rolled fakes (InMemoryFileAdapter, FakeEnqueueStep, service-client
         fakes, PublishedMessageCapture) for component-level integration tests,
         built against the same framework version as the packages above. -->
    <PackageReference Include="Intropy.Framework.Testing" Version="1.0.0-beta.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/{{ .name }}.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
