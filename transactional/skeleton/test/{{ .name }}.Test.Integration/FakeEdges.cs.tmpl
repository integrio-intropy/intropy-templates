using {{ .name }}.Configuration;
using Intropy.Framework.Adapters.File;
using Intropy.Framework.Blocks.Shared;
using Intropy.Framework.Blocks.TransactionalIntegration.Receive.Steps;
using Intropy.Framework.Core.Configuration;
using Intropy.Framework.Testing.Adapters;
using Intropy.Framework.Testing.Topics;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.DependencyInjection.Extensions;
{{- if not .empty }}
using Intropy.Contracts.BusinessIncidentService;
using Intropy.Contracts.IdempotencyService;
using Intropy.Framework.Testing.Services;
{{- end }}

namespace {{ .name }}.Test.Integration;

/// <summary>
/// The externals every integration test fakes, plus the DI wiring that swaps
/// them into the real <see cref="Composition.ConfigureServices"/> graph.
/// Centralised so the receive-side and send-pipeline suites cannot drift apart
/// when the set of externals changes.
/// </summary>
public sealed class FakeEdges
{
    /// <summary>The keyed source adapter (<see cref="Constants.SourcePort"/>).</summary>
    public InMemoryFileAdapter SourceFiles { get; } = new();

    /// <summary>The keyed destination adapter (<see cref="Constants.DestinationPort"/>).</summary>
    public InMemoryFileAdapter DestinationFiles { get; } = new();
{{- if not .empty }}

    public FakeIdempotencyServiceClient Idempotency { get; } = new();
    public FakeBusinessIncidentServiceClient Incidents { get; } = new();
{{- end }}

    /// <summary>
    /// The receive side's broker edge: registered in place of the framework's
    /// Dapr enqueuer, so each source file is captured instead of published.
    /// </summary>
    public FakeEnqueueStep<Context> Enqueue { get; } = new(new FrameworkOptions
    {
        ComponentName = Constants.ComponentName,
        ServiceNamespace = Constants.Organization
    });

    /// <summary>
    /// The production service collection with the externals swapped for the
    /// fakes. Adapter and client swaps remove the production registrations
    /// before adding the fakes, so the override never depends on registration
    /// order (last-wins) — a reordered <see cref="Composition.ConfigureServices"/>
    /// cannot silently shadow a fake.
    /// </summary>
    public IServiceCollection CreateServices()
    {
        var services = Composition.ConfigureServices(new ServiceCollection(), "Development");
        services.RemoveAll<EnqueueStep<Context>>();
        services.AddSingleton<EnqueueStep<Context>>(Enqueue);

        services.RemoveAllKeyed<IFileAdapter>(Constants.SourcePort);
        services.AddKeyedSingleton<IFileAdapter>(Constants.SourcePort, (_, _) => SourceFiles);
        services.RemoveAllKeyed<IFileAdapter>(Constants.DestinationPort);
        services.AddKeyedSingleton<IFileAdapter>(Constants.DestinationPort, (_, _) => DestinationFiles);
{{- if not .empty }}
        services.RemoveAll<IIdempotencyServiceClient>();
        services.AddSingleton<IIdempotencyServiceClient>(Idempotency);
        services.RemoveAll<IBusinessIncidentServiceClient>();
        services.AddSingleton<IBusinessIncidentServiceClient>(Incidents);
{{- end }}
        return services;
    }
}
