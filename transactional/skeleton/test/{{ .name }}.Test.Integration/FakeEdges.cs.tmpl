namespace {{ .name }}.Test.Integration;

/// <summary>
/// The externals every integration test fakes, plus the DI wiring that swaps
/// them into the real <see cref="Composition.ConfigureServices"/> graph{{ if eq .source "sql" }}:
/// the database (a SQLite file of the test's own, read with the component's own
/// query), the cursor store the watermark is kept in, the destination, the
/// internal queue and the two platform-service clients{{ end }}.
/// Centralised so the receive-side and send-pipeline suites cannot drift apart
/// when the set of externals changes.
/// </summary>
{{- if eq .source "sql" }}
public sealed class FakeEdges : IDisposable
{
    private const string CursorStoreName = "{{ .cursorStore }}";

    /// <summary>The SQLite file the source reads; <see cref="ExecuteAsync"/> writes to it.</summary>
    public string DatabasePath { get; } = Path.Combine(Path.GetTempPath(), $"{Constants.ComponentName}-{Guid.NewGuid():N}.db");

    /// <summary>The cursor store the source port's watermark is kept in.</summary>
    public InMemoryCursorStore Cursors { get; } = new();

    /// <summary>The key the sweep keeps the source port's watermark under.</summary>
    public static string CursorKey => $"{Constants.ComponentName}:{Constants.SourcePort}";
{{- else }}
public sealed class FakeEdges
{
    /// <summary>The keyed source adapter (<see cref="Constants.SourcePort"/>).</summary>
    public InMemoryFileAdapter SourceFiles { get; } = new();
{{- end }}

    /// <summary>The keyed destination adapter (<see cref="Constants.DestinationPort"/>).</summary>
    public InMemoryFileAdapter DestinationFiles { get; } = new();
{{- if .claimCheck }}

    /// <summary>The claim store: where a file too large for a queue message is kept.</summary>
    public InMemoryFileAdapter ClaimStore { get; } = new();
{{- end }}
{{- if or (not .empty) (eq .source "sql") }}

    public FakeIdempotencyServiceClient Idempotency { get; } = new();
    public FakeBusinessIncidentServiceClient Incidents { get; } = new();
{{- end }}

    /// <summary>
    /// The receive side's broker edge: registered in place of the framework's
    /// Dapr enqueuer, so each source file is captured instead of published.
    /// </summary>
    public FakeEnqueueStep<Context> Enqueue { get; } = new(new FrameworkOptions
    {
        ComponentName = Constants.ComponentName,
        ServiceNamespace = Constants.Organization
    });

    /// <summary>
    /// The production service collection with the externals swapped for the
    /// fakes. Adapter and client swaps remove the production registrations
    /// before adding the fakes, so the override never depends on registration
    /// order (last-wins) — a reordered <see cref="Composition.ConfigureServices"/>
    /// cannot silently shadow a fake.{{ if eq .source "sql" }} The source keeps the
    /// component's query and delta (<see cref="Composition.ConfigureSource"/>) and
    /// reads <see cref="DatabasePath"/> instead of the configured database.{{ end }}
    /// </summary>
    public IServiceCollection CreateServices()
    {
        var services = Composition.ConfigureServices(new ServiceCollection(), "Development");
        UseInternalQueue(services);
        services.RemoveAll<EnqueueStep<Context>>();
        services.AddSingleton<EnqueueStep<Context>>(Enqueue);
{{ if eq .source "sql" }}
        services.RemoveAllKeyed<IPolledSource>(Constants.SourcePort);
        services.AddSqlSource(Constants.SourcePort, new SqlSourceOptions
        {
            Kind = SqlSourceOptions.SqliteKind,
            ConnectionString = $"Data Source={DatabasePath}",
            CursorStore = CursorStoreName,
            InitialWatermark = "int:0"
        }, Composition.ConfigureSource);
        services.AddKeyedSingleton<ICursorStore>(CursorStoreName, Cursors);
{{- else }}
        services.RemoveAllKeyed<IFileAdapter>(Constants.SourcePort);
        services.AddKeyedSingleton<IFileAdapter>(Constants.SourcePort, (_, _) => SourceFiles);
{{- end }}
        services.RemoveAllKeyed<IFileAdapter>(Constants.DestinationPort);
        services.AddKeyedSingleton<IFileAdapter>(Constants.DestinationPort, (_, _) => DestinationFiles);
{{- if .claimCheck }}
        services.RemoveAllKeyed<IFileAdapter>(ClaimStoreServiceCollectionExtensions.ClaimStoreKey);
        services.AddKeyedSingleton<IFileAdapter>(ClaimStoreServiceCollectionExtensions.ClaimStoreKey,
            (_, _) => ClaimStore);
{{- end }}
{{- if or (not .empty) (eq .source "sql") }}
        services.RemoveAll<IIdempotencyServiceClient>();
        services.AddSingleton<IIdempotencyServiceClient>(Idempotency);
        services.RemoveAll<IBusinessIncidentServiceClient>();
        services.AddSingleton<IBusinessIncidentServiceClient>(Incidents);
{{- end }}
        return services;
    }

    /// <summary>
    /// Names the internal queue as the system host or the deployment would, through
    /// INTROPY_PUBSUB_NAME and INTROPY_TOPIC_NAME: the framework derives neither, so
    /// the graph does not build without them.
    /// </summary>
    public static IServiceCollection UseInternalQueue(IServiceCollection services) =>
        services.Configure<FrameworkOptions>(o =>
        {
            o.PubSubName = "test-system-pubsub";
            o.TopicName = $"internal-{Constants.ComponentName}";
        });

    /// <summary>
    /// Builds the source port's send pipeline exactly as the framework does for each of its
    /// messages: in a fresh scope, from <see cref="SendRoute.Configure"/>. The fakes are
    /// already in the DI graph via <see cref="CreateServices"/>, so there is nothing left to
    /// override.
    /// </summary>
    public static ISendPipeline<Context> ResolveSendPipeline(IServiceProvider provider)
    {
        var scope = provider.CreateScope().ServiceProvider;
        var builder = SendPipelineBuilder<In, Out, Context>.Create(
            $"{Constants.ComponentName}.Send.{Constants.SourcePort}",
            scope.GetRequiredService<FrameworkOptions>(), scope.GetRequiredService<ILoggerFactory>());
        return SendRoute.Configure(builder, scope).Build();
    }
{{- if eq .source "sql" }}

    /// <summary>Runs a statement against <see cref="DatabasePath"/>: the test's tables and rows.</summary>
    public async Task ExecuteAsync(string statement)
    {
        await using var connection = new SqliteConnection($"Data Source={DatabasePath}");
        await connection.OpenAsync();
        await using var command = connection.CreateCommand();
        command.CommandText = statement;
        await command.ExecuteNonQueryAsync();
    }

    public void Dispose()
    {
        // SQLite pools connections, which keep the file open.
        SqliteConnection.ClearAllPools();
        File.Delete(DatabasePath);
    }
{{- end }}
}
