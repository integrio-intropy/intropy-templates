<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Intropy.Framework.Adapters" Version="0.3.0-beta.4" />
    <PackageReference Include="Intropy.Framework.Blocks" Version="0.3.0-beta.4" />
    <PackageReference Include="Intropy.Framework.Core" Version="0.3.0-beta.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <!-- NSubstitute appears exactly once per step seam in the unit suite: the
         Receiver and Sender steps' IFileAdapter constructor seams
         (InMemoryFileAdapter belongs to the integration suite, which owns the
         framework's testing fakes). -->
    <PackageReference Include="NSubstitute" Version="6.1.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/{{ .name }}.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
