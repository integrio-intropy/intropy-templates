using Dapr.Client;
using {{ .name }}.Configuration;
{{- if not .empty }}
using Intropy.Contracts.BusinessIncidentService;
{{- end }}
using Intropy.Framework.Adapters.File;
using Intropy.Framework.Blocks.Shared;
using Intropy.Framework.Blocks.TransactionalIntegration;
using Intropy.Framework.Blocks.TransactionalIntegration.Receive.Steps;
using Intropy.Framework.Core.Configuration;
using Intropy.Framework.Hosting.TransactionalIntegration.Job;
using Microsoft.Extensions.DependencyInjection;

namespace {{ .name }}.Receive;

public static class ServiceCollectionExtensions
{
    /// <param name="enqueuerOverride">
    /// Optional factory for the enqueue step, resolved from the same provider as
    /// the production wiring. Production leaves this null; the integration suite
    /// substitutes <c>FakeEnqueueStep&lt;Context&gt;</c> here so the receive pipeline
    /// is still built by this exact builder chain — only the broker edge is faked.
    /// </param>
    public static IServiceCollection AddReceivePipeline(
        this IServiceCollection services,
        Func<IServiceProvider, EnqueueStep<Context>>? enqueuerOverride = null)
    {
        services.AddReceivePipeline<Context>("{{ .name }}.Receive", (builder, provider) =>
        {
            var sourceAdapter = provider.GetRequiredKeyedService<IFileAdapter>(Constants.SourceFileAdapterKey);
            var daprClient = provider.GetRequiredService<DaprClient>();
            var tiOptions = provider.GetRequiredService<TransactionalIntegrationOptions>();
            var frameworkOptions = provider.GetRequiredService<FrameworkOptions>();
            var enqueuer = enqueuerOverride?.Invoke(provider)
                ?? new Enqueuer(daprClient, tiOptions, frameworkOptions);
{{- if not .empty }}
            var incidentClient = provider.GetRequiredService<IBusinessIncidentServiceClient>();

            return builder
                .WithReceiver(new Receiver(sourceAdapter))
                .WithEnqueuer(enqueuer)
                .WithCompleter(new Completer(sourceAdapter))
                .WithBusinessIncidents(
                    incidentClient,
                    messageIdExtractor: ctx => ctx.Metadata.GetValueOrDefault(Constants.ContextKeyFileName, "unknown"),
                    subjectExtractor: ctx => ctx.Metadata.GetValueOrDefault(Constants.ContextKeyFileName, "unknown"));
{{- else }}

            return builder
                .WithReceiver(new Receiver(sourceAdapter))
                .WithEnqueuer(enqueuer)
                .WithCompleter(new Completer(sourceAdapter));
{{- end }}
        });
        return services;
    }
}
