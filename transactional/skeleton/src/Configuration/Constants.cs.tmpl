namespace {{ .name }}.Configuration;

public static class Constants
{
    public const string ComponentName = "{{ .name | kebabcase }}";
    public const string Organization = "{{ .organization }}";

    // The component-owned internal hop: receive publishes each source file
    // here for the send side to process. The names mirror what the topology
    // mints for this component (decision 0011): the pubsub component is
    // generated as internal-<component>, scoped to this component alone, so
    // two integrations under one host cannot cross wires and the hop stays
    // invisible to the system topology.
    public const string PubSubName = "internal-{{ .name | kebabcase | replace "." "-" }}";
    public const string TopicName = "hop";

    // The Dapr binding names the system host derives from the component's
    // From/To ports: binding.<port-name>.
    public const string InboundBindingName = "binding.{{ .fromPort }}";
    public const string OutboundBindingName = "binding.{{ .toPort }}";

    public const string SourceFileAdapterKey = "source";
    public const string DestinationFileAdapterKey = "destination";

    public const string ContextKeyFileName = "file_name";
    public const string ContextKeyOrderId = "order_id";
    public const string ContextKeyProcessedAt = "processed_at";
}
