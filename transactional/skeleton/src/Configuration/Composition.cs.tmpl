using Dapr.Client;
using Dapr.Messaging.PublishSubscribe.Extensions;
using {{ .name }}.Model;
using {{ .name }}.Send;
{{- if or (not .empty) (eq .source "sql") }}
using Intropy.BusinessIncidentService.Client;
{{- end }}
using Intropy.Framework.Adapters.File;
{{- if eq .source "sql" }}
using Intropy.Framework.Adapters.Sql;
{{- end }}
using Intropy.Framework.Blocks.Shared;
using Intropy.Framework.Core.Common;
using Intropy.Framework.Core.Configuration;
{{- if .claimCheck }}
using Intropy.Framework.Hosting.Common;
{{- end }}
{{- if eq .source "sql" }}
using Intropy.Framework.Hosting.StatefulSweeps;
{{- else }}
using Intropy.Framework.Hosting.FileSweeps;
{{- end }}
using Intropy.Framework.Hosting.TransactionalIntegration;
{{- if or (not .empty) (eq .source "sql") }}
using Intropy.IdempotencyService.Client;
{{- end }}
using Intropy.Telemetry;
using Intropy.Telemetry.ConsoleApp;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Logging;

namespace {{ .name }}.Configuration;

/// <summary>
/// The component's service registrations, shared by the entrypoint
/// (<c>Program.cs</c>) and the composition smoke test. Everything the runner
/// needs — telemetry, Dapr clients, {{ if eq .source "sql" }}the SQL source and the destination file adapter{{ else }}both file adapters{{ end }}, the receive and send
/// pipelines — is registered here so the test can prove the whole graph
/// builds without a sidecar.
/// </summary>
public static class Composition
{
    /// <summary>Registers every service the integration job needs.</summary>
    /// <param name="services">The service collection to register into.</param>
    /// <param name="environment">The environment whose appsettings overlay applies. Defaults to
    /// DOTNET_ENVIRONMENT, or Production; tests pass Development.</param>
    public static IServiceCollection ConfigureServices(IServiceCollection services, string? environment = null)
    {
        environment ??= Environment.GetEnvironmentVariable("DOTNET_ENVIRONMENT") ?? "Production";

        // Configuration: appsettings.json + environment overlay + env vars. Based on the
        // binary directory, not the CWD — a host (or `dapr run`) may launch the app from a
        // different working directory. Registered so options binding and tests resolve the
        // same instance.
        var configuration = new ConfigurationBuilder()
            .SetBasePath(AppContext.BaseDirectory)
            .AddJsonFile("appsettings.json", optional: true, reloadOnChange: false)
            .AddJsonFile($"appsettings.{environment}.json", optional: true, reloadOnChange: false)
            .AddEnvironmentVariables()
            .Build();
        services.AddSingleton<IConfiguration>(configuration);

        // Register host-level platform plumbing first: diagnostics, Dapr, framework
        // services, and shared platform clients. Keeping these together makes the
        // ordering-sensitive DaprClient registrations obvious.
        services.AddLogging(builder => builder.AddConsole());

        // The service name is the component name, so traces identify the component through
        // the resource's service.name. Strict mode exports only the framework's Intropy.* spans
        // and the component's own: the Dapr gRPC and HttpClient spans around them are dropped,
        // while trace context still propagates. Tracing:Mode in configuration overrides it.
        // Intropy.Telemetry subscribes to no meters: add the framework's.
        services.AddOpenTelemetry(conf =>
        {
            conf.ServiceNamespace = Constants.Organization;
            conf.ServiceName = Constants.ComponentName;
            conf.Environment = environment;
            conf.Mode = TracingMode.Strict;
            conf.ConfigureMetrics = metrics => metrics.AddMeter(IntropyTelemetry.Meters);
        });

        services.AddSingleton(_ => new DaprClientBuilder().Build());
        services.AddDaprPubSubClient();
{{- if or (not .empty) (eq .source "sql") }}
{{- if eq .source "sql" }}

        // The send side keys idempotency and business incidents off the range each read
        // covers, so a range read again after a failed run is cancelled as a duplicate.
{{- end }}

        // Registered after the DaprClient above on purpose: AddIdempotencyServiceClient
        // contributes its own DaprClient registration (camelCase JSON + string enums),
        // and the last registration wins for GetRequiredService<DaprClient>().
        services.AddIdempotencyServiceClient(c =>
        {
            // Dapr app id / HTTPEndpoint name; from appsettings.json, overridable per environment.
            c.AppId = configuration["PlatformServices:IdempotencyServiceAppId"]
                      ?? "idempotency-service.services";
        });
        services.AddBusinessIncidentServiceClient(c =>
        {
            c.AppId = configuration["PlatformServices:BusinessIncidentServiceAppId"]
                      ?? "business-incident-service.services";
        });
{{- end }}

        services.AddIntropyFramework(x =>
        {
            x.ComponentName = Constants.ComponentName;
            x.ServiceNamespace = Constants.Organization;
        });

{{- if eq .source "sql" }}

        // The SQL source behind the source port: the query, and the column whose highest
        // value becomes the next run's @watermark. Its settings come from Ports:<port>:
        // Kind (Sql for SQL Server, Sqlite for a local file), the connection string, the
        // initial watermark, and the cursor store the watermark is kept in, which the
        // system host sets to the store the topology mints for this component. With no
        // connection string, startup fails naming the port.
        services.AddSqlSource(Constants.SourcePort, configuration.GetSection(
            $"{PortServiceCollectionExtensions.PortsSectionName}:{Constants.SourcePort}"), ConfigureSource);

        // The destination's file adapter is registered under the port name, and the
        // Sender writes through it. It is chosen by configuration: Ports:<port>:Kind
        // selects the Dapr binding the port is deployed with (Local, Sftp or AzureBlob).
        // appsettings.Development.json selects Local, the local folder the system host
        // resolves the port to; a deployment sets Ports__<port>__Kind to match the binding
        // it renders. With no Kind, startup fails naming the port. A binding's address and
        // credentials live in the environment's Dapr component (GitOps values), resolved
        // out of the cluster's secret store.
        services.AddDestinationPort(Constants.DestinationPort, configuration);

        // Register the integration last, after every source, adapter and platform service
        // its pipelines resolve from DI has been added to the service collection.
        // The framework owns the receive side: the source port is polled, and each run
        // reads the rows after the watermark as one message, the rows as a JSON array,
        // and publishes it to the internal hop (carrying its context metadata — its port
        // and the read's range — and its trace). The watermark moves once the message is
        // on the queue; a run that fails reads the same range again. The routes say which
        // send pipeline each port's messages go through; the component supplies only those.
        // The queue is the one the topology mints for this component: the topic
        // internal-<app id> on the system's internal-queue pub/sub. The framework derives
        // neither name: it reads the pub/sub from INTROPY_PUBSUB_NAME and the topic from
        // INTROPY_TOPIC_NAME, which the host and the deployment set from the topology.
        services.AddTransactionalIntegration(
            new TransactionalIntegrationDefinition<Context>(),
            sources => sources.Port(new PolledSourcePort(Constants.SourcePort)),
            routes => routes.On<In, Out>([Constants.SourcePort], SendRoute.Configure));

        return services;
    }

    /// <summary>
    /// The SQL source's query and delta: the rows after the watermark, which moves to the
    /// highest <c>ChangeId</c> a run queued. Shared with the integration tests, which
    /// run it against a SQLite file of their own.
    /// </summary>
    public static void ConfigureSource(SqlSourceBuilder sql) => sql
        .Query(SqlFile.Embedded("Sql/Query.sql"))
        .Delta(Delta.Column("ChangeId"));
}
{{- else }}

        // Each port's file adapter is registered under the port name: the source the
        // framework sweeps, the destination the Sender writes through. Each is chosen by configuration:
        // Ports:<port>:Kind selects the Dapr binding the port is deployed with (Local, Sftp or AzureBlob).
        // appsettings.Development.json selects Local, the local folder the system host
        // resolves each port to; a deployment sets Ports__<port>__Kind to match the binding it
        // renders. With no Kind, startup fails naming the port. A binding's address and
        // credentials live in the environment's Dapr component (GitOps values), resolved out of
        // the cluster's secret store.
        services.AddFileAdapter(Constants.SourcePort, configuration.GetSection(
            $"{PortServiceCollectionExtensions.PortsSectionName}:{Constants.SourcePort}"));
        services.AddDestinationPort(Constants.DestinationPort, configuration);
{{- if .claimCheck }}

        // The claim store: a file larger than
        // TransactionalIntegration:ClaimCheckThresholdBytes is written there and only a
        // pointer to it is queued; the send side reads it back. ClaimStore:Kind and
        // ClaimStore:DaprBindingName name the store, as a port's settings do.
        // ClaimCheckMode Never stops new files from being claim-checked; keep the store
        // registered so messages already queued with a pointer can still be read.
        services.AddClaimStore(configuration);
{{- end }}

        // Register the integration last, after every adapter and platform service its
        // send pipeline resolves from DI has been added to the service collection.
        // The framework owns the receive side: it sweeps the sources, publishes each
        // file to the internal hop (carrying its context metadata, its port and its
        // trace), and deletes it once it is on the queue. A file that cannot be read or
        // published stays for the next run. The routes say which send pipeline each
        // port's messages go through; the component supplies only those.
        // The queue is the one the topology mints for this component: the topic
        // internal-<app id> on the system's internal-queue pub/sub. The topic is
        // unique per integration, so two integrations cannot receive each other's
        // files. The framework derives neither: it reads the pub/sub from
        // INTROPY_PUBSUB_NAME and the topic from INTROPY_TOPIC_NAME, which the
        // host and the deployment set from the topology.
        // A port carrying other data gets its own .Port(...) and .On(...) route, with a
        // send pipeline of its own.
        // The integration's options (the claim check mode and threshold among them) bind
        // from the TransactionalIntegration section.
        services.AddTransactionalIntegration(
            configuration.GetSection("TransactionalIntegration"),
            () => new TransactionalIntegrationDefinition<Context>(),
            sources => sources.Port(Constants.SourcePort),
            routes => routes.On<In, Out>([Constants.SourcePort], SendRoute.Configure));

        return services;
    }
}
{{- end }}
