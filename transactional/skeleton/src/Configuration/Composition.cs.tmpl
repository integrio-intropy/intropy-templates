using Dapr.Client;
using Dapr.Messaging.PublishSubscribe.Extensions;
using {{ .name }}.Receive;
using {{ .name }}.Send;
{{- if not .empty }}
using Intropy.BusinessIncidentService.Client;
{{- end }}
using Intropy.Framework.Adapters.File;
using Intropy.Framework.Blocks.Shared;
using Intropy.Framework.Blocks.TransactionalIntegration.Receive;
using Intropy.Framework.Blocks.TransactionalIntegration.Receive.Steps;
using Intropy.Framework.Core.Configuration;
using Intropy.Framework.Hosting.TransactionalIntegration.Job;
{{- if not .empty }}
using Intropy.IdempotencyService.Client;
{{- end }}
using Intropy.Telemetry.ConsoleApp;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Logging;

namespace {{ .name }}.Configuration;

/// <summary>
/// The component's service registrations, shared by the entrypoint
/// (<c>Program.cs</c>) and the composition smoke test. Everything the runner
/// needs — telemetry, Dapr clients, both file adapters, the receive and send
/// pipelines — is registered here so the test can prove the whole graph
/// builds without a sidecar.
/// </summary>
public static class Composition
{
    /// <summary>Registers every service the integration job needs.</summary>
    /// <param name="receiveEnqueuerOverride">
    /// Optional factory for the receive pipeline's enqueue step. Production
    /// leaves this null; the integration suite substitutes
    /// <c>FakeEnqueueStep&lt;Context&gt;</c> so the pipeline is still built by the
    /// exact production builder chain with only the broker interaction faked.
    /// Forwarded to <c>Receive.ServiceCollectionExtensions.AddReceivePipeline</c>.
    /// </param>
    public static IServiceCollection ConfigureServices(
        IServiceCollection services,
        Func<IServiceProvider, EnqueueStep<Context>>? receiveEnqueuerOverride = null)
    {
        var environment = Environment.GetEnvironmentVariable("DOTNET_ENVIRONMENT") ?? "Production";

        // Register host-level platform plumbing first: diagnostics, Dapr, framework
        // services, and shared platform clients. Keeping these together makes the
        // ordering-sensitive DaprClient registrations obvious.
        services.AddLogging(builder => builder.AddConsole());

        services.AddOpenTelemetry(conf =>
        {
            conf.ServiceNamespace = Constants.Organization;
            conf.ServiceName = Constants.ComponentName;
            conf.Environment = environment;
        });

        services.AddSingleton(_ => new DaprClientBuilder().Build());
        services.AddDaprPubSubClient();
{{- if not .empty }}

        // Registered after the DaprClient above on purpose: AddIdempotencyServiceClient
        // contributes its own DaprClient registration (camelCase JSON + string enums),
        // and the last registration wins for GetRequiredService<DaprClient>().
        services.AddIdempotencyServiceClient();      // Dapr app id / HTTPEndpoint name: idempotency-service
        services.AddBusinessIncidentServiceClient(); // Dapr app id / HTTPEndpoint name: business-incident-service
{{- end }}

        services.AddIntropyFramework(x =>
        {
            x.ComponentName = Constants.ComponentName;
            x.ServiceNamespace = Constants.Organization;
        });

        services.AddTransactionalIntegration(options =>
        {
            options.DaprPubSubName = Constants.PubSubName;
            options.DaprTopicName = Constants.TopicName;
        });

        // Bind each adapter implementation to the component's stable port names.
        // Deployment swaps the Dapr binding behind a port name; these keyed
        // registrations are where code chooses the adapter classes that can speak them.
        //
        // The port names never change between environments — deployment
        // swaps each binding's type behind "binding.<port>", so rebinding a
        // port is a configuration act, not a build. Today the adapter class
        // must still match the deployed binding type (each binding speaks
        // its own Dapr operation metadata), so a different adapter is a
        // same-name class switch, e.g. when the production environment
        // resolves the source port to an SFTP binding:
        //
        // environment == "Development"
        //     ? (IFileAdapter)new LocalFileAdapter(dapr, new FileAdapterOptions(Constants.InboundBindingName))
        //     : new SftpAdapter(dapr, new FileAdapterOptions(Constants.InboundBindingName));
        //
        // A binding's address and credentials live in the environment's Dapr
        // component (GitOps values), resolved out of the cluster's secret
        // store — never hard-code them here.
        services.AddKeyedSingleton<IFileAdapter>(Constants.SourceFileAdapterKey, (sp, _) =>
            new LocalFileAdapter(
                sp.GetRequiredService<DaprClient>(),
                new FileAdapterOptions(Constants.InboundBindingName)));

        services.AddKeyedSingleton<IFileAdapter>(Constants.DestinationFileAdapterKey, (sp, _) =>
            new LocalFileAdapter(
                sp.GetRequiredService<DaprClient>(),
                new FileAdapterOptions(Constants.OutboundBindingName)));

        services.AddSingleton<ISourceLister, SourceLister>();

        // Register the pipelines last, after every adapter and platform service
        // they resolve from DI has been added to the service collection.
        services.AddReceivePipeline(receiveEnqueuerOverride);
        services.AddSendPipeline();

        return services;
    }
}
