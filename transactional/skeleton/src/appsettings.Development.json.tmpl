{
  "Ports": {
{{- if eq .source "sql" }}
    "{{ .fromPort }}": {
      "Kind": "Sqlite",
      "ConnectionString": "Data Source={{ .appId }}.db",
      "CursorStore": "{{ .cursorStore }}"
    },
{{- else }}
    "{{ .fromPort }}": { "Kind": "Local" },
{{- end }}
    "{{ .toPort }}": { "Kind": "Local" }
  }
}
