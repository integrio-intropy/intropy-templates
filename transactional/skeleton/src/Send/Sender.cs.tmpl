using {{ .name }}.Configuration;
using Intropy.Framework.Adapters.File;
using Intropy.Framework.Blocks.Shared;
using Intropy.Framework.Blocks.TransactionalIntegration.Send.Steps;
using Intropy.Framework.Core.Pipeline.Abstractions.Results;

namespace {{ .name }}.Send;

public class Sender(IFileAdapter fileAdapter) : SendStep<Context>
{
    public override {{ if not .empty }}async {{ end }}Task<(BusinessStepResult<byte[]> Result, Context Context)> ExecuteAsync(
        byte[] input, Context context, CancellationToken ct)
    {
{{- if .empty }}
        throw new NotImplementedException();
{{- else }}
        var orderId = context.Metadata[Constants.ContextKeyOrderId];
        // The serialized bytes, written as they are.
        await fileAdapter.WriteAsync($"{orderId}.json", input, ct: ct);
        return (new BusinessStepResult<byte[]>.Success(input), context);
{{- end }}
    }
}
