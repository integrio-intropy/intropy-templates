<Project Sdk="Microsoft.NET.Sdk">

    <Sdk Name="Aspire.AppHost.Sdk" Version="13.6.3" />

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>{{ .projectName }}.SystemHost</RootNamespace>
        <IsAspireHost>true</IsAspireHost>
        <IsPackable>false</IsPackable>
        <UserSecretsId>{{ .name }}-systemhost</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <!-- Intropy.Topology pinned to a local build with the job kind
             (AddJob), served from the intropy-local NuGet feed. Replace with
             the published release before this template ships. Aspire matches
             the version that build depends on. -->
        <PackageReference Include="Aspire.Hosting.AppHost" Version="13.6.3" />
        <PackageReference Include="Intropy.Topology.Aspire" Version="2.1.0-job-local.1" />
        <PackageReference Include="Intropy.Topology.Generation" Version="2.1.0-job-local.1" />
    </ItemGroup>

{{- if hasKey . "sharedContracts" }}
    <ItemGroup>
        <!-- Shared contracts project (the workspace's shared-library scaffold).
             IsAspireProjectResource="false" keeps the Aspire AppHost from
             treating the class library as an orchestrated resource. -->
        <ProjectReference Include="{{ .sharedContracts.include }}" IsAspireProjectResource="false" />
    </ItemGroup>
{{- end }}

</Project>
