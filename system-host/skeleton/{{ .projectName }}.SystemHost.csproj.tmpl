<Project Sdk="Microsoft.NET.Sdk">

    <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.3" />

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>{{ .projectName }}.SystemHost</RootNamespace>
        <IsAspireHost>true</IsAspireHost>
        <IsPackable>false</IsPackable>
        <UserSecretsId>{{ .name }}-systemhost</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <!-- Intropy.Topology pinned to the pilot package set: message-first
             (MessageRef<T>) with the topology-owned runtime identity the
             framework runner reads. A template release and its pin are one
             atomic unit; bumping the pin is a template change first. -->
        <PackageReference Include="Aspire.Hosting.AppHost" Version="13.5.3" />
        <PackageReference Include="Intropy.Topology.Aspire" Version="[0.0.1-pilot.260924112600]" />
        <PackageReference Include="Intropy.Topology.Generation" Version="[0.0.1-pilot.260924112600]" />
    </ItemGroup>

{{- if hasKey . "sharedContracts" }}
    <ItemGroup>
        <!-- Shared contracts project (the workspace's shared-library scaffold).
             IsAspireProjectResource="false" keeps the Aspire AppHost from
             treating the class library as an orchestrated resource. -->
        <ProjectReference Include="{{ .sharedContracts.include }}" IsAspireProjectResource="false" />
    </ItemGroup>
{{- end }}

</Project>
