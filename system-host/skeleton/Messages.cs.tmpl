{{- /* The system's messages, one MessageRef<T> each, rendered from the
payload's `messages` section — the message-first view of the workspace
(internal publications only; the CLI excludes registry-resolved, external
ones, whose definition the registry serves). The payload's message entries
carry identity and contract but no channel (C4 shape: {name, type,
contract?, dataschema?, publisher?}), so the channel resolves here by join:
the `topics` entries named after the message. That join is exact: assembly
gives an internal publication the message-named topic on the system pubsub.

No fallback exists: an older payload that carries topics but no messages
breaks loudly with a re-scaffold instruction — old workspaces migrate by
re-scaffolding, not by this template guessing a message view from topics.
*/ -}}
using Intropy.Topology;
{{- if hasKey . "sharedContracts" }}
using {{ .sharedContracts.name }};
{{- end }}

/// <summary>The system's messages, each defined once and shared by every component that touches it.</summary>
public static class Messages
{
{{- $seen := dict -}}
{{- $pubsubOf := dict -}}
{{- range $t := .topics }}
{{- if hasKey $pubsubOf $t.name }}
{{- if ne (index $pubsubOf $t.name) $t.pubsub }}
{{- fail (printf "topic %q exists on two pubsub components (%q and %q) — the message named after it cannot resolve one channel; rename one topic in the components' scaffold records" $t.name (index $pubsubOf $t.name) $t.pubsub) }}
{{- end }}
{{- else }}
{{- $_ := set $pubsubOf $t.name $t.pubsub }}
{{- end }}
{{- end }}
{{- range $i, $m := .messages }}
{{- $field := regexReplaceAll "[-._]" $m.name " " | title | replace " " "" }}
{{- if hasKey $seen $field }}
{{- fail (printf "messages %q and %q both derive the Messages.cs field %s — rename one message in the components' scaffold records" (index $seen $field) $m.name $field) }}
{{- end }}
{{- $_ := set $seen $field $m.name }}
{{- if not (hasKey $m "contract") }}
{{- fail (printf "message %q carries no contract in the system payload — MessageRef needs the shared .NET type (the record's publishes block must name the contract type)" $m.name) }}
{{- end }}
{{- /* The channel join, evaluated per message: the payload gives no
   channel fields, so the pubsub comes from the topics list by name. No
   matching topic means the producer's record was assembled before the
   topic — assembly always records both, so this names a broken payload
   rather than a convention; the system pubsub is the convention only for
   topic-less producers, where assembly itself already defaulted. */ -}}
{{- if not (hasKey $pubsubOf $m.name) }}
{{- fail (printf "message %q has no topic in the system payload to resolve its pubsub component from" $m.name) }}
{{- end }}
{{- $pubsub := index $pubsubOf $m.name }}
{{- if $i }}
{{ end }}
    /// <summary>{{ $m.contract }} messages (pubsub '{{ $pubsub }}'); the topic name defaults to the message name.</summary>
    public static readonly MessageRef<{{ $m.contract }}> {{ $field }} = MessageRef<{{ $m.contract }}>.Define("{{ $m.name }}", "{{ $pubsub }}");
{{- end }}
}
