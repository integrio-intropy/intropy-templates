{{- /* The system's messages, one MessageRef<T> each. The primary input is
the payload's `messages` section (internal publications only — the CLI
excludes registry-resolved, external ones, whose definition the registry
serves). The payload's message entries carry identity and contract but no
channel (C4 shape: {name, type, contract?, dataschema?, publisher?}), so
the channel resolves here by join: the `topics` entries named after the
message. That join is exact for every shape assembly produces — an internal
publication's topic defaults to the message name, and a legacy flat record's
message name is the topic name — so convergence holds:

  - messages non-empty               → declare from messages
  - messages absent/empty, topics set → legacy fallback: one message per
                                       topic (message name = topic name —
                                       the only identity the flat
                                       vocabulary had). The pinned topology
                                       has no TopicRef, so this is not the
                                       old Topics.cs — it is the same
                                       message-first declaration the old
                                       records' message view implies.
  - both empty                       → no file at all (transactional-only
                                       systems stay topic-free).

Legacy fallback note: a topics-only payload whose topic carries no contract
gets a loud failure, not a declaration — this template cannot invent a type.
*/ -}}
using Intropy.Topology;
{{- if hasKey . "sharedContracts" }}
using {{ .sharedContracts.name }};
{{- end }}

/// <summary>The system's messages, each defined once and shared by every component that touches it.</summary>
public static class Messages
{
{{- $seen := dict -}}
{{- $pubsubOf := dict -}}
{{- range $t := .topics }}
{{- if hasKey $pubsubOf $t.name }}
{{- if ne (index $pubsubOf $t.name) $t.pubsub }}
{{- fail (printf "topic %q exists on two pubsub components (%q and %q) — the message named after it cannot resolve one channel; rename one topic in the components' scaffold records" $t.name (index $pubsubOf $t.name) $t.pubsub) }}
{{- end }}
{{- else }}
{{- $_ := set $pubsubOf $t.name $t.pubsub }}
{{- end }}
{{- end }}
{{- if and (hasKey . "messages") (gt (len .messages) 0) }}
{{- range $i, $m := .messages }}
{{- $field := regexReplaceAll "[-._]" $m.name " " | title | replace " " "" }}
{{- if hasKey $seen $field }}
{{- fail (printf "messages %q and %q both derive the Messages.cs field %s — rename one message in the components' scaffold records" (index $seen $field) $m.name $field) }}
{{- end }}
{{- $_ := set $seen $field $m.name }}
{{- if not (hasKey $m "contract") }}
{{- fail (printf "message %q carries no contract in the system payload — MessageRef needs the shared .NET type (the record's publishes block must name the contract type)" $m.name) }}
{{- end }}
{{- /* The channel join, evaluated per message: the payload gives no
   channel fields, so the pubsub comes from the topics list by name. No
   matching topic means the producer's record was assembled before the
   topic — assembly always records both, so this names a broken payload
   rather than a convention; the system pubsub is the convention only for
   topic-less producers, where assembly itself already defaulted. */ -}}
{{- if not (hasKey $pubsubOf $m.name) }}
{{- fail (printf "message %q has no topic in the system payload to resolve its pubsub component from" $m.name) }}
{{- end }}
{{- $pubsub := index $pubsubOf $m.name }}
{{- if $i }}
{{ end }}
    /// <summary>{{ $m.contract }} messages (pubsub '{{ $pubsub }}'); the topic name defaults to the message name.</summary>
    public static readonly MessageRef<{{ $m.contract }}> {{ $field }} = MessageRef<{{ $m.contract }}>.Define("{{ $m.name }}", "{{ $pubsub }}");
{{- end }}
{{- else }}
{{- range $i, $t := .topics }}
{{- $field := regexReplaceAll "[-._]" $t.name " " | title | replace " " "" }}
{{- if hasKey $seen $field }}
{{- fail (printf "topics %q and %q both derive the Messages.cs field %s — rename one topic in the components' scaffold records" (index $seen $field) $t.name $field) }}
{{- end }}
{{- $_ := set $seen $field $t.name }}
{{- if not (hasKey $t "contract") }}
{{- fail (printf "topic %q carries no contract in the system payload — re-scaffold its integration with a template release that records the contract type, or add \"contract\": \"<TypeName>\" to the record's values" $t.name) }}
{{- end }}
{{- if $i }}
{{ end }}
    /// <summary>{{ $t.contract }} messages (pubsub '{{ $t.pubsub }}'); the topic name defaults to the message name.</summary>
    public static readonly MessageRef<{{ $t.contract }}> {{ $field }} = MessageRef<{{ $t.contract }}>.Define("{{ $t.name }}", "{{ $t.pubsub }}");
{{- end }}
{{- end }}
}
