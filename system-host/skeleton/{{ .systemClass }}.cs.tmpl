{{- /* Join each component's wiring names to the fields Messages.cs and
Ports.cs declare, keyed by the raw names so the derivation matches the
declaration templates exactly. The message field is keyed by message name;
the `messages` payload section is the only source. Each kind owns its own
wiring checks, so an unknown kind reports the kind, not a message deficit. */ -}}
{{- $msgField := dict -}}
{{- if hasKey . "messages" }}
{{- range $m := .messages }}
{{- $_ := set $msgField $m.name (regexReplaceAll "[-._]" $m.name " " | title | replace " " "") }}
{{- end }}
{{- end }}
{{- $portField := dict -}}
{{- range $c := .ports -}}
{{- $_ := set $portField $c.name (regexReplaceAll "[-._]" $c.name " " | title | replace " " "") -}}
{{- end -}}
using Intropy.Topology;

/// <summary>The {{ .name }} system: what exists, and what connects it.</summary>
public sealed class {{ .systemClass }} : ISystemDefinition
{
    public string SystemName => "{{ .name }}";

    public void Define(SystemBuilder builder)
    {
{{- range .components }}
{{- if eq .kind "extractor" }}
{{- if not (hasKey . "publishes") }}{{- fail (printf "component %q declares no publishes message" .appId) }}{{- end }}
{{- if not (hasKey $msgField .publishes) }}{{- fail (printf "component %q wires message %q, but the system payload carries no contract for it" .appId .publishes) }}{{- end }}
        builder.AddExtractor("{{ .appId }}")
{{- if hasKey . "port" }}
            .From(Ports.{{ index $portField .port }})
{{- end }}
            .Publishes(Messages.{{ index $msgField .publishes }})
            .Calls(Services.Idempotency)
            .Calls(Services.BusinessIncidents);
{{- else if eq .kind "loader" }}
{{- if hasKey . "routes" }}
{{- $loader := . }}
{{- range .routes }}
{{- if not (hasKey $msgField .message) }}{{- fail (printf "component %q routes message %q, but the system payload carries no contract for it" $loader.appId .message) }}{{- end }}
{{- end }}
        // Rendered as a declarative Dapr Subscription: one routing rule per route, in order,
        // and a default route for the rest of the topic. The subscription's first message
        // anchors it; the rest are also handled on the same channel.
        builder.AddLoader("{{ .appId }}")
{{- $first := index .routes 0 }}
            .Subscribes(Messages.{{ index $msgField $first.message }}
{{- if get $first "when" }},
                when: "{{ get $first "when" | replace "\\" "\\\\" | replace "\"" "\\\"" }}"
{{- end }}
{{- if or (gt (len .routes) 1) (eq .default "ignore") }},
                configure: sub => sub
{{- range $i, $r := .routes }}{{- if $i }}
{{- if get $r "when" }}
                    .AlsoHandles(Messages.{{ index $msgField $r.message }}, when: "{{ get $r "when" | replace "\\" "\\\\" | replace "\"" "\\\"" }}")
{{- else }}
                    .AlsoHandles(Messages.{{ index $msgField $r.message }})
{{- end }}
{{- end }}{{- end }}
{{- if eq .default "ignore" }}
                    .IgnoreOthers())
{{- else }})
{{- end }}
{{- else }})
{{- end }}
{{- else }}
{{- if not (hasKey . "subscribes") }}{{- fail (printf "component %q declares no subscribes message" .appId) }}{{- end }}
{{- if not (hasKey $msgField .subscribes) }}{{- fail (printf "component %q wires message %q, but the system payload carries no contract for it" .appId .subscribes) }}{{- end }}
        builder.AddLoader("{{ .appId }}")
            .Subscribes(Messages.{{ index $msgField .subscribes }})
{{- end }}
{{- if hasKey . "port" }}
            .To(Ports.{{ index $portField .port }})
{{- end }}
            .Calls(Services.Idempotency)
            .Calls(Services.BusinessIncidents);
{{- else if eq .kind "transactional-integration" }}
        builder.AddTransactionalIntegration("{{ .appId }}")
            .From(Ports.{{ index $portField .fromPort }})
            .To(Ports.{{ index $portField .toPort }})
            .Calls(Services.Idempotency)
            .Calls(Services.BusinessIncidents);
{{- else }}
{{- fail (printf "component %q has kind %q — the host declares extractor, loader, and transactional-integration components; add a branch for new kinds when their blocks exist" .appId .kind) }}
{{- end }}
{{- end }}
    }
}
