{{- /* Join each component's wiring names to the fields Messages.cs and
Ports.cs declare, keyed by the raw names so the derivation matches the
declaration templates exactly. The message field is keyed by message name;
a component entry without `message` (a legacy payload from an older CLI)
joins through its topic, whose name was the message name back then. A
message with no Messages.cs field means the payload gave no contract for it
— registry-resolved (external) publications arrive without one, and this
template cannot invent a type; that failure is the drift signal the CLI's
payload contract must answer. */ -}}
{{- $msgField := dict -}}
{{- if and (hasKey . "messages") (gt (len .messages) 0) }}
{{- range $m := .messages }}
{{- $_ := set $msgField $m.name (regexReplaceAll "[-._]" $m.name " " | title | replace " " "") }}
{{- end }}
{{- else }}
{{- range $t := .topics }}
{{- $_ := set $msgField $t.name (regexReplaceAll "[-._]" $t.name " " | title | replace " " "") }}
{{- end }}
{{- end }}
{{- $portField := dict -}}
{{- range $c := .ports -}}
{{- $_ := set $portField $c.name (regexReplaceAll "[-._]" $c.name " " | title | replace " " "") -}}
{{- end -}}
using Intropy.Topology;

/// <summary>The {{ .name }} system: what exists, and what connects it.</summary>
public sealed class {{ .systemClass }} : ISystemDefinition
{
    public string SystemName => "{{ .name }}";

    public void Define(SystemBuilder builder)
    {
{{- range .components }}
{{- $mname := "" -}}
{{- if ne .kind "transactional-integration" }}
{{- /* The message a block publishes or subscribes, by name (message
   first; topic name for legacy entries without the key). Declared in the
   range body: if-blocks close template scope, and the branches below need
   the name. */ -}}
{{- if hasKey . "message" -}}
{{- $mname = .message -}}
{{- else if hasKey . "topic" -}}
{{- $mname = .topic.name -}}
{{- end -}}
{{- if not (hasKey $msgField $mname) }}
{{- fail (printf "component %q wires message %q, but the system payload carries no contract for it — registry-resolved (external) publications reach the payload without a contract type, and this template cannot invent one; declare the message by hand in Messages.cs or land the contract in the payload" .appId $mname) }}
{{- end }}
{{- end }}
{{- if eq .kind "extractor" }}
        builder.AddExtractor("{{ .appId }}")
{{- if hasKey . "port" }}
            .From(Ports.{{ index $portField .port }})
{{- end }}
            .Publishes(Messages.{{ index $msgField $mname }})
            .Uses(Services.Idempotency)
            .Uses(Services.BusinessIncidents);
{{- else if eq .kind "transactional-integration" }}
        builder.AddTransactionalIntegration("{{ .appId }}")
            .From(Ports.{{ index $portField .fromPort }})
            .To(Ports.{{ index $portField .toPort }})
            .Uses(Services.Idempotency)
            .Uses(Services.BusinessIncidents);
{{- else if eq .kind "loader" }}
        builder.AddLoader("{{ .appId }}")
            .Subscribes(Messages.{{ index $msgField $mname }})
{{- if hasKey . "port" }}
            .To(Ports.{{ index $portField .port }})
{{- end }}
            .Uses(Services.Idempotency)
            .Uses(Services.BusinessIncidents);
{{- else }}
{{- fail (printf "component %q has kind %q — the host declares extractor, loader, and transactional-integration components; add a branch for new kinds when their blocks exist" .appId .kind) }}
{{- end }}
{{- end }}
    }
}
