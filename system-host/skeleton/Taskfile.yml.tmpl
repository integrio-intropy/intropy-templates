{{- /* `task seed` drops the sample orders into a folder a run-to-completion
component sweeps at host start: an extractor's source port, or a transactional
integration's From port, when that port is a binding. An external port (a
database, an HTTP API) has no folder, and a destination folder is never swept,
so a system without a folder reader gets no seed task. A system without
components keeps it with a placeholder default; PORT_DIR is required there.
The default is the first folder-reading extractor's port, else the first
folder-reading transactional integration's From port; other folders stay
reachable via PORT_DIR. README.md and AGENTS.md state this rule in prose; keep
them in step. */ -}}
{{- $external := dict -}}
{{- range .ports -}}
{{- if eq (get . "kind") "external" -}}
{{- $_ := set $external .name true -}}
{{- end -}}
{{- end -}}
{{- $seedPort := "" -}}
{{- $fromPort := "" -}}
{{- range .components -}}
{{- if and (eq .kind "extractor") (hasKey . "port") (eq $seedPort "") -}}
{{- if not (hasKey $external .port) -}}{{- $seedPort = .port -}}{{- end -}}
{{- end -}}
{{- if and (eq .kind "transactional-integration") (hasKey . "fromPort") (eq $fromPort "") -}}
{{- if not (hasKey $external .fromPort) -}}{{- $fromPort = .fromPort -}}{{- end -}}
{{- end -}}
{{- end -}}
{{- $seedPort = $seedPort | default $fromPort -}}
{{- $seed := or (ne $seedPort "") (eq (len .components) 0) -}}
{{- if eq $seedPort "" }}{{ $seedPort = "<port>" }}{{ end -}}
{{- /* The publish defaults follow the system's first topic and the first
component on it that stays resident — a loader, whose sidecar is still up
while the host runs; a run-to-completion extractor's sidecar may already be
gone. Without a loader, any component on the topic will do. A topic-free
system gets placeholders; TOPIC and PUBLISH_APP_ID are required there. */ -}}
{{- $publishTopic := "<topic>" -}}
{{- if gt (len .topics) 0 -}}
{{- $publishTopic = (index .topics 0).name -}}
{{- end -}}
{{- $publishAppId := "<app-id>" -}}
{{- range .components -}}
{{- if and (eq $publishAppId "<app-id>") (eq .kind "loader") (hasKey . "topic") -}}
{{- if eq .topic.name $publishTopic -}}
{{- $publishAppId = .appId -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- range .components -}}
{{- if and (eq $publishAppId "<app-id>") (hasKey . "topic") -}}
{{- if eq .topic.name $publishTopic -}}
{{- $publishAppId = .appId -}}
{{- end -}}
{{- end -}}
{{- end -}}
version: "3"

# Local-dev tasks for the {{ .name }} SystemHost — the Aspire host that holds the
# system's topology as a typed declaration. `task run` starts the whole system
# (Aspire dashboard, Redis-backed pub/sub, one Dapr sidecar per component); the
# other tasks inspect and export the same model without starting anything.

tasks:
  # ── Build ─────────────────────────────────────────────────────────
  build:
    desc: Build the SystemHost
    dir: "{{ "{{" }}.TASKFILE_DIR}}"
    cmds:
      # MSBuild writes everything to stdout, but check/graph/generate depend on
      # this task and their stdout is meant for piping (e.g. `task graph | jq`)
      # — redirect the build output to stderr so it never pollutes their JSON.
      - dotnet build --nologo >&2

  # ── Run backend ───────────────────────────────────────────────────
  run:
    desc: Run the system under the Aspire dashboard; stop with Ctrl+C
    dir: "{{ "{{" }}.TASKFILE_DIR}}"
    cmds:
      - dotnet run

  # ── Trigger a run ─────────────────────────────────────────────────
{{- if $seed }}
  seed:
    desc: Drop both sample orders into a port folder (run-to-completion components sweep them at host start)
    dir: "{{ "{{" }}.TASKFILE_DIR}}"
    vars:
      # Folder the port resolves to — must match the Files(...).RootPath(...)
      # resolution in the development definition (conventionally test/<port-name>).
      PORT_DIR: '{{ "{{" }}.PORT_DIR | default "./test/{{ $seedPort }}"}}'
    cmds:
      - mkdir -p {{ "{{" }}.PORT_DIR}}
      - cp ./sample-data/sample-order-status-0.json ./sample-data/sample-order-status-1.json {{ "{{" }}.PORT_DIR}}/
      - echo "Seeded {{ "{{" }}.PORT_DIR}} with sample-order-status-0.json and sample-order-status-1.json"
{{- end }}

  publish:
    desc: Publish the sample order to a topic via a component's sidecar (needs the host running)
    dir: "{{ "{{" }}.TASKFILE_DIR}}"
    vars:
      # The app-id of any running component whose sidecar should publish —
      # the dapr CLI resolves the sidecar from the app-id.
      PUBLISH_APP_ID: '{{ "{{" }}.PUBLISH_APP_ID | default "{{ $publishAppId }}"}}'
      PUBSUB: '{{ "{{" }}.PUBSUB | default "{{ .pubsub }}"}}'
      TOPIC: '{{ "{{" }}.TOPIC | default "{{ $publishTopic }}"}}'
    cmds:
      - >-
        dapr publish
        --publish-app-id {{ "{{" }}.PUBLISH_APP_ID}}
        --pubsub {{ "{{" }}.PUBSUB}}
        --topic {{ "{{" }}.TOPIC}}
        --data-file ./sample-data/sample-order-status-0.json

  # ── Generation backend ────────────────────────────────────────────
  # The generation backend is a plain CLI — `--no-launch-profile` keeps the Aspire
  # dashboard environment from launchSettings.json out of it, and `--no-build`
  # reuses the `build` dependency's output instead of rebuilding.
  check:
    desc: Build and validate the topology without starting anything
    dir: "{{ "{{" }}.TASKFILE_DIR}}"
    deps: [build]
    cmds:
      - dotnet run --no-build --no-launch-profile -- check

  graph:
    desc: Print the SystemTopology JSON
    dir: "{{ "{{" }}.TASKFILE_DIR}}"
    deps: [build]
    cmds:
      - dotnet run --no-build --no-launch-profile -- graph

  generate:
    desc: Write Dapr YAML + per-component runtime config to ./out
    dir: "{{ "{{" }}.TASKFILE_DIR}}"
    deps: [build]
    cmds:
      - dotnet run --no-build --no-launch-profile -- generate ./out
