apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

# The file name follows the broker: only the matching pubsub-*.yaml is rendered
# at all, and only when the topology gives the system a pub/sub of its own (an
# entry with a role), which is the one condition the line below carries.
#
# Binding references follow the same rule per adapter: spec.files renders an
# adapter file only when a port selects it, so this list collects the
# kinds the topology's ports selected — deduplicated, since several
# ports may share one adapter — and must stay empty when no port
# selected any binding (a reference to an unrendered file breaks the build).
{{- $kinds := dict -}}
{{- range .topology.ports }}
{{- if .binding }}{{- $_ := set $kinds .binding true -}}{{- end }}
{{- end }}
{{- $owned := false -}}
{{- range .topology.pubsubs }}
{{- if dig "role" "" . }}{{- $owned = true -}}{{- end }}
{{- end }}
{{- $resources := list -}}
{{- if $owned }}{{- $resources = append $resources (printf "dapr/pubsub-%s.yaml" .pubsub) -}}{{- end }}
{{- if ne .env "local" }}
{{- range list "sftp" "http" "file" "blob" }}
{{- if hasKey $kinds . }}{{- $resources = append $resources (printf "bindings/%s.yaml" .) -}}{{- end }}
{{- end }}
{{- end }}
{{- /* A system that owns no pub/sub and selects no binding still needs a
       buildable kustomization: an empty resources key is "empty" to kustomize. */}}
{{- if $resources }}
resources:
{{- range $resources }}
  - {{ . }}
{{- end }}
{{- else }}
resources: []
{{- end }}
