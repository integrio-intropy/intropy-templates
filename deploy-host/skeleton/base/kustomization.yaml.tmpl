apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

# The file name follows the broker, so this list needs no conditional: only the
# matching pubsub-*.yaml is rendered at all.
resources:
  - dapr/pubsub-{{ .pubsub }}.yaml
  - dapr/secretstore-{{ .secretStore }}.yaml
{{- if and (gt (len .topology.connectors) 0) (ne .env "local") }}
  - bindings/bindings.yaml
{{- end }}
{{- if eq .secretStore "kubernetes" }}
  - secrets/secrets.yaml
{{- end }}
