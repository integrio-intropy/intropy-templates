apiVersion: dapr.io/v1alpha1
kind: Component
metadata:
  name: {{ .system }}-secretstore
spec:
  type: secretstores.azure.keyvault
  version: v1
  metadata:
    - name: vaultName
      value: REPLACE-ME-KEYVAULT-NAME
    # Workload identity: no client secret to commit. The federated credential and
    # the service account annotation are cluster setup, not manifest content.
    - name: azureClientId
      value: REPLACE-ME-KEYVAULT-CLIENT-ID
