{{- if eq .env "local" }}
# RabbitMQ pub/sub: what the local development cluster's k3s setup installs,
# and the only broker int local ever renders with. The address is the fixture
# contract (see deploy-host/README.md); the credentials are the contract's
# conventional dev credentials, inline rather than behind the secret store,
# because there is nothing to keep secret locally.
{{- end }}
apiVersion: dapr.io/v1alpha1
kind: Component
metadata:
  name: {{ .pubsubName }}
spec:
  type: pubsub.rabbitmq
  version: v1
  metadata:
    - name: connectionString
{{- if eq .env "local" }}
      value: amqp://guest:guest@rabbitmq.fixtures.svc.cluster.local:5672
{{- else }}
      secretKeyRef:
        name: {{ .secretName }}
        key: rabbitmq-connection
{{- end }}
    - name: durable
      value: "true"
    - name: deliveryMode
      value: "2"
{{- if ne .env "local" }}
# Resolved through the system's secret store, not necessarily a Kubernetes
# Secret: with kubernetes that is the rendered secrets/secrets.yaml, and with
# Key Vault or Vault the key is looked up there instead.
auth:
  secretStore: {{ .system }}-secretstore
{{- end }}

# Exactly the app-ids the topology says publish to or subscribe from this
# broker's topics. The Component is namespace-scoped and this directory is its
# only owner, so scopes is what limits who may use it.
scopes:
{{- range .topology.pubsubs }}
{{- range .appIds }}
  - {{ . }}
{{- end }}
{{- end }}
