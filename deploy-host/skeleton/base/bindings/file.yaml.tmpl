# The file adapter: one Dapr `bindings.localstorage` Component per port
# whose topology binding selected `file`, as a multi-document file. (The
# catalog name is `file`; the Dapr type is bindings.localstorage — there is
# no bindings.file.) Metadata contract per dapr/components-contrib
# bindings/localstorage/metadata.yaml.
#
# Multi-doc rather than a file each: kustomize reads it natively, and adding a
# port stays a one-file diff. The topology mints only the port's
# name, label, and scopes. The name must not change: blocks resolve the
# binding by the port name.
#
# Local storage means the daprd container's filesystem: a Kubernetes
# deployment must mount suitable storage (a PVC, a hostPath, an NFS share) at
# rootPath on every pod that resolves this binding, or files land on the
# ephemeral container filesystem and vanish with the pod.
{{- range .topology.ports }}
{{- if eq .binding "file" }}
---
apiVersion: dapr.io/v1alpha1
kind: Component
metadata:
  name: {{ .name }}
  labels:
    intropy.io/port: {{ .name }}
spec:
  type: bindings.localstorage
  version: v1
  metadata:
    # Each component using the port mounts the claim below into its sidecar
    # at this path (the patch in its environment overlay).
    - name: rootPath
      value: /data/{{ .name }}
scopes:
{{- range .appIds }}
  - {{ . }}
{{- end }}
---
# The storage behind the port: typically a network share, through a
# StorageClass that provisions it (an SMB or NFS CSI driver) or a
# PersistentVolume pre-provisioned for it (then set volumeName and an empty
# storageClassName). ReadWriteMany, because every pod of every component
# using the port mounts it, on whichever node it lands.
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ .name }}-file
  labels:
    intropy.io/port: {{ .name }}
spec:
  storageClassName: REPLACE-ME-STORAGE-CLASS
  accessModes:
    - ReadWriteMany
  resources:
    requests:
      storage: 1Gi
{{- end }}
{{- end }}
