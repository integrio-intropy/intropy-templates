# One Dapr binding per connector the topology declares, as a multi-document file.
#
# Multi-doc rather than a file each: kustomize reads it natively, and adding a
# connector stays a one-file diff. The topology mints only the connector's name
# and scopes — the binding's spec.type, address, and credentials are owned
# here, never in the topology, so every connector renders as a REPLACE-ME
# scaffold. The name must not change: the blocks resolve the binding as
# binding.<connector-name>.
{{- range .topology.connectors }}
---
apiVersion: dapr.io/v1alpha1
kind: Component
metadata:
  name: {{ .name }}
spec:
  # The topology deliberately carries no binding type — pick the Dapr binding
  # this connector deploys as (e.g. bindings.sftp, bindings.http,
  # bindings.localstorage) and fill in its metadata below.
  type: REPLACE-ME-BINDING-TYPE
  version: v1
  metadata:
    - name: REPLACE-ME-METADATA-NAME
      value: REPLACE-ME-METADATA-VALUE
scopes:
{{- range .appIds }}
  - {{ . }}
{{- end }}
{{- end }}
