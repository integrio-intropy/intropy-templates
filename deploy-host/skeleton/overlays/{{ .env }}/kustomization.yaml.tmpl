apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

# Thin on purpose. The Dapr components are identical in every environment; what
# differs is the credential, and a Component reaches that through secretKeyRef.
# The namespace is this environment's `namespace` in deploy.yaml, or the
# platform default when it names none: one integration namespace per cluster,
# shared by every system and environment.
namespace: {{ default "integration" (dig "gitops" "namespace" "" .) }}

resources:
  - ../../base
