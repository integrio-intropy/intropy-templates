<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- coverlet.collector: enables the "XPlat Code Coverage" collector used by `task coverage`. -->
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Intropy.Framework.Hosting" Version="2.1.0-beta.8" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <!-- NSubstitute appears exactly once in the suite: the DaprClient sidecar
         seam the runner waits on and shuts down. -->
    <PackageReference Include="NSubstitute" Version="6.1.0" />
    <!-- Hand-rolled fakes for the platform-service clients. -->
    <PackageReference Include="Intropy.Framework.Testing" Version="2.1.0-beta.8" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/{{ .name }}.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
