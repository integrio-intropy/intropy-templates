using Intropy.Framework.Hosting.Jobs;
using Microsoft.Extensions.DependencyInjection;

namespace {{ .name }}.Test.Integration;

/// <summary>
/// Composition smoke test: the DI graph the job runs on must build without a Dapr
/// sidecar. Registrations are lazy — a missing registration (framework upgrade, a
/// constructor dependency the job gained) fails here, not on the first scheduled run.
/// </summary>
public class CompositionTests
{
    [Fact]
    public void Composition_ResolvesJobRunner()
    {
        var provider = Composition.Composition.ConfigureServices(new ServiceCollection(), "Development").BuildServiceProvider();

        var runner = provider.GetRequiredService<JobRunner>();

        Assert.NotNull(runner);
    }

    [Fact]
    public void Composition_ResolvesTheJob()
    {
        var provider = Composition.Composition.ConfigureServices(new ServiceCollection(), "Development").BuildServiceProvider();

        var job = provider.GetRequiredService<IJob>();

        Assert.IsType<Job>(job);
    }
}
