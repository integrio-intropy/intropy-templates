version: "3"

# Build and test tasks for {{ .name }} — a .NET loader integration.
# The loader runs via its system host (messages are published from there);
# these tasks are the component-level loop.

tasks:
  # ── .NET build ────────────────────────────────────────────────────
  build:
    desc: Build the application
    dir: "{{ "{{" }}.TASKFILE_DIR}}"
    cmds:
      - dotnet build

  # ── Tests ─────────────────────────────────────────────────────────
  # `test` stays as the umbrella alias; the split tasks let you run the fast
  # unit suite on its own while the steps are being implemented.
  test:unit:
    desc: Run the unit tests (pipeline steps; no fakes, no Dapr)
    dir: "{{ "{{" }}.TASKFILE_DIR}}"
    cmds:
      - dotnet test ./test/{{ .name }}.Test.Unit

  test:integration:
    desc: Run the integration tests (delivery, boot smoke, composition — Intropy.Framework.Testing fakes)
    dir: "{{ "{{" }}.TASKFILE_DIR}}"
    cmds:
      - dotnet test ./test/{{ .name }}.Test.Integration

  test:
    desc: Run all tests (unit + integration)
    dir: "{{ "{{" }}.TASKFILE_DIR}}"
    deps: [test:unit, test:integration]

  coverage:
    desc: Run the integration suite with branch coverage (Cobertura report in test/{{ .name }}.Test.Integration/TestResults)
    dir: "{{ "{{" }}.TASKFILE_DIR}}"
    cmds:
      - dotnet test ./test/{{ .name }}.Test.Integration --collect:"XPlat Code Coverage" -- DataCollectionRunSettings.DataCollectors.DataCollector.Configuration.Format=cobertura
