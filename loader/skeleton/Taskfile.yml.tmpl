version: "3"

# Build and test tasks for {{ .name }} — a .NET loader integration.
# The loader runs via its system host (messages are published from there);
# these tasks are the component-level loop.

tasks:
  # ── .NET build ────────────────────────────────────────────────────
  build:
    desc: Build the application
    dir: "{{ "{{" }}.TASKFILE_DIR}}"
    cmds:
      - dotnet build ./src

  # ── Tests ─────────────────────────────────────────────────────────
  test:
    desc: Run the tests
    dir: "{{ "{{" }}.TASKFILE_DIR}}"
    cmds:
      - dotnet test ./test
