# syntax=docker/dockerfile:1
# Build context: the system folder, which holds this component and the
# {{ .contracts }} sibling it references. From the system folder:
#   docker build -f {{ .appId }}/Dockerfile -t {{ .appId }} .
# COMPONENT is this component's folder; override it with --build-arg when the
# folder is not named {{ .appId }}.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG COMPONENT={{ .appId }}
WORKDIR /source

# The system's shared MSBuild properties, when it has them (the glob matches
# nothing otherwise).
COPY Directory.Build.prop[s] ./
COPY {{ .contracts }}/ {{ .contracts }}/

# Restore first so the NuGet layer is cached until a csproj changes.
COPY ${COMPONENT}/src/{{ .name }}.csproj ${COMPONENT}/src/
RUN dotnet restore ${COMPONENT}/src

COPY ${COMPONENT}/src/ ${COMPONENT}/src/
RUN dotnet publish ${COMPONENT}/src -c Release -o /app --no-restore

# Chiseled ASP.NET Core runtime: no shell or package manager, runs as non-root
# `app`. The loader serves no HTTP — it consumes through a Dapr streaming
# subscription, so the sidecar needs no --app-port — but Intropy.Framework.Hosting
# runs on the ASP.NET Core shared framework, so the image needs it. Invariant
# globalization — switch to 10.0-noble-chiseled-extra if the app needs ICU
# (culture-sensitive parsing/formatting) or tzdata.
FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled
WORKDIR /app
COPY --from=build /app .
ENTRYPOINT ["dotnet", "{{ .name }}.dll"]
