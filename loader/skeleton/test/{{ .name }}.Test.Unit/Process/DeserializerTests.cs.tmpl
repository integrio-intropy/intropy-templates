using CloudNative.CloudEvents;
using {{ .contracts }};
using {{ .name }}.Process;
using Intropy.Framework.Blocks.Shared;
using Intropy.Framework.Core.Pipeline.Abstractions.Results;

namespace {{ .name }}.Test.Unit.Process;

public class DeserializerTests
{
{{- if .empty }}
    // Fails from the start: the Deserializer body throws NotImplementedException.
    // The assertions pin the step's framework contract — parse the payload and
    // stamp the business id into the context for the idempotency/incident
    // wiring downstream — and flip green once the step is implemented. Add
    // branch tests (malformed payload, missing fields) with the real shape.
    // The input is test-owned (see DeliveryIntegrationTests); replace it with
    // a real payload sample when the contract shape is defined.
    [Fact]
    public async Task ExecuteAsync_WithValidPayload_ReturnsSuccessAndStampsBusinessIdInContext()
    {
        // Arrange: a bare envelope, like `dapr publish` produces (no Subject/Time).
        var deserializer = new Deserializer();
        var context = new Context(new Dictionary<string, string>());
        var json = """{"sourceRecordId":"REC-1","occurredAt":"2026-01-15T09:30:00+00:00","lines":[{"sku":"SKU-1","quantity":2,"unitPrice":10.0}]}""";
        var cloudEvent = new CloudEvent { Id = "evt-1", Data = json };

        // Act
        var (result, resultContext) = await deserializer.ExecuteAsync(cloudEvent, context, CancellationToken.None);

        // Assert
        Assert.IsType<BusinessStepResult<{{ .contract }}>.Success>(result);
        Assert.False(string.IsNullOrWhiteSpace(resultContext.Metadata[Constants.ContextKeyOrderId]));
    }
{{- else }}
    private const string Json =
        """{"orderId":"ORD-1001","customerId":"CUST-42","orderDate":"2026-01-15T09:30:00+00:00","lines":[{"sku":"SKU-1","quantity":2,"unitPrice":10.0}]}""";

    [Fact]
    public async Task ExecuteAsync_WithValidCloudEvent_ReturnsSuccess()
    {
        // Arrange: a bare envelope, like `dapr publish` produces (no Subject/Time).
        var deserializer = new Deserializer();
        var context = new Context(new Dictionary<string, string>());
        var cloudEvent = new CloudEvent { Id = "evt-1", Data = Json };

        // Act
        var (result, _) = await deserializer.ExecuteAsync(cloudEvent, context, CancellationToken.None);

        // Assert
        var success = Assert.IsType<BusinessStepResult<{{ .contract }}>.Success>(result);
        Assert.Equal("ORD-1001", success.Value.OrderId);
        Assert.Single(success.Value.Lines);
    }

    [Fact]
    public async Task ExecuteAsync_WithValidCloudEvent_StoresOrderIdInContext()
    {
        // Arrange
        var deserializer = new Deserializer();
        var context = new Context(new Dictionary<string, string>());
        var cloudEvent = new CloudEvent { Id = "evt-1", Data = Json };

        // Act
        var (_, resultContext) = await deserializer.ExecuteAsync(cloudEvent, context, CancellationToken.None);

        // Assert
        Assert.Equal("ORD-1001", resultContext.Metadata[Constants.ContextKeyOrderId]);
    }

    [Fact]
    public async Task ExecuteAsync_WithoutEnvelopeSubjectAndTime_StampsFromOrder()
    {
        // Arrange: the idempotency step requires Subject/Time in the context,
        // but a `dapr publish` envelope carries no Subject.
        var deserializer = new Deserializer();
        var context = new Context(new Dictionary<string, string>());
        var cloudEvent = new CloudEvent { Id = "evt-1", Data = Json };

        // Act
        var (_, resultContext) = await deserializer.ExecuteAsync(cloudEvent, context, CancellationToken.None);

        // Assert
        Assert.Equal("ORD-1001", resultContext.Metadata[Constants.ContextKeyCloudEventSubject]);
        Assert.Equal(new DateTimeOffset(2026, 1, 15, 9, 30, 0, TimeSpan.Zero).ToString("O"),
            resultContext.Metadata[Constants.ContextKeyCloudEventTime]);
    }

    [Fact]
    public async Task ExecuteAsync_WithEnvelopeSubjectAndTime_StampsBusinessIdentity()
    {
        // Arrange: an envelope with per-delivery Subject/Time. The idempotency
        // identity must stay on business fields — a wall-clock Time would make
        // the duplicate check pass everything.
        var deserializer = new Deserializer();
        var context = new Context(new Dictionary<string, string>());
        var cloudEvent = new CloudEvent
        {
            Id = "evt-1",
            Subject = "envelope-subject",
            Time = DateTimeOffset.UtcNow,
            Data = Json
        };

        // Act
        var (_, resultContext) = await deserializer.ExecuteAsync(cloudEvent, context, CancellationToken.None);

        // Assert
        Assert.Equal("ORD-1001", resultContext.Metadata[Constants.ContextKeyCloudEventSubject]);
        Assert.Equal(new DateTimeOffset(2026, 1, 15, 9, 30, 0, TimeSpan.Zero).ToString("O"),
            resultContext.Metadata[Constants.ContextKeyCloudEventTime]);
    }
{{- end }}
}
