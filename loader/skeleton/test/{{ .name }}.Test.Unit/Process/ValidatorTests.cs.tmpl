using {{ .contracts }};
using {{ .name }}.Process;
using Intropy.Framework.Blocks.Shared;
using Intropy.Framework.Core.Pipeline.Abstractions.Results;

namespace {{ .name }}.Test.Unit.Process;

public class ValidatorTests
{
{{- if .empty }}
    // Fails from the start: the Validator body throws NotImplementedException.
    // The assertion pins only the step's framework contract — return a
    // BusinessStepResult — since the business rules themselves are defined
    // with the implementation. Add branch tests (one per rule, like the full
    // sample suite's) as the rules land.
    [Fact]
    public async Task ExecuteAsync_WithInput_ReturnsBusinessStepResult()
    {
        // Arrange
        var validator = new Validator();
        var input = new {{ .contract }}();

        // Act
        var (result, _) = await validator.ExecuteAsync(input, new Context(new Dictionary<string, string>()), CancellationToken.None);

        // Assert
        Assert.IsAssignableFrom<BusinessStepResult<{{ .contract }}>>(result);
    }
{{- else }}
    [Fact]
    public async Task ExecuteAsync_WithValidOrder_ReturnsSuccess()
    {
        // Arrange
        var validator = new Validator();
        var order = CreateValidOrder();

        // Act
        var (result, _) = await validator.ExecuteAsync(order, new Context(new Dictionary<string, string>()), CancellationToken.None);

        // Assert
        Assert.IsType<BusinessStepResult<{{ .contract }}>.Success>(result);
    }

    [Fact]
    public async Task ExecuteAsync_WithMissingOrderId_ReturnsFailure()
    {
        // Arrange
        var validator = new Validator();
        var order = CreateValidOrder() with { OrderId = "" };

        // Act
        var (result, _) = await validator.ExecuteAsync(order, new Context(new Dictionary<string, string>()), CancellationToken.None);

        // Assert
        var failure = Assert.IsType<BusinessStepResult<{{ .contract }}>.Failure>(result);
        Assert.Equal("OrderId is required", failure.Value.Description);
    }

    [Fact]
    public async Task ExecuteAsync_WithFutureOrderDate_ReturnsFailure()
    {
        // Arrange
        var validator = new Validator();
        var order = CreateValidOrder() with { OrderDate = DateTimeOffset.UtcNow.AddDays(1) };

        // Act
        var (result, _) = await validator.ExecuteAsync(order, new Context(new Dictionary<string, string>()), CancellationToken.None);

        // Assert
        Assert.IsType<BusinessStepResult<{{ .contract }}>.Failure>(result);
    }

    [Fact]
    public async Task ExecuteAsync_WithNoLines_ReturnsFailure()
    {
        // Arrange
        var validator = new Validator();
        var order = CreateValidOrder() with { Lines = [] };

        // Act
        var (result, _) = await validator.ExecuteAsync(order, new Context(new Dictionary<string, string>()), CancellationToken.None);

        // Assert
        var failure = Assert.IsType<BusinessStepResult<{{ .contract }}>.Failure>(result);
        Assert.Equal("Order must contain at least one line", failure.Value.Description);
    }

    private static {{ .contract }} CreateValidOrder() => new(
        OrderId: "ORD-1001",
        CustomerId: "CUST-42",
        OrderDate: DateTimeOffset.UtcNow.AddDays(-1),
        Lines: [new OrderLine("SKU-1", 2, 10.0m)]);
{{- end }}
}
