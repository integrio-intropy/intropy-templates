namespace {{ .name }}.Test.Integration;

/// <summary>
/// Boot smoke test: the host the system will run must start and serve its app callback without a
/// sidecar. The loader composes every route's pipeline before it serves, so a missing
/// registration (framework upgrade, renamed builder) fails here, not at system-host time.
/// </summary>
public class BootSmokeTests
{
    [Fact]
    public async Task Host_StartsAndServesTheAppCallback()
    {
        await using var sut = await LoaderSut.StartAsync();

        // The subscription is a declarative Dapr resource the system renders: the loader
        // announces none of its own.
        Assert.Empty(await sut.Sidecar.GetSubscriptionsAsync());
    }
}
