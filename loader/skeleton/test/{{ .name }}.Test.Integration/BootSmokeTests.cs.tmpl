using Dapr.Messaging.PublishSubscribe;

namespace {{ .name }}.Test.Integration;

/// <summary>
/// Boot smoke test: the host the system will run must start and subscribe to its topic
/// without a sidecar. The loader composes its pipeline before subscribing, so a missing
/// registration (framework upgrade, renamed builder) fails here, not at system-host time.
/// </summary>
public class BootSmokeTests
{
    [Fact]
    public async Task Host_StartsAndSubscribesToItsTopic()
    {
        await using var sut = await LoaderSut.StartAsync();

        var subscription = sut.Subscriber.Current;
        Assert.Equal(Constants.PubSubName, subscription.PubSubName);
        Assert.Equal(Constants.TopicName, subscription.TopicName);
        // A message the loader does not acknowledge is redelivered, never dropped.
        Assert.Equal(TopicResponseAction.Retry, subscription.Options.MessageHandlingPolicy.DefaultResponseAction);
    }
}
