using Intropy.Contracts.BusinessIncidentService;
using Intropy.Contracts.IdempotencyService;
using Intropy.Framework.Adapters.File;
using Intropy.Framework.Hosting.Loader;
using Intropy.Framework.Testing.Adapters;
using Intropy.Framework.Testing.Delivery;
using Intropy.Framework.Testing.Services;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Hosting;

namespace {{ .name }}.Test.Integration;

/// <summary>
/// The real host — production composition, the gRPC app callback, ack mapping — with only the
/// edges faked: the sidecar's pushes (<see cref="AppCallbackDelivery"/> on a free port), the
/// keyed destination adapter, and both platform-service clients. The fakes are registered
/// after the component's own registrations, so plain last-wins registrations replace them.
/// </summary>
public sealed class LoaderSut : IAsyncDisposable
{
    // Where the faked sidecar delivers from — what the system topology's Subscription
    // resource names for this component. The loader itself takes whatever it is delivered.
    private const string PubSubName = "pubsub";
    private const string TopicName = "{{ .channel }}";

    public IHost Host { get; private set; } = null!;
    public AppCallbackDelivery Sidecar { get; private set; } = null!;
    public InMemoryFileAdapter Files { get; } = new();
    public FakeIdempotencyServiceClient Idempotency { get; } = new();
    public FakeBusinessIncidentServiceClient Incidents { get; } = new();

    /// <summary>Starts the host with its callback on a free port, so tests can run in parallel.</summary>
    public static async Task<LoaderSut> StartAsync()
    {
        var sut = new LoaderSut();
        var builder = Composition.Composition.CreateHostBuilder([], "Development");
        builder.Services.AddKeyedSingleton<IFileAdapter>(Constants.DestinationPort, sut.Files);
        builder.Services.AddSingleton<IIdempotencyServiceClient>(sut.Idempotency);
        builder.Services.AddSingleton<IBusinessIncidentServiceClient>(sut.Incidents);

        sut.Host = builder.Build();
        // In a deployment the callback listens on APP_PORT, which the sidecar's host sets; the
        // test gives this host a free port of its own instead.
        var options = sut.Host.Services.GetRequiredService<LoaderOptions>();
        options.CallbackPort = AppCallbackDelivery.AvailablePort();
        await sut.Host.StartAsync();
        sut.Sidecar = new AppCallbackDelivery(options.CallbackPort.Value, PubSubName, TopicName);
        return sut;
    }

    public void Deconstruct(out AppCallbackDelivery sidecar, out InMemoryFileAdapter files,
        out FakeIdempotencyServiceClient idempotency, out FakeBusinessIncidentServiceClient incidents)
    {
        sidecar = Sidecar;
        files = Files;
        idempotency = Idempotency;
        incidents = Incidents;
    }

    public async ValueTask DisposeAsync()
    {
        await Host.StopAsync();
        Host.Dispose();
        Sidecar.Dispose();
    }
}
