using Intropy.Framework.Adapters.File;
using Microsoft.Extensions.DependencyInjection;

namespace {{ .name }}.Test.Integration;

/// <summary>
/// Composition smoke test: the DI graph the host will run must build without a Dapr sidecar.
/// The Development host validates the graph when it is built, so a registration the
/// composition misses fails here, not at system-host time.
/// </summary>
public class CompositionTests
{
    [Fact]
    public void Composition_BuildsTheHost()
    {
        using var host = Composition.Composition.CreateHostBuilder([], "Development").Build();

        Assert.NotNull(host);
    }

    [Fact]
    public void Composition_ResolvesDestinationFileAdapterUnderItsKey()
    {
        using var host = Composition.Composition.CreateHostBuilder([], "Development").Build();

        var adapter = host.Services.GetRequiredKeyedService<IFileAdapter>(Constants.DestinationPort);

        Assert.NotNull(adapter);
    }
}
