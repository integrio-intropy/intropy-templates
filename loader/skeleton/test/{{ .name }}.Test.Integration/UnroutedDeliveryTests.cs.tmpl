using CloudNative.CloudEvents;
using Intropy.Framework.Testing.Delivery;

namespace {{ .name }}.Test.Integration;

/// <summary>
/// What the loader does with a message the Dapr subscription's content filters leave out
/// and deliver on the subscription's default route.
{{- if eq .default "ignore" }} Unrouted messages are acknowledged and dropped
/// (<c>default: ignore</c>; the system's IgnoreOthers()), leaving no trace.
{{- else }} Unrouted messages are left for redelivery
/// (<c>default: dead-letter</c>), so the broker dead-letters them; nothing is written.
{{- end }}
/// </summary>
public class UnroutedDeliveryTests
{
    private static readonly DeliveryAck Expected = DeliveryAck.{{ if eq .default "ignore" }}Success{{ else }}Retry{{ end }};

    [Fact]
    public async Task DeliverUnhandledAsync_WithAnEventTheSubscriptionFilterLeftOut_LeavesNoTrace()
    {
        // Arrange: the Dapr subscription selected its default route, so the framework marks
        // the message unrouted before the pipeline runs.
        await using var sut = await LoaderSut.StartAsync();
        var (sidecar, files, idempotency, _) = sut;

        // Act
        var ack = await sidecar.DeliverUnhandledAsync(NewDelivery("{{ .subscribes }}"));

        // Assert
        Assert.Equal(Expected, ack);
        Assert.Empty(files.Files);
        Assert.Empty(idempotency.Committed);
    }

    private static CloudEvent NewDelivery(string type) => new()
    {
        Id = Guid.NewGuid().ToString(),
        Source = new Uri("urn:test:delivery"),
        Type = type,
        Time = DateTimeOffset.UtcNow,
        DataContentType = "application/json",
        Data = "{}"
    };
}
