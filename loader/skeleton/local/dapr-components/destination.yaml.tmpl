apiVersion: dapr.io/v1alpha1
kind: Component
metadata:
  # Named after the connector so the system host's generated binding replaces
  # this one in the staged overlay (same name, different backing folder).
  name: binding.{{ .connector }}
spec:
  type: bindings.localstorage
  version: v1
  metadata:
    - name: rootPath
      value: "./local/storage/{{ .connector }}"
