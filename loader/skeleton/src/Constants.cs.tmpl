namespace {{ .name }};

public static class Constants
{
    public const string ComponentName = "{{ .name | kebabcase }}";
    public const string Organization = "{{ .organization }}";

    public const string PubSubName = "pubsub";
    public const string TopicName = "{{ .channel }}";

    // The subscribed message's logical name — the one declaration this
    // scaffold is wired from, and the CloudEvents type of what the sidecar
    // delivers (the envelope's `type` field).
    public const string MessageName = "{{ .subscribes }}";

    // The destination port: the named interface this component writes the
    // outside world through. The name is the port's whole identity —
    // declared in the system host's Ports.cs, it is also the Dapr binding
    // component's name and the key of the file adapter registered for it.
    // The name never changes between environments; the environment swaps the
    // binding's type (local folder, SFTP, …) behind it.
    public const string DestinationPort = "{{ .port }}";

    // Context keys the loader pipeline's idempotency step reads CloudEvent
    // Subject (id) and Time (date) from. The values mirror the framework's
    // internal CloudEventContextKeys (Intropy.Framework.Blocks) — they must
    // match exactly.
    public const string ContextKeyCloudEventSubject = "cloudevent.subject";
    public const string ContextKeyCloudEventTime = "cloudevent.time";

    public const string ContextKeyOrderId = "order_id";
}
