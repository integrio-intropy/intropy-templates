using {{ .name }}.Composition;
using Microsoft.Extensions.Hosting;

// A generic-host worker: the Dapr sidecar pushes the topic's messages to the gRPC
// app callback the loader serves on APP_PORT, until the host stops (SIGTERM from the
// scheduler, Ctrl+C locally). The subscription is the declarative Dapr Subscription
// the system renders from its topology. Every service registration lives in
// Composition, so the tests build the exact graph this host runs.
using var host = Composition.CreateHostBuilder(args).Build();
await host.RunAsync();
