using {{ .name }}.Configuration;
using {{ .name }}.Model;
using Intropy.Framework.Adapters.File;
using Intropy.Framework.Blocks.Loader;
using Intropy.Framework.Blocks.Shared;
using Microsoft.Extensions.DependencyInjection;

namespace {{ .name }}.Process;

public static class ServiceCollectionExtensions
{
    public static IServiceCollection AddProcessPipeline(this IServiceCollection services)
    {
        services.AddSingleton(provider =>
            LoaderBuilder<In, Out, Context>.Create("{{ .name }}.Process", provider)
                .WithDeserializer(new Deserializer())
                .WithValidator(new Validator())
                // The loader pipeline requires idempotency. It keys off CloudEvent
                // Subject (id) and Time (date) read from context metadata — the
                // Deserializer backfills both from the order's business identity
                // when the envelope lacks them. The payload hash uses the default
                // implementation (property reflection + SHA256).
                .WithIdempotency()
                .WithTransformer(new Transformer())
                .WithSender(new Sender(
                    provider.GetRequiredKeyedService<IFileAdapter>(Constants.DestinationFileAdapterKey)))
                .WithBusinessIncidents(
                    messageIdExtractor: ctx => ctx.Metadata.GetValueOrDefault(Constants.ContextKeyOrderId,
                        ctx.Metadata.GetValueOrDefault(Constants.ContextKeyCloudEventSubject, "unknown")),
                    subjectExtractor: ctx => ctx.Metadata.GetValueOrDefault(Constants.ContextKeyOrderId,
                        ctx.Metadata.GetValueOrDefault(Constants.ContextKeyCloudEventSubject, "unknown")))
                .Build());
        return services;
    }
}
