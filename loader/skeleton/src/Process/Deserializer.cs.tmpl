using System.Text.Json;
using CloudNative.CloudEvents;
using {{ .contracts }};
using Intropy.Contracts.BusinessIncidentService;
using Intropy.Framework.Blocks.Loader.Steps;
using Intropy.Framework.Blocks.Shared;
using Intropy.Framework.Core.Pipeline.Abstractions.Results;

namespace {{ .name }}.Process;

public class Deserializer : DeserializeStep<{{ .contract }}, Context>
{
    protected override Task<(BusinessStepResult<{{ .contract }}> Result, Context Context)> DeserializeAsync(
        CloudEvent cloudEvent, Context context)
    {
{{- if .empty }}
        throw new NotImplementedException();
{{- else if .generatedContract }}
        var json = cloudEvent.Data?.ToString();
        if (string.IsNullOrEmpty(json))
        {
            var incident = new BusinessIncidentData
            {
                Description = "CloudEvent data is null or empty",
                Context = new Dictionary<string, string>()
            };
            return Task.FromResult<(BusinessStepResult<{{ .contract }}>, Context)>(
                (new BusinessStepResult<{{ .contract }}>.Failure(incident), context));
        }

        // The contract project's own options, not options built here: reading
        // a schema's string enums back as the schema spells them - hyphens
        // included - depends on the converters they carry.
        var payload = JsonSerializer.Deserialize<{{ .contract }}>(json, ContractOptions.Options)!;

        // Deliberately no business-identity stamping. The payload's shape comes
        // from the registry schema, so this scaffold cannot know which property
        // is the entity id or the occurrence time. The idempotency keys stay as
        // the base step read them from the CloudEvent envelope: right for an
        // event an extractor published, weaker for a hand-run `dapr publish`,
        // whose envelope carries no Subject and a wall-clock Time. Stamp them
        // here once you know which property is the business key.

        return Task.FromResult<(BusinessStepResult<{{ .contract }}>, Context)>(
            (new BusinessStepResult<{{ .contract }}>.Success(payload), context));
{{- else }}
        var json = cloudEvent.Data?.ToString();
        if (string.IsNullOrEmpty(json))
        {
            var incident = new BusinessIncidentData
            {
                Description = "CloudEvent data is null or empty",
                Context = new Dictionary<string, string>()
            };
            return Task.FromResult<(BusinessStepResult<{{ .contract }}>, Context)>(
                (new BusinessStepResult<{{ .contract }}>.Failure(incident), context));
        }

        var order = JsonSerializer.Deserialize<{{ .contract }}>(json,
            new JsonSerializerOptions { PropertyNameCaseInsensitive = true })!;

        context.Metadata[Constants.ContextKeyOrderId] = order.OrderId;

        // The idempotency check keys off the CloudEvent Subject/Time context
        // keys the base step extracted from the envelope. Stamp both from the
        // order's business identity: for extractor-published events these equal
        // the envelope values, and a `dapr publish` envelope carries no Subject
        // and a wall-clock Time — a per-delivery value that would make the
        // duplicate check pass everything.
        context.Metadata[Constants.ContextKeyCloudEventSubject] = order.OrderId;
        context.Metadata[Constants.ContextKeyCloudEventTime] = order.OrderDate.ToString("O");

        return Task.FromResult<(BusinessStepResult<{{ .contract }}>, Context)>(
            (new BusinessStepResult<{{ .contract }}>.Success(order), context));
{{- end }}
    }
}
