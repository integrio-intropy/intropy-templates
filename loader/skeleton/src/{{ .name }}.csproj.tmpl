<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapr.AspNetCore" Version="1.18.5" />
    <PackageReference Include="Dapr.Client" Version="1.18.5" />
    <PackageReference Include="Intropy.BusinessIncidentService.Client" Version="0.1.1" />
    <PackageReference Include="Intropy.Contracts" Version="0.1.0" />
    <PackageReference Include="Intropy.Framework.Adapters" Version="0.3.0-beta.2" />
    <PackageReference Include="Intropy.Framework.Blocks" Version="0.3.0-beta.3" />
    <PackageReference Include="Intropy.IdempotencyService.Client" Version="0.1.0" />
    <PackageReference Include="Intropy.Telemetry.AspNetCore" Version="0.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared contracts sibling is scaffolded by this template's
         spec.dependencies entry, so it exists whenever this project does. -->
    <ProjectReference Include="../../{{ .contracts }}/{{ .contracts }}.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
