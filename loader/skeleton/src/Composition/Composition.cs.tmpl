using {{ .contracts }};
using Dapr.Client;
using {{ .name }}.Model;
using {{ .name }}.Process;
using Intropy.BusinessIncidentService.Client;
using Intropy.Framework.Adapters.File;
using Intropy.Framework.Blocks.Loader;
using Intropy.Framework.Blocks.Loader.Steps;
using Intropy.Framework.Blocks.Shared;
using Intropy.Framework.Core.Configuration;
using Intropy.IdempotencyService.Client;
using Intropy.Telemetry.AspNetCore;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;
using Sender = {{ .name }}.Process.Sender;

namespace {{ .name }}.Composition;

/// <summary>
/// The component's service registrations, shared by the entrypoint
/// (<c>Program.cs</c>) and the composition smoke test. Everything the host
/// needs — telemetry, Dapr clients, the destination file adapter, the load
/// pipeline — is registered here so the test can prove the whole graph
/// builds without a sidecar.
/// </summary>
public static class Composition
{
    /// <summary>Registers every service the loader needs.</summary>
    /// <param name="services">The service collection to register into.</param>
    /// <param name="environment">The environment whose appsettings overlay applies. Defaults to
    /// DOTNET_ENVIRONMENT, or Production; tests pass Development.</param>
    public static IServiceCollection ConfigureServices(IServiceCollection services, string? environment = null)
    {
        environment ??= Environment.GetEnvironmentVariable("DOTNET_ENVIRONMENT") ?? "Production";

        // Configuration: appsettings.json + environment overlay + env vars. Based on the
        // binary directory, not the CWD — a host may launch the app from a different
        // working directory. Built for this composition's own reads only, and
        // deliberately NOT registered in DI: this component is a WebApplication, and
        // replacing the host's IConfiguration breaks server port resolution —
        // ASPNETCORE_HTTP_PORTS is ignored and the app binds localhost:5000 while
        // the Dapr sidecar waits forever on the annotated app port.
        var configuration = new ConfigurationBuilder()
            .SetBasePath(AppContext.BaseDirectory)
            .AddJsonFile("appsettings.json", optional: true, reloadOnChange: false)
            .AddJsonFile($"appsettings.{environment}.json", optional: true, reloadOnChange: false)
            .AddEnvironmentVariables()
            .Build();

        // Register host-level platform plumbing first: diagnostics, Dapr, framework
        // services, and shared platform clients. Keeping these together makes the
        // ordering-sensitive DaprClient registrations obvious.
        services.AddLogging(builder => builder.AddConsole());

        services.AddOpenTelemetry(conf =>
        {
            conf.ServiceNamespace = Constants.Organization;
            conf.ServiceName = Constants.ComponentName;
            conf.Environment = environment;
        });

        services.AddSingleton(_ => new DaprClientBuilder().Build());

        // Registered after the DaprClient above on purpose: AddIdempotencyServiceClient
        // contributes its own DaprClient registration (camelCase JSON + string enums),
        // and the last registration wins for GetRequiredService<DaprClient>().
        services.AddIdempotencyServiceClient(c =>
        {
            c.AppId = configuration["PlatformServices:IdempotencyServiceAppId"]
                      ?? "idempotency-service.services";
        });

        services.AddBusinessIncidentServiceClient(c =>
        {
            c.AppId = configuration["PlatformServices:BusinessIncidentServiceAppId"]
                      ?? "business-incident-service.services";
        });

        services.AddIntropyFramework(x =>
        {
            x.ComponentName = Constants.ComponentName;
            x.ServiceNamespace = Constants.Organization;
        });

        // The destination port is the one the Sender writes through. Its file adapter is
        // chosen by configuration: Ports:<port>:Kind selects the Dapr binding the port is
        // deployed with (File or Sftp).
        // appsettings.Development.json selects File, the local folder the system host
        // resolves each port to; a deployment sets Ports__<port>__Kind to match the binding it
        // renders. With no Kind, startup fails naming the port. A binding's address and
        // credentials live in the environment's Dapr component (GitOps values), resolved out of
        // the cluster's secret store.
        services.AddDestinationPort(Constants.DestinationPort, configuration);

        // The destination sender is a service like the other externals
        // (destination adapter, platform clients): tests swap it for their own
        // SendStep<Out, Context> via RemoveAll/AddSingleton, exactly as they
        // swap the others — no special seam in BuildPipeline.
        services.AddSingleton<SendStep<Out, Context>>(sp =>
            new Sender(sp.GetRequiredKeyedService<IFileAdapter>(Constants.DestinationPort)));

        // Register the pipeline last, after every adapter, sender, and platform
        // client it resolves from DI has been added to the service collection.
        AddLoadPipeline(services);

        return services;
    }

    /// <summary>The single composition entrypoint for the pipeline: registers
    /// <see cref="BuildPipeline"/> as the pipeline factory. The explicit lambda
    /// matters — a method group (<c>AddSingleton(BuildPipeline)</c>) compiles but
    /// registers a signature DI cannot resolve for <c>Loader&lt;,,&gt;</c>.</summary>
    private static void AddLoadPipeline(IServiceCollection services) =>
        services.AddSingleton(provider => BuildPipeline(provider));

    /// <summary>
    /// Builds the load pipeline against the DI graph. Every external dependency —
    /// destination adapter, sender, idempotency, business incidents — resolves
    /// from the provider, so a test swaps any of them by swapping its
    /// registration.
    /// </summary>
    public static Loader<{{ .contract }}, Out, Context> BuildPipeline(IServiceProvider provider)
    {
        return LoaderBuilder<{{ .contract }}, Out, Context>.Create("{{ .name }}.Process", provider)
            .WithDeserializer(new Deserializer())
            .WithValidator(new Validator())
            // The loader pipeline requires idempotency. It keys off CloudEvent
            // Subject (id) and Time (date) read from context metadata — the
            // Deserializer backfills both from the order's business identity
            // when the envelope lacks them. The payload hash uses the default
            // implementation (property reflection + SHA256).
            .WithIdempotency()
            .WithTransformer(new Transformer())
            // The sender resolves from DI like every other external dependency;
            // tests swap the SendStep<Out, Context> registration.
            .WithSender(provider.GetRequiredService<SendStep<Out, Context>>())
            .WithBusinessIncidents(
                messageIdExtractor: ctx => ctx.Metadata.GetValueOrDefault(Constants.ContextKeyOrderId,
                    ctx.Metadata.GetValueOrDefault(Constants.ContextKeyCloudEventSubject, "unknown")),
                subjectExtractor: ctx => ctx.Metadata.GetValueOrDefault(Constants.ContextKeyOrderId,
                    ctx.Metadata.GetValueOrDefault(Constants.ContextKeyCloudEventSubject, "unknown")))
            .Build();
    }
}
