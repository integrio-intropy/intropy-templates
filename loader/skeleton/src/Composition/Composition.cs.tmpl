using Dapr.Client;
using Intropy.BusinessIncidentService.Client;
using Intropy.Framework.Adapters.File;
using Intropy.Framework.Blocks.Loader.Steps;
using Intropy.Framework.Blocks.Shared;
using Intropy.Framework.Core.Configuration;
using Intropy.Framework.Hosting.Loader;
using Intropy.Framework.Hosting.Messaging;
using Intropy.IdempotencyService.Client;
using Intropy.Telemetry;
using Intropy.Telemetry.ConsoleApp;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Hosting;
{{- /* One alias pair per route: its pipeline's namespace and its payload type.
A route's namespace and its contract share their last segment, so the aliases
keep the composition below unambiguous whatever the project is named. */}}
{{- range .routes }}
using {{ pascal .message }}Route = {{ $.name }}.Routes.{{ pascal .message }};
using {{ pascal .message }}Payload = {{ $.contracts }}.{{ pascal .message }};
{{- end }}

namespace {{ .name }}.Composition;

/// <summary>
/// The component's host and service registrations, shared by the entrypoint
/// (<c>Program.cs</c>) and the tests, so the tests build the exact graph the
/// host runs. The loader is a generic-host worker: the Dapr sidecar pushes its
/// topic's messages to the gRPC app callback it serves on APP_PORT, under the
/// declarative Subscription the system renders from its topology, and each
/// message runs through the pipeline of the route its CloudEvent type selects.
/// </summary>
public static class Composition
{
    /// <summary>Creates the host builder with every service the loader needs.</summary>
    /// <param name="args">The process arguments.</param>
    /// <param name="environment">The environment whose appsettings overlay applies. Defaults to
    /// DOTNET_ENVIRONMENT, or Production; tests pass Development.</param>
    public static HostApplicationBuilder CreateHostBuilder(string[] args, string? environment = null)
    {
        var builder = Host.CreateApplicationBuilder(new HostApplicationBuilderSettings
        {
            Args = args,
            EnvironmentName = environment,
            // appsettings*.json are read from the binary directory, not the CWD: a host may
            // launch the app from a different working directory.
            ContentRootPath = AppContext.BaseDirectory
        });

        ConfigureServices(builder.Services, builder.Configuration, builder.Environment.EnvironmentName);
        return builder;
    }

    /// <summary>Registers every service the loader needs.</summary>
    public static IServiceCollection ConfigureServices(IServiceCollection services, IConfiguration configuration,
        string environment)
    {
        // Strict mode exports only the framework's Intropy.* spans and the component's own
        // (the loader's consumer span among them): the Dapr gRPC and HttpClient spans around
        // them are dropped, while trace context still propagates. Tracing:Mode in
        // configuration overrides it.
        services.AddOpenTelemetry(conf =>
        {
            conf.ServiceNamespace = Constants.Organization;
            conf.ServiceName = Constants.ComponentName;
            conf.Environment = environment;
            conf.Mode = TracingMode.Strict;
        });

        services.AddSingleton(_ => new DaprClientBuilder().Build());

        // Registered after the DaprClient above on purpose: AddIdempotencyServiceClient
        // contributes its own DaprClient registration (camelCase JSON + string enums),
        // and the last registration wins for GetRequiredService<DaprClient>().
        services.AddIdempotencyServiceClient(c =>
        {
            c.AppId = configuration["PlatformServices:IdempotencyServiceAppId"]
                      ?? "idempotency-service.services";
        });

        services.AddBusinessIncidentServiceClient(c =>
        {
            c.AppId = configuration["PlatformServices:BusinessIncidentServiceAppId"]
                      ?? "business-incident-service.services";
        });

        services.AddIntropyFramework(x =>
        {
            x.ComponentName = Constants.ComponentName;
            x.ServiceNamespace = Constants.Organization;
        });

        // The destination port is the one the Sender writes through. Its file adapter is
        // chosen by configuration: Ports:<port>:Kind selects the Dapr binding the port is
        // deployed with (Local, Sftp or AzureBlob).
        // appsettings.Development.json selects Local, the local folder the system host
        // resolves each port to; a deployment sets Ports__<port>__Kind to match the binding it
        // renders. With no Kind, startup fails naming the port. A binding's address and
        // credentials live in the environment's Dapr component (GitOps values), resolved out of
        // the cluster's secret store.
        services.AddDestinationPort(Constants.DestinationPort, configuration);

        // Each route's destination sender is a service like the other externals
        // (destination adapter, platform clients): tests swap it for their own
        // SendStep<Out, Context> registration.
{{- range .routes }}
{{- $route := printf "%sRoute" (pascal .message) }}
        services.AddSingleton<SendStep<{{ $route }}.Out, Context>>(sp =>
            new {{ $route }}.Sender(sp.GetRequiredKeyedService<IFileAdapter>(Constants.DestinationPort)));
{{- end }}

        // The loader: one route per message, each with its own typed pipeline, built in each
        // message's own scope. Every route's pipeline is composed once at startup, before the
        // loader consumes, so a missing registration stops the host (exit code 1) instead of
        // failing every message. Idempotency is kept apart per route: two messages about one
        // order never share an idempotency record.
        services.AddLoader(
            loader =>
            {
                loader.PubSubName = Constants.PubSubName;
                loader.TopicName = Constants.TopicName;
{{- if eq .default "ignore" }}
                // A message no route takes — another type, or one a route's filter leaves
                // out — is acknowledged and dropped, matching the system's IgnoreOthers().
                loader.Unrouted = UnroutedPolicy.Ack;
{{- else }}
                // A message no route takes — another type, or one a route's filter leaves
                // out — is left for redelivery, so the broker dead-letters it.
                loader.Unrouted = UnroutedPolicy.DeadLetter;
{{- end }}
            },
            routes => routes
{{- range .routes }}
{{- $route := printf "%sRoute" (pascal .message) }}
                .On<{{ pascal .message }}Payload, {{ $route }}.Out, Context>({{ $route }}.Route.Message,
                    (builder, _) => builder
                        .WithDeserializer(new {{ $route }}.Deserializer())
                        .WithValidator(new {{ $route }}.Validator())
                        // Keys off CloudEvent Subject (id) and Time (date) in context metadata;
                        // the Deserializer backfills both from the payload's business identity.
                        .WithIdempotency()
                        .WithTransformer(new {{ $route }}.Transformer())
                        // The sender resolves from DI like every other external dependency.
                        .WithSenderFromServices()
                        .WithBusinessIncidents(BusinessId, BusinessId),
                    (metadata, isRetry) => new Context(metadata, isRetry))
{{- end }});

        return services;
    }

    /// <summary>The business identifier a message is about, for business incidents: the id
    /// the Deserializer stamped, else the CloudEvent subject.</summary>
    private static string BusinessId(Context ctx) => ctx.Metadata.GetValueOrDefault(Constants.ContextKeyOrderId,
        ctx.Metadata.GetValueOrDefault(Constants.ContextKeyCloudEventSubject, "unknown"));
}
