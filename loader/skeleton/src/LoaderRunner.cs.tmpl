using System.Globalization;
using System.Text;
using CloudNative.CloudEvents;
using Dapr.Client;
using Dapr.Messaging.PublishSubscribe;
using {{ .name }}.Configuration;
using {{ .name }}.Model;
using Intropy.Framework.Blocks.Loader;
using Intropy.Framework.Blocks.Shared;
using Intropy.Framework.Core.Pipeline.Abstractions.Results;
using Microsoft.Extensions.Logging;

namespace {{ .name }};

/// <summary>
/// Runs the loader lifecycle: sidecar management plus a Dapr streaming
/// subscription on the pub/sub topic. Every delivered message is rebuilt into
/// a CloudEvent and run through the load pipeline; the ack action maps from
/// the pipeline result — success, idempotent duplicate, and routed business
/// incidents ack the message, technical failures request redelivery.
/// Runs until the cancellation token is signalled (Ctrl+C).
/// </summary>
public class LoaderRunner(
    DaprClient daprClient,
    DaprPublishSubscribeClient pubSubClient,
    Loader<In, Out, Context> pipeline,
    ILoggerFactory loggerFactory)
{
    private const int SidecarTimeoutSeconds = 30;

    // Messages not acknowledged within this window are redelivered (Retry).
    private const int MessageProcessingTimeoutSeconds = 60;

    // CloudEvent extension attributes delivered alongside the streaming message.
    private const string SubjectExtension = "subject";
    private const string TimeExtension = "time";
    private const string RetryCountExtension = "retrycount";

    private readonly ILogger _logger = loggerFactory.CreateLogger("{{ .name }}.Pipeline");

    /// <summary>
    /// Waits for the Dapr sidecar, then holds the topic subscription until cancelled.
    /// </summary>
    /// <returns>0 on graceful shutdown, 1 on failure.</returns>
    public async Task<int> RunAsync(CancellationToken ct)
    {
        try
        {
            using var sidecarCts = new CancellationTokenSource(TimeSpan.FromSeconds(SidecarTimeoutSeconds));
            await daprClient.WaitForSidecarAsync(sidecarCts.Token);
        }
        catch (Exception e)
        {
            _logger.LogError(e, "Dapr sidecar did not become available within {TimeoutSeconds} seconds",
                SidecarTimeoutSeconds);
            return 1;
        }

        try
        {
            var subscription = await pubSubClient.SubscribeAsync(
                Constants.PubSubName,
                Constants.TopicName,
                new DaprSubscriptionOptions(new MessageHandlingPolicy(
                    TimeSpan.FromSeconds(MessageProcessingTimeoutSeconds),
                    TopicResponseAction.Retry)),
                HandleMessageAsync,
                ct);

            await using (subscription)
            {
                _logger.LogInformation("Subscribed to topic {Topic} ({PubSub})",
                    Constants.TopicName, Constants.PubSubName);

                await Task.Delay(Timeout.InfiniteTimeSpan, ct);
            }

            return 0;
        }
        catch (OperationCanceledException)
        {
            return 0;
        }
        catch (Exception e)
        {
            _logger.LogError(e, "Loader failed");
            return 1;
        }
        finally
        {
            try
            {
                await daprClient.ShutdownSidecarAsync();
            }
            catch (Exception e)
            {
                _logger.LogWarning(e, "Failed to shut down Dapr sidecar");
            }
        }
    }

    private async Task<TopicResponseAction> HandleMessageAsync(TopicMessage message, CancellationToken ct)
    {
        try
        {
            // A redelivery carries a retrycount extension; IsRetry lets the
            // pipeline resolve a previously routed incident on a later success.
            var isRetry = message.Extensions.ContainsKey(RetryCountExtension);
            var context = new Context(new Dictionary<string, string>(), isRetry);

            var (result, finalContext) = await pipeline.Execute(ToCloudEvent(message), context, ct);
            var subject = finalContext.Metadata.GetValueOrDefault(
                Constants.ContextKeyCloudEventSubject, message.Id);

            switch (result)
            {
                case StepResult<Out>.Success { Value: not null }:
                    _logger.LogInformation("Loaded {Subject} from topic {Topic} ({PubSub})",
                        subject, Constants.TopicName, Constants.PubSubName);
                    return TopicResponseAction.Success;
                case StepResult<Out>.Success:
                    // A business failure was routed to the Business Incident
                    // Service; the pipeline finalizer reports that as Success
                    // with a default (null) value. Ack it — redelivering a
                    // validation failure would loop forever.
                    _logger.LogWarning("Routed a business incident for {Subject}; message consumed", subject);
                    return TopicResponseAction.Success;
                case StepResult<Out>.Cancelled:
                    _logger.LogInformation("Cancelled {Subject} as a duplicate (idempotency check)", subject);
                    return TopicResponseAction.Success;
                default:
                    _logger.LogWarning("Processing {Subject} failed ({ResultType}); requesting redelivery",
                        subject, result.GetType().Name);
                    return TopicResponseAction.Retry;
            }
        }
        catch (Exception e)
        {
            _logger.LogError(e, "Error processing message {MessageId}", message.Id);
            return TopicResponseAction.Retry;
        }
    }

    /// <summary>
    /// Rebuilds a CloudEvent from the streaming-subscription message. Id,
    /// Source, Type and DataContentType are first-class on TopicMessage;
    /// Subject and Time only arrive as CloudEvent extension attributes when
    /// the publisher set them (`dapr publish` sets time but never subject) —
    /// the Deserializer stamps both from the payload's business identity.
    /// </summary>
    private static CloudEvent ToCloudEvent(TopicMessage message)
    {
        var cloudEvent = new CloudEvent
        {
            Id = message.Id,
            Type = message.Type,
            Data = Encoding.UTF8.GetString(message.Data.Span)
        };

        if (!string.IsNullOrEmpty(message.DataContentType))
            cloudEvent.DataContentType = message.DataContentType;

        if (Uri.TryCreate(message.Source, UriKind.RelativeOrAbsolute, out var source))
            cloudEvent.Source = source;

        if (message.Extensions.TryGetValue(SubjectExtension, out var subject) &&
            !string.IsNullOrEmpty(subject.StringValue))
            cloudEvent.Subject = subject.StringValue;

        if (message.Extensions.TryGetValue(TimeExtension, out var time) &&
            DateTimeOffset.TryParse(time.StringValue, CultureInfo.InvariantCulture,
                DateTimeStyles.RoundtripKind, out var parsedTime))
            cloudEvent.Time = parsedTime;

        return cloudEvent;
    }
}
