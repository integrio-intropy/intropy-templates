using {{ .contracts }};
using {{ .name }}.Process;
using Intropy.Framework.Blocks.Shared;
using Intropy.Framework.Core.Pipeline.Abstractions.Results;

namespace {{ .name }}.Test.Unit.Process;

public class TransformerTests
{
    [Fact]
    public async Task ExecuteAsync_MapsTheOrderToTheCanonicalContract()
    {
        var source = SampleOrders.Valid();

        var (result, _) = await new Transformer().ExecuteAsync(source, new Context(new Dictionary<string, string>()),
            CancellationToken.None);

        var output = Assert.IsType<TechnicalStepResult<{{ .payloadType }}>.Success>(result).Value;
        Assert.Equal(source.OrderId, output.OrderId);
        Assert.Equal(source.CustomerId, output.CustomerId);
        Assert.Equal(source.Status, output.Status);
        Assert.Equal(source.OrderDate, output.OrderDate);
        Assert.Equal(source.Lines, output.Lines);
    }
}
