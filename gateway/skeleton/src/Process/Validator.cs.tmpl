using {{ .name }}.Model;
{{- if not .empty }}
using Intropy.Contracts.BusinessIncidentService;
{{- end }}
using Intropy.Framework.Blocks.Extractor.Steps;
using Intropy.Framework.Blocks.Shared;
using Intropy.Framework.Core.Pipeline.Abstractions.Results;

namespace {{ .name }}.Process;

// A failure here is a business incident and the caller's 422: its description is
// what the caller reads in the problem details.
public class Validator : ValidateStep<{{ .payloadType }}Request, Context>
{
    public override Task<(BusinessStepResult<{{ .payloadType }}Request> Result, Context Context)> ExecuteAsync(
        {{ .payloadType }}Request input, Context context, CancellationToken ct)
    {
{{- if .empty }}
        throw new NotImplementedException();
{{- else }}
        var error = Validate(input);
        if (error is not null)
        {
            var incident = new BusinessIncidentData
            {
                Description = error,
                Context = new Dictionary<string, string>
                {
                    { "orderId", input.OrderId ?? "" }
                }
            };
            return Task.FromResult<(BusinessStepResult<{{ .payloadType }}Request>, Context)>(
                (new BusinessStepResult<{{ .payloadType }}Request>.Failure(incident), context));
        }

        return Task.FromResult<(BusinessStepResult<{{ .payloadType }}Request>, Context)>(
            (new BusinessStepResult<{{ .payloadType }}Request>.Success(input), context));
{{- end }}
    }
{{- if not .empty }}

    private static string? Validate({{ .payloadType }}Request order)
    {
        if (string.IsNullOrWhiteSpace(order.OrderId))
            return "OrderId is required";
        if (string.IsNullOrWhiteSpace(order.CustomerId))
            return "CustomerId is required";
        if (order.OrderDate > DateTimeOffset.UtcNow)
            return $"OrderDate {order.OrderDate:O} is in the future";
        if (order.Lines is null || order.Lines.Count == 0)
            return "Order must contain at least one line";
        return null;
    }
{{- end }}
}
